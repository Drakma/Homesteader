{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "wheat",
  "name": "Wheat Plant",
  "category": "farming",
  "description": "A wheat lifecycle growing through 5 stages (sprout -> small -> medium -> mature -> ripe) over 180 days, with withered and dead versions. The models are procedural (built in the game), the originals are kept in assets/_originals/crops_old.",
  "icon": "wheat.png",
  "is_growable": true,
  "growth": {
    "growth_type": "crop",
    "species": "wheat",
    "max_age": 180,
    "time_unit": "days",
    "total_stages": 5,
    "icon_stage": 5,
    "stages": [
      {
        "stage": 1,
        "name": "sprout",
        "age_min": 0,
        "age_max": 20,
        "resource": "stages/crop_sprout/",
        "model": "crop_sprout_wheat.glb",
        "icon": "crop_sprout_wheat.png"
      },
      {
        "stage": 2,
        "name": "small",
        "age_min": 20,
        "age_max": 59,
        "resource": "stages/crop_small/",
        "model": "crop_small_wheat.glb",
        "icon": "crop_small_wheat.png"
      },
      {
        "stage": 3,
        "name": "medium",
        "age_min": 59,
        "age_max": 108,
        "resource": "stages/crop_medium/",
        "model": "crop_medium_wheat.glb",
        "icon": "crop_medium_wheat.png"
      },
      {
        "stage": 4,
        "name": "mature",
        "age_min": 108,
        "age_max": 149,
        "resource": "stages/crop_mature/",
        "model": "crop_mature_wheat.glb",
        "icon": "crop_mature_wheat.png"
      },
      {
        "stage": 5,
        "name": "ripe",
        "age_min": 149,
        "age_max": 180,
        "resource": "stages/crop_ripe/",
        "model": "crop_ripe_wheat.glb",
        "icon": "crop_ripe_wheat.png"
      }
    ],
    "rules": {
      "yield": {
        "item_id": "ingredient_wheat",
        "amount_min": 2,
        "amount_max": 2,
        "harvest_stage": 5,
        "tool": "#tool_sickle"
      },
      "planting": {
        "seasons": [
          "summer"
        ],
        "biomes": [
          "biome_farmland"
        ],
        "item_id": "seed_wheat",
        "min_temp_c": 8,
        "max_temp_c": 40
      },
      "needs": {
        "water_interval_days": 7
      },
      "failure": {
        "out_of_season": "wither",
        "frost_kills": true,
        "drought_days_before_wither": 7,
        "wither_behavior": "die",
        "withered": {
          "resource": "stages/crop_withered/",
          "model": "crop_withered_wheat.glb",
          "icon": "crop_withered_wheat.png"
        },
        "dead": {
          "resource": "stages/crop_dead/",
          "model": "crop_dead_wheat.glb",
          "icon": "crop_dead_wheat.png"
        }
      }
    }
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
