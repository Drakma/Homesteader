{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "quarter_horse",
  "name": "Quarter Horse",
  "category": "ranching",
  "description": "A animal lifecycle growing through 3 stages (foal -> yearling -> adult) over 730 days. This group is the authoritative owner of the quarter_horse scheme.",
  "icon": "quarter_horse.png",
  "is_growable": true,
  "growth": {
    "growth_type": "animal",
    "species": "quarter_horse",
    "max_age": 730,
    "time_unit": "days",
    "total_stages": 3,
    "icon_stage": 3,
    "stages": [
      {
        "stage": 1,
        "name": "foal",
        "age_min": 0,
        "age_max": 90,
        "resource": "stages/animal_foal/",
        "model": "quarter_horse_foal.glb",
        "icon": "animal_foal_quarter_horse.png"
      },
      {
        "stage": 2,
        "name": "yearling",
        "age_min": 90,
        "age_max": 365,
        "resource": "stages/animal_yearling/",
        "model": "quarter_horse_yearling.glb",
        "icon": "animal_yearling_quarter_horse.png"
      },
      {
        "stage": 3,
        "name": "adult",
        "age_min": 365,
        "age_max": 730,
        "resource": "stages/animal_adult/",
        "model": "quarter_horse_adult_female.glb",
        "icon": "animal_adult_quarter_horse.png",
        "sexes": [
          {
            "sex": "female",
            "chance_pct": 80,
            "model": "quarter_horse_adult_female.glb",
            "icon": "animal_adult_quarter_horse.png"
          },
          {
            "sex": "male",
            "chance_pct": 20,
            "model": "quarter_horse_adult_male.glb",
            "icon": "animal_adult_quarter_horse_male.png"
          }
        ]
      }
    ]
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}