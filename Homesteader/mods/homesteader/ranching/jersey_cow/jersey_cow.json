{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "jersey_cow",
  "name": "Jersey Cow",
  "category": "ranching",
  "description": "A animal lifecycle growing through 2 stages (calf -> adult) over 730 days. This group is the authoritative owner of the jersey_cow scheme.",
  "icon": "jersey_cow.png",
  "is_growable": true,
  "growth": {
    "growth_type": "animal",
    "species": "jersey_cow",
    "max_age": 730,
    "time_unit": "days",
    "total_stages": 3,
    "icon_stage": 3,
    "stages": [
      {
        "stage": 1,
        "name": "calf",
        "age_min": 0,
        "age_max": 90,
        "resource": "stages/animal_calf/",
        "model": "jersey_cow_calf.glb",
        "icon": "animal_calf_jersey_cow.png"
      },
      {
        "stage": 2,
        "name": "yearling",
        "age_min": 90,
        "age_max": 365,
        "resource": "stages/animal_yearling/",
        "model": "jersey_cow_yearling.glb",
        "icon": "animal_yearling_jersey_cow.png"
      },
      {
        "stage": 3,
        "name": "adult",
        "age_min": 365,
        "age_max": 730,
        "resource": "stages/animal_adult/",
        "model": "jersey_cow_adult_female.glb",
        "icon": "animal_adult_jersey_cow.png",
        "sexes": [
          {
            "sex": "female",
            "chance_pct": 80,
            "model": "jersey_cow_adult_female.glb",
            "icon": "animal_adult_jersey_cow.png"
          },
          {
            "sex": "male",
            "chance_pct": 20,
            "model": "jersey_cow_adult_male.glb",
            "icon": "animal_adult_jersey_cow_male.png"
          }
        ]
      }
    ]
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}