{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "brown_goat",
  "name": "Brown Goat",
  "category": "ranching",
  "description": "A animal lifecycle growing through 2 stages (kid -> adult) over 730 days. This group is the authoritative owner of the brown_goat scheme.",
  "icon": "brown_goat.png",
  "is_growable": true,
  "growth": {
    "growth_type": "animal",
    "species": "brown_goat",
    "max_age": 730,
    "time_unit": "days",
    "total_stages": 3,
    "icon_stage": 3,
    "stages": [
      {
        "stage": 1,
        "name": "kid",
        "age_min": 0,
        "age_max": 90,
        "resource": "stages/animal_kid/",
        "model": "brown_goat_kid.glb",
        "icon": "animal_kid_brown_goat.png"
      },
      {
        "stage": 2,
        "name": "yearling",
        "age_min": 90,
        "age_max": 365,
        "resource": "stages/animal_yearling/",
        "model": "brown_goat_yearling.glb",
        "icon": "animal_yearling_brown_goat.png"
      },
      {
        "stage": 3,
        "name": "adult",
        "age_min": 365,
        "age_max": 730,
        "resource": "stages/animal_adult/",
        "model": "brown_goat_adult_female.glb",
        "icon": "animal_adult_brown_goat.png",
        "sexes": [
          {
            "sex": "female",
            "chance_pct": 80,
            "model": "brown_goat_adult_female.glb",
            "icon": "animal_adult_brown_goat.png"
          },
          {
            "sex": "male",
            "chance_pct": 20,
            "model": "brown_goat_adult_male.glb",
            "icon": "animal_adult_brown_goat_male.png"
          }
        ]
      }
    ]
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}