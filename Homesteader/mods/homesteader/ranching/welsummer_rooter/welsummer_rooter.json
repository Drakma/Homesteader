{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "welsummer_rooter",
  "name": "Welsummer Rooter",
  "category": "ranching",
  "description": "A animal lifecycle growing through 2 stages (chick -> adult) over 730 days. This group is the authoritative owner of the welsummer_rooter scheme.",
  "icon": "welsummer_rooter.png",
  "is_growable": true,
  "growth": {
    "growth_type": "animal",
    "species": "welsummer_rooter",
    "max_age": 730,
    "time_unit": "days",
    "total_stages": 3,
    "icon_stage": 3,
    "stages": [
      {
        "stage": 1,
        "name": "chick",
        "age_min": 0,
        "age_max": 90,
        "resource": "stages/animal_chick_welsummer_rooster/",
        "model": "welsummer_rooter_chick.glb",
        "icon": "animal_chick_welsummer_rooster_welsummer_rooter.png"
      },
      {
        "stage": 2,
        "name": "yearling",
        "age_min": 90,
        "age_max": 365,
        "resource": "stages/animal_yearling/",
        "model": "welsummer_rooter_yearling.glb",
        "icon": "animal_yearling_welsummer_rooter.png"
      },
      {
        "stage": 3,
        "name": "adult",
        "age_min": 365,
        "age_max": 730,
        "resource": "stages/animal_adult_welsummer_rooster/",
        "model": "welsummer_rooter_adult_female.glb",
        "icon": "animal_adult_welsummer_rooster_welsummer_rooter.png",
        "sexes": [
          {
            "sex": "female",
            "chance_pct": 80,
            "model": "welsummer_rooter_adult_female.glb",
            "icon": "animal_adult_welsummer_rooster_welsummer_rooter.png"
          },
          {
            "sex": "male",
            "chance_pct": 20,
            "model": "welsummer_rooter_adult_male.glb",
            "icon": "animal_adult_welsummer_rooster_welsummer_rooter_male.png"
          }
        ]
      }
    ]
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}