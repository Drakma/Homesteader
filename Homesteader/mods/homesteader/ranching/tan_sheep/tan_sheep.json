{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "tan_sheep",
  "name": "Tan Sheep",
  "category": "ranching",
  "description": "A animal lifecycle growing through 2 stages (lamb -> adult) over 730 days. This group is the authoritative owner of the tan_sheep scheme.",
  "icon": "tan_sheep.png",
  "is_growable": true,
  "growth": {
    "growth_type": "animal",
    "species": "tan_sheep",
    "max_age": 730,
    "time_unit": "days",
    "total_stages": 2,
    "icon_stage": 2,
    "stages": [
      {
        "stage": 1,
        "name": "lamb",
        "age_min": 0,
        "age_max": 90,
        "resource": "stages/animal_lamb/",
        "model": "SKM_Animal_Lamb_Tan.fbx",
        "icon": "animal_lamb_tan_sheep.png"
      },
      {
        "stage": 2,
        "name": "adult",
        "age_min": 90,
        "age_max": 730,
        "resource": "stages/animal_adult/",
        "model": "SKM_Animal_Sheep_Tan.fbx",
        "icon": "animal_adult_tan_sheep.png"
      }
    ]
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
