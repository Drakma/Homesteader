<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">
    <ui:Style src="HudUI.uss" />
    <ui:ScrollView name="FormPanel" class="form">
        <!-- Buttons: one row per color, four states -->
        <ui:VisualElement class="form-row" style="align-items: center;">
            <ui:Label text="Red:" class="form-label" />
            <ui:Button text="OK" class="btn btn-red-unclicked" />
            <ui:Button text="OK" class="btn btn-red-hover" />
            <ui:Button text="OK" class="btn btn-red-clicked" />
            <ui:Button text="OK" class="btn btn-red-disabled" />
        </ui:VisualElement>
        <ui:VisualElement class="form-row" style="align-items: center;">
            <ui:Label text="Green:" class="form-label" />
            <ui:Button text="OK" class="btn btn-green-unclicked" />
            <ui:Button text="OK" class="btn btn-green-hover" />
            <ui:Button text="OK" class="btn btn-green-clicked" />
            <ui:Button text="OK" class="btn btn-green-disabled" />
        </ui:VisualElement>
        <ui:VisualElement class="form-row" style="align-items: center;">
            <ui:Label text="Amber:" class="form-label" />
            <ui:Button text="OK" class="btn btn-amber-unclicked" />
            <ui:Button text="OK" class="btn btn-amber-hover" />
            <ui:Button text="OK" class="btn btn-amber-clicked" />
            <ui:Button text="OK" class="btn btn-amber-disabled" />
        </ui:VisualElement>
        <ui:VisualElement class="form-row" style="align-items: center;">
            <ui:Label text="Slate:" class="form-label" />
            <ui:Button text="OK" class="btn btn-slate-unclicked" />
            <ui:Button text="OK" class="btn btn-slate-hover" />
            <ui:Button text="OK" class="btn btn-slate-clicked" />
            <ui:Button text="OK" class="btn btn-slate-disabled" />
        </ui:VisualElement>

        <ui:VisualElement style="height: 8px;" />

        <!-- Checkboxes -->
        <ui:VisualElement class="form-row">
            <ui:Label text="Checkboxes:" class="form-label" />
            <ui:VisualElement class="cb cb-unchecked" />
            <ui:VisualElement class="cb cb-checked" />
            <ui:VisualElement class="cb cb-unchecked-disabled" />
            <ui:VisualElement class="cb cb-checked-disabled" />
        </ui:VisualElement>

        <!-- Radios -->
        <ui:VisualElement class="form-row">
            <ui:Label text="Radios:" class="form-label" />
            <ui:VisualElement class="rd rd-unselected" />
            <ui:VisualElement class="rd rd-selected" />
            <ui:VisualElement class="rd rd-unselected-disabled" />
            <ui:VisualElement class="rd rd-selected-disabled" />
        </ui:VisualElement>

        <ui:VisualElement style="height: 8px;" />

        <!-- Sliders -->
        <ui:VisualElement class="slider-row">
            <ui:Label text="Lightslate: 0.55" class="slider-label" />
            <ui:VisualElement class="slider-track">
                <ui:VisualElement class="slider-track-bg slider-track-lightslate"
                                  style="width: 280px; margin-left: 154px;" />
                <ui:VisualElement class="slider-knob"
                                  style="margin-left: -160px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="slider-row">
            <ui:Label text="Slate: 0.45" class="slider-label" />
            <ui:VisualElement class="slider-track">
                <ui:VisualElement class="slider-track-bg slider-track-slate"
                                  style="width: 225px; margin-left: 126px;" />
                <ui:VisualElement class="slider-knob"
                                  style="margin-left: 27px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="slider-row">
            <ui:Label text="Disabled: 0.25" class="slider-label" />
            <ui:VisualElement class="slider-track">
                <ui:VisualElement class="slider-track-bg slider-track-disabled"
                                  style="width: 125px; margin-left: 70px;" />
                <ui:VisualElement class="slider-knob"
                                  style="background-color: rgb(42, 47, 56); margin-left: -9px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
