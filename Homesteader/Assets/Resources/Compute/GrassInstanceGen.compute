// GrassInstanceGen.compute - Scatters grass blade instances on the GPU for the square region around the
// player, reading straight from the biome map and terrain heightmap textures. Replaces the old CPU bake:
// no per-blade CPU work, no Mesh construction, no streaming hitches - the whole region is regenerated with
// one cheap dispatch whenever the player moves far enough that it's worth it.

#pragma kernel CSGenerate
#pragma kernel CSCull

struct GrassInstance
{
    float3 position;
    float rotationY;
    float height;
    float tint;
    float flower;
    float _pad;
};

AppendStructuredBuffer<GrassInstance> _Instances;

Texture2D<float4> _BiomeMap;
SamplerState sampler_BiomeMap;
Texture2D<float> _Heightmap;
SamplerState sampler_Heightmap;

float2 _RegionOrigin;      // world-space XZ of the region's min corner
float _RegionSize;         // region is _RegionSize x _RegionSize metres square
float _CellSize;           // metres per grid cell (1 cell = 1 biome-map texel's worth of ground)
uint _GridDim;              // cells per side (_RegionSize / _CellSize)

float3 _TerrainOrigin;      // terrain.transform.position
float2 _TerrainSize;        // terrainData.size.x / .z (world footprint)
float _TerrainHeightScale;  // terrainData.size.y

float _ShortDensity;        // blades per m^2
float _TallDensity;
float _ShortBladeHeight;
float _TallBladeHeight;
float _FlowerChance;

uint _MaxInstancesPerCell;  // safety cap so one dense cell can't starve the whole dispatch's budget

float Hash(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float SampleTerrainHeight(float2 worldXZ)
{
    float2 uv = (worldXZ - _TerrainOrigin.xz) / _TerrainSize;
    if (uv.x < 0 || uv.x > 1 || uv.y < 0 || uv.y > 1) return _TerrainOrigin.y;
    float h = _Heightmap.SampleLevel(sampler_Heightmap, uv, 0);
    return _TerrainOrigin.y + h * _TerrainHeightScale * 2.0; // see class remarks in GrassRenderer.cs
}

[numthreads(8, 8, 1)]
void CSGenerate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _GridDim || id.y >= _GridDim) return;

    float worldX = _RegionOrigin.x + id.x * _CellSize;
    float worldZ = _RegionOrigin.y + id.y * _CellSize;

    float2 biomeUV = float2(worldX / _TerrainSize.x, worldZ / _TerrainSize.y) - _TerrainOrigin.xz / _TerrainSize;
    if (biomeUV.x < 0 || biomeUV.x > 1 || biomeUV.y < 0 || biomeUV.y > 1) return;

    float4 biome = _BiomeMap.SampleLevel(sampler_BiomeMap, biomeUV, 0);
    int biomeMode = (int)(biome.a * 16.0);
    bool isShort = (biomeMode == 0);
    bool isTall = (biomeMode == 13);
    if (!isShort && !isTall) return;

    float density = isTall ? _TallDensity : _ShortDensity;
    float bladeHeight = isTall ? _TallBladeHeight : _ShortBladeHeight;
    uint count = min((uint)round(density), _MaxInstancesPerCell);

    // Edge fade: sample a handful of neighbours (cheaper on GPU than the old 5x5=24 CPU scan - 8 neighbours
    // at 2-cell reach reads about the same information at a quarter of the texture fetches).
    int grassNeighbors = 0;
    int totalNeighbors = 0;
    for (int dx = -1; dx <= 1; dx++)
    {
        for (int dy = -1; dy <= 1; dy++)
        {
            if (dx == 0 && dy == 0) continue;
            float2 nUV = biomeUV + float2(dx, dy) * (_CellSize * 2.0 / _TerrainSize);
            if (nUV.x < 0 || nUV.x > 1 || nUV.y < 0 || nUV.y > 1) continue;
            totalNeighbors++;
            float4 nB = _BiomeMap.SampleLevel(sampler_BiomeMap, nUV, 0);
            int nMode = (int)(nB.a * 16.0);
            if (nMode == 0 || nMode == 13) grassNeighbors++;
        }
    }
    float edgeFade = totalNeighbors > 0 ? (float)grassNeighbors / (float)totalNeighbors : 1.0;
    edgeFade = edgeFade * edgeFade;

    for (uint i = 0; i < count; i++)
    {
        float2 seed = float2(worldX * 13.7 + i * 3.1, worldZ * 9.3 + i * 5.7);
        float rx = worldX + Hash(seed) * _CellSize;
        float rz = worldZ + Hash(seed + 91.7) * _CellSize;
        float terrainY = SampleTerrainHeight(float2(rx, rz));

        GrassInstance inst;
        inst.position = float3(rx, terrainY, rz);
        inst.rotationY = Hash(seed + 3.3) * 6.2831853;
        inst.height = bladeHeight * lerp(0.7, 1.1, Hash(seed + 5.1)) * edgeFade;
        inst.tint = Hash(seed + 7.9);
        inst.flower = (isShort && Hash(seed + 11.3) < _FlowerChance) ? ceil(Hash(seed + 13.9) * 5.0) : 0.0;
        inst._pad = 0.0;

        _Instances.Append(inst);
    }
}

// ---------------------------------------------------------------------------------------------------------
// CSCull - runs every frame (unlike CSGenerate, which only re-runs when the player has moved far enough).
// Without this, RenderMeshIndirect draws every generated instance unconditionally regardless of what the
// camera can actually see, which was costing real frame time for blades well outside the view.
// ---------------------------------------------------------------------------------------------------------

StructuredBuffer<GrassInstance> _Source;
AppendStructuredBuffer<GrassInstance> _Visible;
float4 _FrustumPlanes[6]; // (normal.xyz, distance), Unity's GeometryUtility.CalculateFrustumPlanes convention
uint _TotalCount;

bool InsideFrustum(float3 pos, float radius)
{
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float4 p = _FrustumPlanes[i];
        if (dot(p.xyz, pos) + p.w < -radius) return false;
    }
    return true;
}

[numthreads(64, 1, 1)]
void CSCull(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _TotalCount) return;

    GrassInstance inst = _Source[id.x];
    // Pad the test radius past the blade's own height so a blade doesn't pop out right at the screen edge.
    if (InsideFrustum(inst.position, inst.height + 0.5))
        _Visible.Append(inst);
}
