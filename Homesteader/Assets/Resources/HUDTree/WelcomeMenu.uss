/* WelcomeMenu.uss - Welcome / Main Menu styling.
   Uses the same dark-slate + copper palette and HomesteaderHUD font
   family as HudUI.uss so the menu looks like it belongs in the game. */

:root {
    --font: resource("HUDTree/Fonts/HomesteaderHUD");
    --font-bold: resource("HUDTree/Fonts/HomesteaderHUD_Bold");
    --font-medium: resource("HUDTree/Fonts/HomesteaderHUD_Medium");
    --font-italic: resource("HUDTree/Fonts/HomesteaderHUD_Italic");
    --font-bold-italic: resource("HUDTree/Fonts/HomesteaderHUD_BoldItalic");
}

/* ----- FULL-SCREEN ROOT ----- */

.welcome-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

/* Hides any element with the welcome--hidden class (the wallpaper element
   only has this class, not welcome-root, so it needs a standalone rule). */
.welcome--hidden {
    display: none;
}

/* IMPORTANT: .welcome--hidden must come AFTER .welcome-root so it wins
   the specificity tie-breaker (same specificity = later source wins). */

.welcome-root.welcome--hidden {
    display: none;
}

/* ----- MENU CARD ----- */

.welcome-card {
    position: relative;
    width: 360px;
    padding: 32px 28px 24px 28px;
    background-color: rgba(43, 52, 66, 0.92);
    border-width: 1px;
    border-color: rgb(18, 22, 29);
    border-top-color: rgb(92, 102, 117);
    border-left-width: 2px;
    border-left-color: rgb(224, 138, 60);
    flex-direction: column;
    align-items: stretch;
}

/* ----- TITLE ----- */

.welcome-title-block {
    flex-direction: column;
    align-items: center;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(61, 74, 92);
}

.welcome-title {
    color: rgb(224, 138, 60);
    font-size: 28px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    margin: 0;
    padding: 0;
}

.welcome-subtitle {
    color: rgb(139, 150, 165);
    font-size: 13px;
    -unity-font: var(--font-italic);
    -unity-text-align: middle-center;
    margin-top: 6px;
    padding: 0;
    letter-spacing: 1px;
}

/* ----- BUTTONS ----- */

.welcome-btn {
    height: 40px;
    margin-top: 6px;
    margin-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    background-color: rgba(26, 33, 43, 0.85);
    color: rgb(238, 242, 246);
    font-size: 15px;
    -unity-font: var(--font-medium);
    -unity-text-align: middle-center;
    letter-spacing: 0.5px;
}

.welcome-btn:hover {
    background-color: rgb(61, 74, 92);
    border-color: rgb(92, 102, 117);
    color: rgb(255, 255, 255);
}

.welcome-btn:active {
    background-color: rgb(43, 52, 66);
}

.welcome-btn--primary {
    background-color: rgb(224, 138, 60);
    color: rgb(18, 22, 29);
    border-color: rgb(232, 163, 98);
    -unity-font: var(--font-bold);
}

.welcome-btn--primary:hover {
    background-color: rgb(222, 153, 88);
    color: rgb(18, 22, 29);
}

.welcome-btn--primary:active {
    background-color: rgb(188, 112, 40);
}

.welcome-btn--exit {
    margin-top: 14px;
    border-color: rgba(227, 83, 88, 0.4);
    color: rgb(228, 92, 96);
}

.welcome-btn--exit:hover {
    background-color: rgb(198, 32, 38);
    color: rgb(255, 255, 255);
    border-color: rgb(224, 66, 71);
}

/* ----- SAVE / LOAD ROW ----- */

.welcome-btn-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
}

.welcome-btn--half {
    flex-grow: 1;
    margin-left: 3px;
    margin-right: 3px;
    margin-top: 0;
    margin-bottom: 0;
}

/* ----- STATUS LABEL ----- */

.welcome-status {
    color: rgb(139, 150, 165);
    font-size: 11px;
    -unity-font: var(--font-medium);
    -unity-text-align: middle-center;
    margin-top: 12px;
    min-height: 16px;
    padding: 0;
}

/* ----- PROGRESS BAR (inside loading modal) ----- */

.loading-modal {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(18, 22, 29, 0.7);
}

.loading-modal.loading--hidden {
    display: none;
}

.loading-modal-card {
    width: 340px;
    padding: 28px 24px 20px 24px;
    background-color: rgba(43, 52, 66, 0.96);
    border-width: 1px;
    border-color: rgb(18, 22, 29);
    border-top-color: rgb(92, 102, 117);
    border-left-width: 2px;
    border-left-color: rgb(224, 138, 60);
    flex-direction: column;
    align-items: stretch;
}

.loading-modal-title {
    color: rgb(224, 138, 60);
    font-size: 20px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(61, 74, 92);
}

.loading-phase {
    color: rgb(139, 150, 165);
    font-size: 12px;
    -unity-font: var(--font-italic);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    min-height: 16px;
}

.loading-bar-track {
    height: 8px;
    background-color: rgb(26, 33, 43);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    overflow: hidden;
}

.loading-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(224, 138, 60);
    border-right-color: rgb(232, 163, 98);
}

.loading-pct {
    color: rgb(238, 242, 246);
    font-size: 13px;
    -unity-font: var(--font-medium);
    -unity-text-align: middle-center;
    margin-top: 6px;
}

/* ----- SETTINGS DIALOG ----- */

.settings-dialog {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    /* No full-screen tint here on purpose: the settings dialog opens on top of the pause/welcome
       menu, which is already its own dim overlay - stacking a second one made the view darken
       twice. The settings-card panel's own background is enough to separate it visually. */
}

.settings-dialog.settings--hidden {
    display: none;
}

.settings-card {
    width: 320px;
    padding: 28px 24px 20px 24px;
    background-color: rgb(43, 52, 66);
    border-width: 1px;
    border-color: rgb(18, 22, 29);
    border-top-color: rgb(92, 102, 117);
    border-left-width: 2px;
    border-left-color: rgb(224, 138, 60);
    flex-direction: column;
    align-items: stretch;
}

.settings-title {
    color: rgb(224, 138, 60);
    font-size: 20px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(61, 74, 92);
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.settings-label {
    color: rgb(238, 242, 246);
    font-size: 14px;
    -unity-font: var(--font-medium);
}

.settings-controls {
    flex-direction: row;
    align-items: center;
}

.settings-field {
    width: 60px;
    margin-right: 10px;
    color: rgb(238, 242, 246);
    font-size: 14px;
    -unity-font: var(--font-medium);
    background-color: rgb(29, 36, 46);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
}

.settings-toggle {
    color: rgb(238, 242, 246);
    font-size: 13px;
    -unity-font: var(--font-medium);
}

.settings-toggle {
    flex-shrink: 0;
    min-width: 30px;
    min-height: 30px;
    margin-right: 0;
}

.settings-toggle > .unity-toggle__input {
    flex-grow: 0;
    width: 28px;
    height: 28px;
    justify-content: center;
    align-items: center;
    background-color: rgb(26, 33, 43);
    border-width: 2px;
    border-color: rgb(61, 74, 92);
    border-radius: 3px;
}

.settings-toggle .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(18, 22, 29);
}

.settings-toggle:checked > .unity-toggle__input,
.settings-toggle > .unity-toggle__input:checked {
    background-color: rgb(224, 138, 60);
    border-color: rgb(232, 163, 98);
}

.settings-toggle:hover > .unity-toggle__input {
    border-color: rgb(232, 163, 98);
}

.settings-hint {
    color: rgb(139, 150, 165);
    font-size: 11px;
    -unity-font: var(--font-italic);
    margin-top: 4px;
    margin-bottom: 16px;
}

.settings-close-btn {
    margin-top: 4px;
}

/* ----- SETTINGS: wide layout with category navigation on the left ----- */

.settings-card--wide {
    width: 880px;
    max-width: 94%;
    height: 580px;
    max-height: 92%;
    min-height: 0;
    padding: 22px 26px 16px 26px;
    /* Nothing inside may draw outside the card: pages scroll, long text wraps. */
    overflow: hidden;
}

.settings-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

.settings-nav {
    width: 180px;
    flex-shrink: 0;
    padding-right: 14px;
    margin-right: 20px;
    border-right-width: 1px;
    border-right-color: rgb(61, 74, 92);
}

.settings-nav-btn {
    height: 42px;
    margin: 0 0 6px 0;
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgb(34, 42, 53);
    border-radius: 0;
    background-color: rgb(34, 42, 53);
    color: rgb(176, 188, 204);
    font-size: 15px;
    -unity-font: var(--font-medium);
    -unity-text-align: middle-center;
}

.settings-nav-btn:hover {
    background-color: rgb(61, 74, 92);
    color: rgb(255, 255, 255);
}

.settings-nav-btn--active,
.settings-nav-btn--active:hover {
    background-color: rgb(61, 74, 92);
    border-left-color: rgb(224, 138, 60);
    color: rgb(255, 255, 255);
    -unity-font: var(--font-bold);
}

.settings-pages {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.settings-page {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding-right: 6px;
}

/* Long text wraps inside its column instead of pushing the page wider than the card. */
.settings-label,
.settings-hint {
    white-space: normal;
    flex-shrink: 1;
    min-width: 0;
}

.controls-row .settings-label {
    flex-shrink: 1;
    flex-grow: 1;
    min-width: 0;
    margin-right: 12px;
}

.controls-key-btn,
.controls-fixed-key {
    flex-shrink: 0;
}

.settings-page--hidden {
    display: none;
}

/* Everything inside a page keeps its own height and the page scrolls instead. UI Toolkit children shrink by
   default (flex-shrink: 1), so a long page (Controls has ~30 rows) was getting squashed into the visible
   height rather than scrolling. */
.settings-page .unity-scroll-view__content-container {
    flex-shrink: 0;
}

.settings-page .unity-scroll-view__content-container > * {
    flex-shrink: 0;
}

.settings-section-title {
    color: rgb(224, 138, 60);
    font-size: 15px;
    -unity-font: var(--font-bold);
    letter-spacing: 1px;
    margin-top: 6px;
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(61, 74, 92);
}

.settings-action-btn {
    width: 200px;
    height: 34px;
    margin-top: 10px;
    -unity-text-align: middle-center;
}

.settings-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgb(61, 74, 92);
}

.settings-footer-btn {
    width: 160px;
    height: 36px;
    margin: 0;
    -unity-text-align: middle-center;
}

/* Dropdown: text vertically centred in the box (project UI rule), matching .asset-category-dropdown. */
.settings-dropdown {
    width: 200px;
    margin: 0;
}

.settings-dropdown .unity-base-popup-field__input {
    justify-content: center;
    -unity-text-align: middle-left;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(238, 242, 246);
    font-size: 14px;
    background-color: rgb(29, 36, 46);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
}

.settings-dropdown .unity-base-popup-field__text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

/* Controls page rows (built in code by SettingsDialogController) */
.controls-group-title {
    flex-shrink: 0;
    color: rgb(139, 150, 165);
    font-size: 12px;
    -unity-font: var(--font-bold);
    letter-spacing: 1.5px;
    margin-top: 12px;
    margin-bottom: 6px;
}

.controls-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 34px;
    min-height: 34px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(54, 65, 82);
}

.controls-key-btn {
    width: 150px;
    height: 26px;
    margin: 0;
    background-color: rgb(29, 36, 46);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    color: rgb(238, 242, 246);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.controls-key-btn:hover {
    background-color: rgb(61, 74, 92);
}

.controls-key-btn--capturing {
    background-color: rgb(224, 138, 60);
    border-color: rgb(232, 163, 98);
    color: rgb(18, 22, 29);
}

.controls-fixed-key {
    color: rgb(176, 188, 204);
    font-size: 13px;
    -unity-text-align: middle-right;
}
