/* PopupMenu.uss - the dropdown popup list. Unity builds it at the root of the PANEL, outside every UIDocument, so neither the
   document style sheets nor their :root variables reach it. PopupStyles.cs adds this sheet to the panel root, so it carries its
   own copy of the tokens in :root (tools/sync_ui_tokens.py keeps it in step with UITokens.uss). Rules use tokens only. */

:root {
/* BEGIN UI TOKENS (generated by tools/sync_ui_tokens.py from UITokens.uss; do not edit here) */
    /* surfaces, dark to light */
    --c-ink: rgb(18, 22, 29);
    --c-well: rgb(26, 33, 43);
    --c-field: rgb(29, 36, 46);
    --c-panel: rgb(43, 52, 66);
    --c-raised: rgb(61, 74, 92);
    --c-rim: rgb(92, 102, 117);
    /* text */
    --c-text: rgb(238, 242, 246);
    --c-text-strong: rgb(255, 255, 255);
    --c-muted: rgb(139, 150, 165);
    /* primary accent (amber) */
    --c-accent: rgb(224, 138, 60);
    --c-accent-hi: rgb(241, 170, 104);
    --c-accent-lo: rgb(188, 112, 40);
    /* secondary accent (teal): information, success, enabled, positive values */
    --c-secondary: rgb(54, 196, 177);
    --c-secondary-hi: rgb(86, 214, 196);
    --c-secondary-lo: rgb(39, 135, 122);
    /* danger */
    --c-danger: rgb(198, 32, 38);
    --c-danger-text: rgb(228, 92, 96);
    /* font weights 100 to 900 (400 = --font, 500 = --font-medium, 700 = --font-bold are declared next to the tokens) */
    --font-thin: resource("HUDTree/Fonts/HomesteaderHUD_Thin");
    --font-extralight: resource("HUDTree/Fonts/HomesteaderHUD_ExtraLight");
    --font-light: resource("HUDTree/Fonts/HomesteaderHUD_Light");
    --font-semibold: resource("HUDTree/Fonts/HomesteaderHUD_SemiBold");
    --font-extrabold: resource("HUDTree/Fonts/HomesteaderHUD_ExtraBold");
    --font-black: resource("HUDTree/Fonts/HomesteaderHUD_Black");
    /* shape */
    --r: 6px;
/* END UI TOKENS */
}

/* Layout of the popup (the Unity default theme supplied this; without it the popup became a normal child of the panel root and
   pushed the whole HUD, the hotbar included, up the screen while a list was open). */
.unity-base-dropdown {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.unity-base-dropdown__container-outer {
    position: absolute;
    background-color: var(--c-well);
    border-width: 1px;
    border-color: var(--c-accent);
    border-radius: var(--r);
    padding: 2px;
    min-width: 170px;
}

.unity-base-dropdown__container-inner {
    background-color: var(--c-well);
}

.unity-base-dropdown__item {
    flex-direction: row;
    align-items: center;
    height: 26px;
    min-height: 26px;
    padding: 0 8px;
    background-color: rgba(18, 22, 29, 0);
}

.unity-base-dropdown__item:hover {
    background-color: var(--c-raised);
}

.unity-base-dropdown__item:checked {
    background-color: var(--c-accent);
}

.unity-base-dropdown__label {
    flex-grow: 1;
    font-size: 12px;
    -unity-font: var(--font-medium);
    color: rgb(225, 235, 245);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.unity-base-dropdown__item:checked .unity-base-dropdown__label {
    color: var(--c-well);
}
