/* SpeedControls.uss - speed chip row.

   Five chips in a row, each 44x28, amber border, dark fill.
   HudBindings wires Button.clicked events via Q&lt;Button&gt;() lookups. */

.speed-controls-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin-top: 6px;
    justify-content: center;
}

.speed-chip {
    width: 44px;
    height: 28px;
    margin-left: 4px;
    margin-right: 4px;
    border-color: var(--c-muted);
    border-width: 2px;
    border-radius: var(--r);
    background-color: var(--c-well);
    -unity-font: var(--font-medium);
    color: var(--c-text);
    font-size: 13px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.speed-chip:hover {
    border-color: var(--c-accent);
    color: rgb(242, 132, 29);
}

.speed-chip:checked {
    border-color: var(--c-accent);
    background-color: var(--c-raised);
    color: rgb(242, 132, 29);
}
