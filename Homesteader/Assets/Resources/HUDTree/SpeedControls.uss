/* SpeedControls.uss - speed chip row.

   Five chips in a row, each 44x28, amber border, dark fill.
   HudBindings wires Button.clicked events via Q&lt;Button&gt;() lookups. */

.speed-controls-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin-top: 6px;
    justify-content: center;
}

.speed-chip {
    width: 44px;
    height: 28px;
    margin-left: 4px;
    margin-right: 4px;
    border-color: rgb(139, 150, 165);
    border-width: 2px;
    border-radius: 0;
    background-color: rgb(26, 33, 43);
    -unity-font: var(--font-medium);
    color: rgb(238, 242, 246);
    font-size: 14px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.speed-chip:hover {
    border-color: rgb(224, 138, 60);
    color: rgb(242, 132, 29);
}

.speed-chip:checked {
    border-color: rgb(224, 138, 60);
    background-color: rgb(61, 74, 92);
    color: rgb(242, 132, 29);
}
