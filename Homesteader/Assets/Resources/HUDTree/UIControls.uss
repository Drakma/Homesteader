/* UIControls.uss - the shared controls of the design system (docs/UI_DESIGN_SYSTEM.md section 6).

   Attached to every UI document next to its own stylesheet (HudUI.uxml, WelcomeMenu.uxml). A feature stylesheet sets
   layout (position, width, margin) only; colour, border, radius, font and hover of a control come from here.
   Tokens (--c-*, --r) are declared in each document's :root (see UITokens.uss and tools/sync_ui_tokens.py). */

/* ============================================================ accent edge
   A thin amber bar down the left of a card or window that fades into the normal border colour. Add
   <ui:VisualElement class="hs-accent-edge" picking-mode="Ignore" /> as the FIRST child of a card with overflow hidden. */

.hs-accent-edge {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background-image: resource("HUDTree/Textures/accent_edge");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ============================================================ close button (22 px square, one look everywhere) */

.hs-close {
    width: 22px;
    height: 22px;
    min-width: 22px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-color: rgba(18, 22, 29, 0);
    border-width: 1px;
    border-color: rgba(227, 83, 88, 0.4);
    border-radius: var(--r);
    color: var(--c-danger-text);
    font-size: 13px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
}

.hs-close:hover {
    background-color: var(--c-danger);
    border-color: var(--c-danger);
    color: var(--c-text-strong);
}

.hs-close:active {
    background-color: var(--c-danger-text);
}

/* ============================================================ buttons
   .hs-btn alone is the neutral button. Modifiers: --primary (the one main action), --danger, --teal (positive or
   informational), --ghost, --chip with --active, --lg (menu size). The look of every button (including the older
   per-window classes such as .welcome-btn or .admin-chip-btn) comes from the generated groups below; only size lives
   here and in the feature stylesheets. Regenerate with tools/ui_migrate_buttons.py. */

.hs-btn {
    height: 30px;
    min-width: 30px;
    margin: 0 4px;
    padding: 0 14px;
    border-width: 1px;
    font-size: 13px;
}

.hs-btn:disabled {
    opacity: 0.55;
}

.hs-btn--chip {
    height: 26px;
    padding: 0 10px;
    font-size: 12px;
}

.hs-btn--lg {
    height: 40px;
    padding: 0 16px;
    font-size: 15px;
    letter-spacing: 0.5px;
}

/* BEGIN BUTTON GROUPS (generated by tools/ui_migrate_buttons.py; do not edit here) */
.hs-btn,
.action-btn,
.action-btn--secondary,
.welcome-btn,
.settings-action-btn,
.settings-footer-btn,
.bank-action-btn,
.admin-chip-btn,
.admin-step-btn,
.admin-vital-zero-btn,
.admin-set-btn,
.mods-category-back-btn,
.controls-key-btn,
.steadify-popout-btn,
.header-settings-btn,
.almanac-tab-btn,
.mod-toggle-btn {
    background-color: var(--c-panel);
    border-color: var(--c-raised);
    border-radius: var(--r);
    color: var(--c-text);
    -unity-font: var(--font-medium);
    -unity-text-align: middle-center;
}

.hs-btn:hover,
.action-btn:hover,
.action-btn--secondary:hover,
.welcome-btn:hover,
.settings-action-btn:hover,
.settings-footer-btn:hover,
.bank-action-btn:hover,
.admin-chip-btn:hover,
.admin-step-btn:hover,
.admin-vital-zero-btn:hover,
.admin-set-btn:hover,
.mods-category-back-btn:hover,
.controls-key-btn:hover,
.steadify-popout-btn:hover,
.header-settings-btn:hover,
.almanac-tab-btn:hover,
.mod-toggle-btn:hover {
    background-color: var(--c-raised);
    border-color: var(--c-rim);
    color: var(--c-text-strong);
}

.hs-btn:active,
.action-btn:active,
.action-btn--secondary:active,
.welcome-btn:active,
.settings-action-btn:active,
.settings-footer-btn:active,
.bank-action-btn:active,
.admin-chip-btn:active,
.admin-step-btn:active,
.admin-vital-zero-btn:active,
.admin-set-btn:active,
.mods-category-back-btn:active,
.controls-key-btn:active,
.steadify-popout-btn:active,
.header-settings-btn:active,
.almanac-tab-btn:active,
.mod-toggle-btn:active {
    background-color: var(--c-well);
}

.hs-btn--primary,
.action-btn--primary,
.welcome-btn--primary,
.store-item-buy-btn,
.controls-key-btn--capturing,
.container-panel-btn {
    background-color: var(--c-accent);
    border-color: var(--c-accent-hi);
    color: var(--c-ink);
    -unity-font: var(--font-bold);
}

.hs-btn--primary:hover,
.action-btn--primary:hover,
.welcome-btn--primary:hover,
.store-item-buy-btn:hover,
.controls-key-btn--capturing:hover,
.container-panel-btn:hover {
    background-color: var(--c-accent-hi);
    border-color: var(--c-accent-hi);
    color: var(--c-ink);
}

.hs-btn--primary:active,
.action-btn--primary:active,
.welcome-btn--primary:active,
.store-item-buy-btn:active,
.controls-key-btn--capturing:active,
.container-panel-btn:active {
    background-color: var(--c-accent-lo);
}

.hs-btn--danger,
.welcome-btn--exit,
.mod-toggle-btn--disabled {
    background-color: rgba(18, 22, 29, 0);
    border-color: rgba(227, 83, 88, 0.4);
    color: var(--c-danger-text);
}

.hs-btn--danger:hover,
.welcome-btn--exit:hover,
.mod-toggle-btn--disabled:hover {
    background-color: var(--c-danger);
    border-color: var(--c-danger);
    color: var(--c-text-strong);
}

.hs-btn--teal,
.admin-header-assets-btn,
.admin-action-btn,
.mod-toggle-btn--enabled,
.steadify-shuffle-all-btn {
    background-color: rgba(54, 196, 177, 0.14);
    border-color: var(--c-secondary-lo);
    color: var(--c-secondary-hi);
    -unity-font: var(--font-bold);
}

.hs-btn--teal:hover,
.admin-header-assets-btn:hover,
.admin-action-btn:hover,
.mod-toggle-btn--enabled:hover,
.steadify-shuffle-all-btn:hover {
    background-color: var(--c-secondary-lo);
    border-color: var(--c-secondary);
    color: var(--c-text-strong);
}

.hs-btn--ghost,
.phone-back-btn,
.market-tab-btn,
.settings-nav-btn {
    background-color: rgba(18, 22, 29, 0);
    border-color: rgba(18, 22, 29, 0);
    color: var(--c-muted);
}

.hs-btn--ghost:hover,
.phone-back-btn:hover,
.market-tab-btn:hover,
.settings-nav-btn:hover {
    background-color: var(--c-raised);
    border-color: rgba(18, 22, 29, 0);
    color: var(--c-text-strong);
}

.hs-btn--active,
.admin-chip-btn--active,
.market-tab-btn--active,
.almanac-tab-btn--active,
.settings-nav-btn--active {
    background-color: rgba(224, 138, 60, 0.22);
    border-color: var(--c-accent-hi);
    color: rgb(255, 219, 185);
    -unity-font: var(--font-bold);
}

/* END BUTTON GROUPS */

/* ============================================================ checkbox (a labelled row's box; 24 px) */

.hs-toggle {
    color: var(--c-text);
    font-size: 13px;
    -unity-font: var(--font-medium);
    flex-shrink: 0;
    min-width: 30px;
    min-height: 30px;
    margin-right: 0;
}

.hs-toggle > .unity-toggle__input {
    flex-grow: 0;
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--c-well);
    border-width: 2px;
    border-color: var(--c-raised);
    border-radius: var(--r);
}

.hs-toggle .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("HUDTree/Textures/check");
    -unity-background-image-tint-color: var(--c-ink);
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
}

.hs-toggle:checked .unity-toggle__checkmark,
.hs-toggle > .unity-toggle__input:checked .unity-toggle__checkmark {
    opacity: 1;
}

.hs-toggle:checked > .unity-toggle__input,
.hs-toggle > .unity-toggle__input:checked {
    background-color: var(--c-accent);
    border-color: var(--c-accent-hi);
}

.hs-toggle:hover > .unity-toggle__input {
    border-color: var(--c-accent-hi);
}

.hs-toggle:focus > .unity-toggle__input {
    border-color: var(--c-accent);
}

.hs-toggle:disabled {
    opacity: 0.55;
}

/* ============================================================ slider
   The runtime theme draws no slider parts, so every part is styled. The hit area needs an explicit height or the
   slider collapses to nothing (CLAUDE.md 1a). */

.hs-slider {
    height: 22px;
    min-height: 22px;
    margin: 0 0 10px 0;
    padding: 0;
    flex-shrink: 0;
}

.hs-slider .unity-slider__label {
    color: var(--c-text);
    font-size: 13px;
    -unity-font: var(--font-medium);
    min-width: 150px;
}

.hs-slider .unity-base-slider__drag-container {
    height: 22px;
    justify-content: center;
}

.hs-slider .unity-base-slider__tracker {
    height: 6px;
    background-color: var(--c-well);
    border-width: 1px;
    border-color: var(--c-raised);
    border-radius: 3px;
}

.hs-slider .unity-base-slider__dragger {
    width: 16px;
    height: 16px;
    margin-top: -5px;
    background-color: var(--c-accent);
    border-width: 1px;
    border-color: var(--c-accent-hi);
    border-radius: var(--r);
}

.hs-slider .unity-base-slider__dragger:hover {
    background-color: var(--c-accent-hi);
}

.hs-slider .unity-base-slider__dragger:active {
    background-color: var(--c-accent-lo);
}

/* ============================================================ dropdown (width is set where it is used) */

.hs-dropdown {
    height: 30px;
    margin: 0;
}

.hs-dropdown > .unity-base-popup-field__input,
.hs-dropdown .unity-base-popup-field__input {
    height: 100%;
    margin: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 8px;
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-left;
    background-color: var(--c-field);
    border-width: 1px;
    border-color: var(--c-raised);
    border-radius: var(--r);
    color: var(--c-text);
    font-size: 13px;
    -unity-font: var(--font-medium);
}

.hs-dropdown .unity-base-popup-field__text {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.hs-dropdown .unity-base-popup-field__input:hover {
    border-color: var(--c-accent);
}

/* ============================================================ text field and search box */

.hs-field {
    height: 30px;
    margin: 0;
}

.hs-field > .unity-base-text-field__input,
.hs-field > .unity-text-field__input {
    height: 100%;
    margin: 0;
    padding: 0 8px;
    justify-content: center;
    -unity-text-align: middle-left;
    background-color: var(--c-well);
    border-width: 1px;
    border-color: var(--c-raised);
    border-radius: var(--r);
    color: var(--c-text);
    font-size: 13px;
    -unity-font: var(--font-medium);
}

.hs-field > .unity-base-text-field__input:focus,
.hs-field > .unity-text-field__input:focus {
    border-color: var(--c-accent);
}

.hs-field TextElement,
.hs-field .unity-base-text-field__placeholder {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.hs-field .unity-base-text-field__placeholder {
    color: var(--c-muted);
}

/* ============================================================ scrollbars (every ScrollView) */

.unity-scroller--vertical {
    width: 8px;
    margin: 4px 2px 4px 0;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    width: 6px;
    background-color: rgba(18, 22, 29, 0.4);
    border-width: 0;
    border-radius: 3px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    width: 6px;
    background-color: rgba(224, 138, 60, 0.45);
    border-width: 0;
    border-radius: 3px;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(241, 170, 104, 0.85);
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

/* ============================================================ tooltips
   Unity draws tooltips inside the panel, so they scale with the HUD Scale setting; the mouse pointer is a hardware
   cursor and does not scale. */

.unity-tooltip {
    background-color: rgba(18, 22, 29, 0.95);
    border-width: 1px;
    border-color: var(--c-raised);
    border-radius: var(--r);
    padding: 4px 8px;
    max-width: 260px;
}

.unity-tooltip > .unity-label,
.unity-tooltip .unity-label {
    color: var(--c-text);
    font-size: 11px;
    -unity-font: var(--font-italic);
    white-space: normal;
}
