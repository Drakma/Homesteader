/* ResourcesBar.uss - 4-row resource display.

   Each row: tinted icon placeholder + amount label. No fills. */

.resources-root {
    flex-direction: column;
    align-items: stretch;
    height: 124px;
}

.resource-row {
    flex-direction: row;
    align-items: center;
    height: 28px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 6px;
}

.resource-icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    flex-shrink: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(18, 22, 29);
}

.resource-icon-water        { background-color: rgb(40, 110, 168); }
.resource-icon-electricity  { background-color: rgb(224, 138, 60); }
.resource-icon-bandwidth    { background-color: rgb(96, 168, 96); }
.resource-icon-fuel         { background-color: rgb(168, 92, 60); }

.resource-amount {
    color: rgb(238, 242, 246);
    font-size: 18px;
    -unity-font: var(--font);
    -unity-text-align: middle-left;
    white-space: nowrap;
}
