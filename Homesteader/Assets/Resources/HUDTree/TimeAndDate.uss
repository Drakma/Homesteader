/* TimeAndDate.uss - centered season/day/clock widget. */

.time-and-date-root {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 96px;
}

.time-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}

.season-label {
    color: rgb(104, 168, 96);
    font-size: 18px;
    -unity-font: var(--font-bold);
    margin-right: 8px;
    -unity-text-align: middle-center;
}

.day-label {
    color: rgb(238, 242, 246);
    font-size: 18px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
}

.clock-label {
    color: rgb(242, 132, 29);
    font-size: 34px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    height: 38px;
    margin-top: 2px;
}
