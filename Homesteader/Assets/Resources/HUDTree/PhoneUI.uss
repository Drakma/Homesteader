}

.mods-search-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px 6px 14px;
}

.mods-search-input {
    flex-grow: 1;
    height: 34px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    justify-content: center;
}

.mods-search-input > .unity-text-field__input,
.mods-search-input > .unity-base-text-field__input {
    background-color: var(--c-panel);
    border-radius: var(--r);
    border-width: 1px;
    border-color: var(--c-raised);
    color: var(--c-text);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 0;
    padding-bottom: 0;
    margin: 0;
    font-size: 13px;
    -unity-font: var(--font-medium);
    -unity-text-align: middle-left;
    justify-content: center;
    align-self: stretch;
    height: 100%;
}

.mods-search-input:focus > .unity-text-field__input,
.mods-search-input:focus > .unity-base-text-field__input,
.mods-search-input > .unity-text-field__input:focus,
.mods-search-input > .unity-base-text-field__input:focus {
    border-color: var(--c-accent);
    background-color: var(--c-panel);
}

.mods-search-input TextElement,
.mods-search-input .unity-base-text-field__placeholder {
    -unity-text-align: middle-left;
}

.mods-category-scroll {
    height: 38px;
    min-height: 38px;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
}

.mods-category-nav {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 14px;
    background-color: rgba(26, 33, 43, 0.95);
    border-bottom-width: 1px;
    border-color: var(--c-panel);
    min-height: 38px;
}

.mods-category-back-btn {
    border-width: 1px;
    font-size: 11px;
    padding: 4px 10px;
}

.mods-category-nav-title {
    font-size: 13px;
    color: rgb(237, 178, 123);
    -unity-font: var(--font-bold);
    flex-grow: 1;
    margin-left: 8px;
}

.mods-cards-container {
    padding-bottom: 30px;
}

.mods-category-card {
    margin: 6px 14px;
    padding: 12px 14px;
    background-color: rgba(43, 52, 66, 0.95);
    border-radius: var(--r);
    border-width: 1px;
    border-color: var(--c-raised);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mods-category-card:hover {
    background-color: rgba(43, 52, 66, 0.98);
    border-color: var(--c-rim);
}

.mods-category-card-left {
    flex-direction: column;
    flex-grow: 1;
}

.mods-category-card-name {
    font-size: 13px;
    color: var(--c-text);
    -unity-font: var(--font-medium);
    margin-bottom: 3px;
}

.mods-category-card-sub {
    font-size: 11px;
    color: rgb(147, 161, 179);
    -unity-font: var(--font);
}

.mods-category-card-right {
    flex-direction: row;
    align-items: center;
}

.mods-category-open-arrow {
    font-size: 18px;
    color: var(--c-text);
    margin-left: 10px;
    -unity-font: var(--font-bold);
}

.mod-toggle-btn {
    padding: 4px 10px;
    font-size: 11px;
    border-width: 1px;
    align-self: center;
}

.mod-badge--enabled {
    background-color: rgb(22, 68, 40);
    border-color: rgb(39, 133, 121);
    color: rgb(165, 245, 190);
}

.mod-badge--disabled {
    background-color: rgb(65, 28, 32);
    border-color: rgb(130, 50, 60);
    color: rgb(245, 175, 177);
}

.mod-card {
    margin: 6px 14px;
    padding: 12px 14px;
    background-color: rgba(43, 52, 66, 0.95);
    border-radius: var(--r);
    border-width: 1px;
    border-color: var(--c-raised);
    flex-direction: column;
}

.mod-card-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.mod-title {
    font-size: 13px;
    color: rgb(237, 178, 123);
    -unity-font: var(--font-bold);
    flex-grow: 1;
}

.mod-badge {
    padding: 2px 8px;
    border-radius: var(--r);
    border-width: 1px;
    background-color: var(--c-raised);
    color: rgb(160, 195, 245);
    font-size: 11px;
    -unity-font: var(--font-bold);
}

.mod-desc {
    font-size: 11px;
    color: rgb(147, 161, 179);
    -unity-font: var(--font);
    white-space: normal;
    line-height: 14px;
    margin-bottom: 6px;
}

.mod-meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    color: var(--c-muted);
}

.mod-action-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-color: var(--c-panel);
}

.mod-folder-label {
    font-size: 11px;
    color: var(--c-muted);
    -unity-font: var(--font);
    flex-grow: 1;
}

