/* =========================================================================
   PAGINATED APP LAUNCHER (3 x 4 Grid per Page with Dot Navigation & Swiping)
   ========================================================================= */

.phone-launcher-viewport {
    flex-grow: 1;
    width: 100%;
    overflow: hidden;
    position: relative;
    justify-content: flex-start;
}

.phone-launcher-track {
    flex-direction: row;
    height: 100%;
    /* translate.x is driven by page transitions (0px, -384px, etc.) */
    transition-property: translate;
    transition-duration: 0.32s;
    transition-timing-function: ease-out-cubic;
}

.phone-launcher-page {
    width: 384px;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    padding: 2px 0 0 0;
    flex-shrink: 0;
}

.phone-page-dots-row {
    height: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    margin-bottom: 2px;
    flex-shrink: 0;
}

.phone-page-dots-row--hidden {
    display: none;
}

.phone-page-dot {
    width: 44px;
    height: 32px;
    align-items: center;
    justify-content: center;
    margin: 0 4px;
    background-color: transparent;
}

.phone-page-dot-inner {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
    border-radius: var(--r);
    background-color: rgba(180, 205, 235, 0.55);
    transition-property: background-color, scale;
    transition-duration: 0.2s;
}

.phone-page-dot:hover .phone-page-dot-inner {
    background-color: rgba(215, 235, 255, 0.85);
    scale: 1.15 1.15;
}

.phone-page-dot--active .phone-page-dot-inner {
    background-color: rgb(241, 173, 109);
    scale: 1.25 1.25;
}

.phone-page-dot--active:hover .phone-page-dot-inner {
    background-color: rgb(255, 188, 125);
    scale: 1.35 1.35;
}

/* ============================================== */
/* STEADIFY MINI PLAYER (pop-out window)           */
/* ============================================== */
.steadify-mini {
    width: 320px;
}

.steadify-mini-header {
    padding-right: 6px;
    flex-direction: row;
    align-items: center;
    height: 30px;
}

.steadify-mini-header-title {
    flex-grow: 1;
}

.steadify-mini-close:hover {
    color: var(--c-text-strong);
    background-color: rgb(170, 60, 50);
}

/* The art fills the whole left side; the text and controls stack to its right. */
.steadify-mini-body {
    flex-direction: row;
    padding: 6px;
}

.steadify-mini-art {
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    border-radius: 5px;
    background-color: var(--c-panel);
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.steadify-mini-art-glyph {
    font-size: 32px;
}

.steadify-mini-mid {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: space-between;
    margin-left: 8px;
    overflow: hidden;
}

.steadify-mini-playlist {
    width: 130px;
    flex-shrink: 0;
    height: 22px;
    margin: 0 6px 0 0;
}

.steadify-mini-playlist .unity-base-popup-field__input {
    height: 22px;
    min-height: 22px;
    margin: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 6px;
    justify-content: center;
    -unity-text-align: middle-left;
    font-size: 13px;
}

.steadify-mini-playlist .unity-base-popup-field__text,
.steadify-mini-playlist .unity-popup-field__text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.steadify-mini-meta {
    color: var(--c-muted);
    font-size: 13px;
    margin: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.steadify-mini-songbox {
    flex-grow: 1;
    justify-content: center;
}

.steadify-mini-title {
    -unity-font: var(--font-bold);
    color: rgb(232, 236, 241);
    font-size: 15px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.steadify-mini-row {
    flex-direction: row;
    align-items: center;
}

.steadify-mini-time {
    color: var(--c-muted);
    font-size: 11px;
    width: 36px;
    -unity-text-align: middle-left;
}

/* Glyph-only buttons: grey at rest, white on hover, orange while on. */
.steadify-mini-btn {
    -unity-font: var(--font-bold);
    width: 24px;
    height: 22px;
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-text-align: middle-center;
    color: rgb(120, 132, 148);
    background-color: transparent;
    border-width: 0;
}

.steadify-mini-btn:hover {
    color: var(--c-text-strong);
}

.steadify-mini-btn--on,
.steadify-mini-btn--on:hover {
    color: rgb(246, 157, 75);
}

/* The vertical volume slider on the right. The runtime theme draws no slider parts, so the drag area, the track and the handle are all
   given explicit sizes and positions (a vertical slider needs a height on the drag container or there is nothing to drag). */
.steadify-mini-volume {
    width: 18px;
    height: 62px;
    min-width: 18px;
    min-height: 62px;
    margin: 0 0 0 6px;
    padding: 0;
    flex-shrink: 0;
}

.steadify-mini-volume .unity-base-slider__drag-container {
    width: 18px;
    height: 62px;
    flex-grow: 0;
}

.steadify-mini-volume .unity-base-slider__tracker {
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 6px;
    left: 6px;
    background-color: var(--c-well);
    border-width: 1px;
    border-color: var(--c-raised);
    border-radius: 3px;
}

.steadify-mini-volume .unity-base-slider__dragger {
    position: absolute;
    width: 16px;
    height: 16px;
    left: 1px;
    border-radius: 8px;
    background-color: var(--c-accent);
    border-width: 1px;
    border-color: var(--c-accent-hi);
}

.steadify-mini-volume .unity-base-slider__dragger:hover {
    background-color: var(--c-accent-hi);
}

/* ============================================== */
/* CONTAINER CONTENTS WINDOW (the C key)           */
/* ============================================== */
.container-panel {
    width: 300px;
}

.container-panel-capacity {
    color: var(--c-text);
    font-size: 12px;
    margin-bottom: 6px;
}

.container-panel-bar {
    height: 8px;
    border-radius: 4px;
    background-color: var(--c-well);
    overflow: hidden;
    margin-bottom: 12px;
}

.container-panel-bar-fill {
    height: 8px;
    background-color: var(--c-secondary);
}

.container-panel-bar-fill--full {
    background-color: var(--c-accent);
}

.container-panel-hint {
    color: var(--c-muted);
    font-size: 11px;
    white-space: normal;
}

.container-panel-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
}

.container-panel-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.container-panel-row-name {
    flex-grow: 1;
    color: var(--c-text);
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.container-panel-btn {
    height: 20px;
    margin: 0 0 0 6px;
    padding: 0 8px;
    font-size: 11px;
    border-width: 0;
}
