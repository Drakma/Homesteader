/* Additional Store Banners */
.store-banner-lumber        { background-color: rgb(110, 65, 30); }
.store-banner-auto          { background-color: rgb(40, 70, 115); }
.store-banner-fuel          { background-color: rgb(140, 50, 30); }
.store-banner-structures    { background-color: rgb(60, 85, 55); }
.store-banner-equipment     { background-color: rgb(135, 95, 25); }
.store-banner-furniture     { background-color: rgb(85, 55, 110); }
.store-banner-voltvision    { background-color: rgb(15, 65, 135); }
.store-banner-trailershack  { background-color: rgb(85, 65, 45); }

/* =========================================================================
   PAGINATED APP LAUNCHER (3 x 4 Grid per Page with Dot Navigation & Swiping)
   ========================================================================= */

.phone-launcher-viewport {
    flex-grow: 1;
    width: 100%;
    overflow: hidden;
    position: relative;
    justify-content: flex-start;
}

.phone-launcher-track {
    flex-direction: row;
    height: 100%;
    /* translate.x is driven by page transitions (0px, -384px, etc.) */
    transition-property: translate;
    transition-duration: 0.32s;
    transition-timing-function: ease-out-cubic;
}

.phone-launcher-page {
    width: 384px;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    padding: 2px 0 0 0;
    flex-shrink: 0;
}

.phone-page-dots-row {
    height: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    margin-bottom: 2px;
    flex-shrink: 0;
}

.phone-page-dots-row--hidden {
    display: none;
}

.phone-page-dot {
    width: 44px;
    height: 32px;
    align-items: center;
    justify-content: center;
    margin: 0 4px;
    background-color: transparent;
}

.phone-page-dot-inner {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
    border-radius: 5px;
    background-color: rgba(180, 205, 235, 0.55);
    transition-property: background-color, scale;
    transition-duration: 0.2s;
}

.phone-page-dot:hover .phone-page-dot-inner {
    background-color: rgba(215, 235, 255, 0.85);
    scale: 1.15 1.15;
}

.phone-page-dot--active .phone-page-dot-inner {
    background-color: rgb(240, 205, 95);
    scale: 1.25 1.25;
}

.phone-page-dot--active:hover .phone-page-dot-inner {
    background-color: rgb(255, 220, 110);
    scale: 1.35 1.35;
}


