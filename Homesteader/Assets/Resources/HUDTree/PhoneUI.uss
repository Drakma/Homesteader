/* PhoneUI.uss - Styles for the Homesteader In-Game Smartphone OS & Apps.
 * 
 * Frame: Rugged homestead smartphone positioned at right-middle of viewport.
 * Dimensions: 360px x 680px with rounded bezel, speaker notch, and status bar.
 * Toggled via Tab key with smooth translation animation.
 */

/* The template container HudUI.uxml puts the phone in: a full-screen, click-through layer, so the phone's own
   absolute positioning (right / top 50%) is measured against the screen exactly as before. */
.phone-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Container anchored to the right-middle of the screen */
.phone-wrapper {
    position: absolute;
    right: 24px;
    top: 50%;
    translate: 0 -440px;
    width: 440px;
    height: 880px;
}

/* Hidden state: display none completely removes hit testing and visual output */
.phone-wrapper--hidden {
    display: none;
}

/* Smartphone Bezel / Outer Chassis */
.phone-chassis {
    width: 100%;
    height: 100%;
    background-color: var(--c-well);
    border-radius: 38px;
    border-width: 3px;
    border-color: var(--c-raised);
    border-top-color: var(--c-rim);
    border-bottom-color: var(--c-ink);
    padding: 11px;
    flex-direction: column;
}

/* Screen Viewport with smooth rounded corners and dark backdrop */
.phone-screen {
    width: 100%;
    height: 100%;
    background-color: var(--c-well);
    border-radius: 28px;
    overflow: hidden;
    flex-direction: column;
    position: relative;
}

/* Top Speaker / Dynamic Notch */
.phone-notch-bar {
    height: 20px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
}

.phone-speaker-pill {
    width: 70px;
    height: 6px;
    background-color: var(--c-ink);
    border-radius: var(--r);
    border-width: 1px;
    border-color: var(--c-panel);
}

/* Status Bar: Signal, Time, Battery */
.phone-status-bar {
    height: 32px;
    padding-top: 4px;
    padding-left: 20px;
    padding-right: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.phone-status-time-row {
    flex-direction: row;
    align-items: center;
}

.phone-status-time {
    color: var(--c-text);
    font-size: 15px;
    -unity-font: var(--font-bold);
}

.phone-celestial-icon {
    width: 22px;
    height: 22px;
    margin-left: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.phone-status-icons {
    flex-direction: row;
    align-items: center;
}

.phone-status-icon {
    color: var(--c-text);
    font-size: 13px;
    margin-left: 6px;
}

.phone-battery-pill {
    width: 24px;
    height: 12px;
    border-width: 1px;
    border-color: rgb(147, 161, 179);
    border-radius: var(--r);
    margin-left: 8px;
    padding: 1px;
    flex-direction: row;
}

.phone-battery-fill {
    height: 100%;
    width: 82%;
    background-color: rgb(92, 208, 192);
    border-radius: var(--r);
}

/* Content Area inside Screen */
.phone-content {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}

/* =========================================================================
   HOME SCREEN / APP LAUNCHER
   ========================================================================= */

.phone-home {
    flex-grow: 1;
    flex-direction: column;
    padding: 12px 14px 4px 14px;
    justify-content: flex-start;
}

.phone-home--hidden {
    display: none;
}

.phone-widget-weather {
    background-color: rgba(43, 52, 66, 0.7);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--c-raised);
    padding: 10px 14px;
    margin-bottom: 8px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.phone-weather-temp {
    color: var(--c-text);
    font-size: 32px;
    -unity-font: var(--font-bold);
}

.phone-weather-info {
    color: rgb(147, 161, 179);
    font-size: 13px;
    margin-top: 2px;
}

.phone-weather-icon {
    font-size: 32px;
    color: rgb(242, 132, 29);
}

/* App Grid: Strict 3-column grid layout (Max 3 in a row) */
.phone-app-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    align-items: center;
    width: 384px;
    height: 100%;
    align-self: center;
}

.phone-app-tile {
    width: 128px;
    height: 148px;
    margin-bottom: 6px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
}

.phone-app-icon-box {
    width: 100px;
    height: 100px;
    border-radius: 26px;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
    border-width: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(18, 22, 29, 0);
}

.phone-app-icon-glyph {
    font-size: 32px;
    -unity-text-align: middle-center;
}

.phone-app-label {
    color: var(--c-text);
    font-size: 12px;
    -unity-font: var(--font);
    -unity-text-align: upper-center;
    white-space: normal;
    width: 100%;
    overflow: visible;
    padding-left: 2px;
    padding-right: 2px;
}

/* Specific app icon theme colors */
.app-icon-volt      { background-color: var(--c-accent); }
.app-icon-res       { background-color: rgb(45, 120, 195); }
.app-icon-depot     { background-color: rgb(215, 95, 30); }
.app-icon-grocer    { background-color: rgb(44, 151, 137); }
.app-icon-feed      { background-color: rgb(194, 115, 41); }
.app-icon-bank      { background-color: rgb(37, 128, 116); }
.app-icon-market    { background-color: rgb(140, 70, 160); }
.app-icon-almanac   { background-color: rgb(90, 80, 180); }

/* =========================================================================
   APP VIEWPORT & HEADER
   ========================================================================= */

.phone-app-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: var(--c-well);
    overflow: hidden;
    z-index: 10;
}

.phone-app-view--hidden {
    display: none;
}

.phone-app-header {
    height: 48px;
    padding-left: 14px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    background-color: var(--c-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--c-panel);
    flex-shrink: 0;
}

.phone-back-btn {
    width: 34px;
    height: 34px;
    border-width: 1px;
    font-size: 18px;
    padding: 0;
    margin-right: 10px;
    flex-shrink: 0;
}

.phone-app-title {
    color: var(--c-text);
    font-size: 15px;
    -unity-font: var(--font-bold);
    flex-grow: 1;
}

.phone-app-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    min-height: 0;
}

.phone-app-scroll .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    min-height: 0;
    overflow: hidden;
}

.phone-app-scroll .unity-scroll-view__content-container {
    flex-shrink: 0;
    flex-grow: 0;
    padding: 12px 14px 28px 14px;
}

.phone-app-scroll .unity-scroller--vertical {
    width: 6px;
    margin-top: 6px;
    margin-bottom: 6px;
    margin-right: 2px;
}

.phone-app-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(18, 22, 29, 0.4);
    border-radius: var(--r);
    border-width: 0;
    width: 6px;
}

.phone-app-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(224, 138, 60, 0.45);
    border-radius: var(--r);
    border-width: 0;
    width: 6px;
}

.phone-app-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(241, 170, 104, 0.85);
}

.phone-app-scroll .unity-scroller__low-button,
.phone-app-scroll .unity-scroller__high-button {
    display: none;
}

/* =========================================================================
   VOLT / GRID OS APP
   ========================================================================= */

.grid-card {
    background-color: var(--c-panel);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--c-panel);
    padding: 14px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.grid-card-title {
    color: rgb(147, 161, 179);
    font-size: 13px;
    -unity-font: var(--font-bold);
    margin-bottom: 8px;
}

.grid-metric-large {
    color: rgb(246, 157, 75);
    font-size: 32px;
    -unity-font: var(--font-bold);
}

.grid-metric-sub {
    color: var(--c-muted);
    font-size: 13px;
    margin-top: 2px;
}

.grid-bar-track {
    height: 12px;
    background-color: var(--c-ink);
    border-radius: var(--r);
    border-width: 1px;
    border-color: var(--c-panel);
    margin-top: 10px;
    overflow: hidden;
}

.grid-bar-fill-solar {
    height: 100%;
    width: 68%;
    background-color: rgb(242, 132, 29);
}

.grid-bar-fill-battery {
    height: 100%;
    width: 84%;
    background-color: var(--c-secondary);
}

/* =========================================================================
   STORE APPS (DEPOT, GROCER, FEED STORE)
   ========================================================================= */

/* Banner and search box above the scrolling items: they do not scroll away, and the list never slides under them. */
.store-fixed {
    flex-shrink: 0;
    flex-grow: 0;
    padding: 12px 14px 0 14px;
    background-color: var(--c-well);
    border-bottom-width: 1px;
    border-bottom-color: var(--c-raised);
}

.store-search-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.store-search-input {
    flex-grow: 1;
    height: 34px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    justify-content: center;
}

.store-search-input > .unity-text-field__input,
.store-search-input > .unity-base-text-field__input {
    background-color: var(--c-panel);
    border-radius: var(--r);
    border-width: 1px;
    border-color: var(--c-raised);
    color: var(--c-text);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 0;
    padding-bottom: 0;
    margin: 0;
    font-size: 13px;
    -unity-font: var(--font-medium);
    -unity-text-align: middle-left;
    justify-content: center;
    align-self: stretch;
    height: 100%;
}

.store-search-input:focus > .unity-text-field__input,
.store-search-input:focus > .unity-base-text-field__input,
.store-search-input > .unity-text-field__input:focus,
.store-search-input > .unity-base-text-field__input:focus {
    border-color: var(--c-accent);
    background-color: var(--c-panel);
}

.store-search-input TextElement,
.store-search-input .unity-base-text-field__placeholder {
    -unity-text-align: middle-left;
}

.store-empty-search-label {
    color: rgb(147, 161, 179);
    font-size: 13px;
    -unity-font: var(--font-medium);
    -unity-text-align: middle-center;
    margin-top: 36px;
    margin-bottom: 24px;
}

.store-banner {
    border-radius: var(--r);
    padding: 8px 12px;
    margin-bottom: 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.store-banner-depot  { background-color: rgb(160, 65, 20); }
.store-banner-grocer { background-color: rgb(33, 112, 102); }
.store-banner-feed   { background-color: rgb(145, 86, 31); }

.store-banner-text {
    color: var(--c-text-strong);
    font-size: 13px;
    -unity-font: var(--font-bold);
}

.store-item-card {
    background-color: var(--c-panel);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--c-panel);
    padding: 12px 14px;
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.store-item-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.store-item-icon-box {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    background-color: var(--c-well);
    border-width: 1px;
    border-color: var(--c-panel);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
    padding: 2px;
    flex-shrink: 0;
}

.store-item-info {
    flex-direction: column;
}

.store-item-name {
    color: var(--c-text);
    font-size: 15px;
    -unity-font: var(--font-medium);
}

.store-item-price {
    color: var(--c-accent);
    font-size: 13px;
    -unity-font: var(--font-medium);
    margin-top: 2px;
}

.store-item-buy-btn {
    height: 30px;
    padding-left: 14px;
    padding-right: 14px;
    border-width: 0;
    font-size: 13px;
}

.gig-card {
    background-color: var(--c-panel);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--c-panel);
    padding: 14px 16px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.gig-card-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.gig-pay {
    color: var(--c-secondary);
    font-size: 15px;
    -unity-font: var(--font-bold);
}

.gig-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.gig-chip {
    background-color: rgba(224, 138, 60, 0.16);
    color: rgb(229, 179, 131);
    border-radius: var(--r);
    padding: 3px 8px;
    margin-right: 6px;
    margin-bottom: 4px;
    font-size: 11px;
    -unity-font: var(--font-medium);
}

.gig-chip--remote {
    background-color: rgba(52, 152, 219, 0.18);
    color: rgb(133, 193, 233);
}

.gig-blurb {
    color: var(--c-muted);
    font-size: 12px;
    margin-top: 8px;
    margin-bottom: 10px;
    white-space: normal;
}

/* =========================================================================
   STEADIFY (MUSIC PLAYER) APP
   ========================================================================= */

.steadify-playlist-selector-row {
   flex-direction: row;
   align-items: center;
   padding: 8px 12px;
   margin-bottom: 4px;
   flex-shrink: 0;
}

.steadify-shuffle-row {
   flex-direction: row;
   align-items: center;
   margin: 0 12px 6px 12px;
   flex-shrink: 0;
}

.steadify-popout-btn {
   width: 30px;
   height: 30px;
   margin: 0 0 0 8px;
   padding: 0;
   flex-shrink: 0;
   font-size: 18px;
   border-width: 0;
}

.steadify-shuffle-all-btn {
   flex-grow: 1;
   height: 30px;
   margin: 0;
   padding: 0;
   flex-shrink: 0;
   font-size: 13px;
   border-width: 0;
}

.steadify-playlist-selector-label {
   color: rgb(160, 170, 185);
   font-size: 12px;
   margin-right: 8px;
   flex-shrink: 0;
}

.steadify-playlist-selector {
   flex-grow: 1;
   font-size: 12px;
}

/* The chosen playlist name inside the dropdown. */
.steadify-playlist-selector .unity-base-popup-field__text,
.steadify-playlist-selector .unity-popup-field__text {
   color: var(--c-text-strong);
}

.steadify-now-playing-card {
    background-color: var(--c-well);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--c-panel);
    padding: 16px;
    margin-bottom: 12px;
    align-items: center;
    flex-shrink: 0;
}

.steadify-album-art {
    width: 96px;
    height: 96px;
    border-radius: 14px;
    background-color: var(--c-panel);
    justify-content: center;
    align-items: center;
    margin-bottom: 12px;
    background-image: none;
    -unity-background-image-tint-color: rgb(246, 157, 75);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.steadify-album-art-glyph {
    -unity-font: var(--font-bold);   /* the HUD font carries the media glyphs; without it Unity falls back to a system emoji font */
    color: var(--c-muted);
    font-size: 32px;
    -unity-text-align: middle-center;
}

.steadify-track-title {
    color: rgb(232, 236, 241);
    font-size: 15px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    white-space: normal;
}

.steadify-track-meta {
    color: var(--c-muted);
    font-size: 12px;
    margin-top: 2px;
    margin-bottom: 10px;
}

.steadify-seek-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    flex-shrink: 0;
    min-height: 24px;
}

.steadify-time-label {
    color: var(--c-muted);
    font-size: 11px;
    width: 34px;
    -unity-text-align: middle-center;
}

.steadify-seek-slider {
    flex-grow: 1;
    margin: 0 4px;
}

/* The seek bar and the volume slider are shared hs-sliders (UIControls.uss): the same track and handle as Settings. Layout only here. */
.steadify-seek-slider.hs-slider,
.steadify-volume-slider.hs-slider {
    height: 22px;
    min-height: 22px;
    margin: 0;
    padding: 0;
    flex-shrink: 1;
}

.steadify-seek-slider.hs-slider {
    margin: 0 4px;
}

.steadify-transport-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
}

.steadify-transport-btn {
    -unity-font: var(--font-bold);   /* the HUD font carries the media glyphs; without it Unity falls back to a system emoji font */
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: var(--c-panel);
    border-width: 0;
    font-size: 18px;
    color: rgb(232, 236, 241);
    margin: 0 6px;
    -unity-text-align: middle-center;
}

.steadify-transport-btn:hover {
    background-color: rgb(56, 67, 84);
}

.steadify-transport-btn--small {
    width: 32px;
    height: 32px;
    font-size: 20px;
    background-color: transparent;
    color: var(--c-muted);
}

.steadify-transport-btn--small.steadify-transport-btn--active {
    color: rgb(246, 157, 75);
}

.steadify-transport-btn--primary {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgb(246, 157, 75);
    color: var(--c-well);
    font-size: 20px;
}

.steadify-transport-btn--primary:hover {
    background-color: rgb(250, 179, 112);
}

.steadify-volume-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 14px;
    flex-shrink: 0;
    min-height: 28px;
}

.steadify-volume-glyph {
    -unity-font: var(--font-bold);   /* the HUD font carries the media glyphs; without it Unity falls back to a system emoji font */
    font-size: 20px;
    color: var(--c-muted);
    min-width: 46px;
    -unity-text-align: middle-left;
    margin-right: 8px;
    flex-shrink: 0;
}

.steadify-volume-slider {
    flex-grow: 1;
    flex-shrink: 1;
}

.steadify-volume-value {
    font-size: 12px;
    -unity-font: var(--font-bold);
    color: rgb(246, 175, 109);
    min-width: 38px;
    margin-left: 8px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.steadify-playlist-heading {
    color: var(--c-muted);
    font-size: 11px;
    -unity-font: var(--font-bold);
    letter-spacing: 1px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.steadify-track-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--c-panel);
    border-radius: 10px;
    padding: 10px 12px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.steadify-track-row--active {
    border-width: 1px;
    border-color: rgb(246, 157, 75);
    background-color: rgba(246, 157, 75, 0.12);
}

.steadify-track-row-glyph {
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    font-size: 15px;
    width: 22px;
    color: rgb(246, 157, 75);
}

.steadify-track-row-thumb {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background-color: var(--c-panel);
    margin-right: 10px;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.steadify-track-row-glyph--overlay {
    width: 100%;
    height: 100%;
    font-size: 13px;
    color: var(--c-text-strong);
    background-color: rgba(26, 33, 43, 0.45);
    -unity-text-align: middle-center;
    border-radius: 8px;
}

.steadify-track-row-info {
    flex-grow: 1;
}

.steadify-track-row-title {
    color: rgb(232, 236, 241);
    font-size: 13px;
    -unity-font: var(--font-medium);
}

.steadify-track-row-sub {
    color: var(--c-muted);
    font-size: 11px;
    margin-top: 1px;
}

.store-checkout-bar {
    height: 56px;
    background-color: var(--c-well);
    border-top-width: 1px;
    border-top-color: var(--c-panel);
    padding: 8px 16px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.store-cart-text {
    color: var(--c-text);
    font-size: 13px;
}

/* =========================================================================
   BOTTOM GESTURE / HOME BAR
   ========================================================================= */

.phone-bottom-bar {
    height: 18px;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    padding-bottom: 6px;
}

.phone-home-pill {
    width: 130px;
    height: 6px;
    background-color: rgba(220, 230, 245, 0.4);
    border-radius: var(--r);
}

.phone-home-pill:hover {
    background-color: rgba(241, 170, 104, 0.9);
}

/* =========================================================================
   FIRST HOMESTEAD BANK APP
   ========================================================================= */

.store-banner-exchange { background-color: rgb(110, 50, 130); }

.bank-card {
    background-color: var(--c-panel);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--c-panel);
    padding: 14px 16px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.bank-card-label {
    color: rgb(147, 161, 179);
    font-size: 13px;
    -unity-font: var(--font);
}

.bank-balance-large {
    color: var(--c-secondary);
    font-size: 32px;
    -unity-font: var(--font-bold);
    margin-top: 2px;
}

.bank-debt-large {
    color: rgb(231, 60, 66);
    font-size: 32px;
    -unity-font: var(--font-bold);
    margin-top: 2px;
}

.bank-card-sub {
    color: var(--c-muted);
    font-size: 13px;
    margin-top: 2px;
}

.bank-rate-pill {
    background-color: rgba(231, 60, 66, 0.2);
    color: rgb(231, 60, 66);
    border-radius: var(--r);
    padding: 3px 8px;
    font-size: 12px;
    -unity-font: var(--font-bold);
}

.bank-action-btn {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 4px;
    height: 34px;
    border-width: 1px;
    font-size: 13px;
}

.bank-loan-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-width: 1px;
    border-top-color: var(--c-panel);
}

/* =========================================================================
   PLAYER MARKETPLACE / EXCHANGE APP
   ========================================================================= */

.market-tab-bar {
    flex-direction: row;
    background-color: var(--c-well);
    height: 42px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-panel);
    flex-shrink: 0;
}

.market-tab-btn {
    flex-grow: 1;
    height: 100%;
    border-width: 0;
    border-bottom-width: 2px;
    font-size: 13px;
}

.phone-app-scroll--hidden {
    display: none;
}

/* =========================================================================
   6. ADMIN TOOLS APP STYLING
   ========================================================================= */

.app-icon-admin {
    border-color: rgb(224, 66, 71);
}

.admin-card {
    background-color: var(--c-well);
    border-width: 1px;
    border-color: var(--c-raised);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 12px;
    flex-shrink: 0;
    flex-grow: 0;
}

.admin-card-title {
    color: var(--c-accent);
    font-size: 13px;
    -unity-font: var(--font-bold);
    margin-bottom: 10px;
    letter-spacing: 0.6px;
    flex-shrink: 0;
}

.admin-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.admin-chip-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.admin-chip-btn {
    flex-grow: 1;
    height: 32px;
    margin: 0 4px;
    padding: 0;
    border-width: 1px;
    font-size: 13px;
}

.admin-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.admin-stepper-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.admin-step-btn {
    width: 34px;
    height: 28px;
    margin-left: 4px;
    padding: 0;
    border-width: 1px;
    font-size: 13px;
}

.admin-action-btn {
    height: 28px;
    padding: 0 12px;
    border-width: 1px;
    font-size: 12px;
}

.admin-label {
    color: var(--c-text);
    font-size: 13px;
    -unity-font: var(--font);
}

.admin-sublabel {
    color: rgb(147, 161, 179);
    font-size: 13px;
    margin-bottom: 2px;
}

.admin-vital-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
    flex-shrink: 0;
}

.admin-vital-zero-btn {
    width: 30px;
    height: 22px;
    padding: 0;
    border-width: 1px;
    font-size: 12px;
}

.admin-slider-row {
    margin-top: 8px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.admin-slider-container {
    height: 22px;
    justify-content: center;
    flex-shrink: 0;
}

.admin-slider.hs-slider {
    margin: 0;
    padding: 0;
    height: 22px;
    flex-shrink: 0;
}

.admin-scale-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 2px;
    padding-right: 2px;
    flex-shrink: 0;
}

.admin-scale-label {
    font-size: 11px;
    -unity-font: var(--font);
}

.admin-scale-label--min {
    color: rgb(231, 60, 66);
}

.admin-scale-label--mid {
    color: var(--c-accent);
    -unity-text-align: middle-center;
}

.admin-scale-label--max {
    color: var(--c-secondary);
    -unity-text-align: middle-right;
}

.admin-time-icon {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.admin-input-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.admin-input-label {
    color: var(--c-text);
    font-size: 13px;
    -unity-font: var(--font-medium);
    width: 130px;
    flex-shrink: 0;
}

.admin-text-field {
    flex-grow: 1;
    height: 30px;
