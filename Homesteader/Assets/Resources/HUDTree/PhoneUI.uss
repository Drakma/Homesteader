.app-icon-bazaar-behavior   { background-image: resource("HUDTree/PhoneIcons/app_bazaar_behavior"); }
.app-icon-shift-happens     { background-image: resource("HUDTree/PhoneIcons/app_shift_happens"); }
.app-icon-tank-you          { background-image: resource("HUDTree/PhoneIcons/app_tank_you"); }
.app-icon-drafting-behind   { background-image: resource("HUDTree/PhoneIcons/app_drafting_behind_you"); }
.app-icon-tractor-beam      { background-image: resource("HUDTree/PhoneIcons/app_tractor_beam"); }
.app-icon-wheel-deal        { background-image: resource("HUDTree/PhoneIcons/app_wheel_deal"); }
.app-icon-sofa-so-good      { background-image: resource("HUDTree/PhoneIcons/app_sofa_so_good"); }
.app-icon-grid-os           { background-image: resource("HUDTree/PhoneIcons/app_grid_os"); }
.app-icon-resview-levels    { background-image: resource("HUDTree/PhoneIcons/app_resview_levels"); }
.app-icon-good-almanac      { background-image: resource("HUDTree/PhoneIcons/app_good_almanac"); }
