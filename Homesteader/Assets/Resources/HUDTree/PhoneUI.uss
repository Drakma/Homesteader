    padding: 0;
    font-size: 13px;
    color: var(--c-text);
}

.admin-text-field > .unity-text-field__input {
    background-color: var(--c-well);
    border-color: var(--c-raised);
    border-width: 1px;
    border-radius: var(--r);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    color: var(--c-text);
    font-size: 13px;
    -unity-font: var(--font-medium);
    -unity-text-align: middle-left;
    justify-content: center;
    height: 100%;
}

.admin-text-field > .unity-text-field__input:focus {
    border-color: var(--c-accent);
}

.admin-set-btn {
    width: 50px;
    height: 30px;
    padding: 0;
    border-width: 1px;
    font-size: 13px;
}

/* =========================================================================
   7. ALMANAC APP STYLING
   ========================================================================= */

.phone-app-subtitle {
    font-size: 11px;
    color: rgb(147, 161, 179);
    margin-top: -2px;
}

.almanac-today-banner {
    background-color: var(--c-panel);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    padding: 10px 14px;
    flex-shrink: 0;
}

.almanac-today-title {
    font-size: 13px;
    -unity-font: var(--font-bold);
    color: rgb(219, 150, 86);
}

.almanac-today-details {
    font-size: 12px;
    color: rgb(147, 161, 179);
    margin-top: 3px;
}

.almanac-tab-bar {
    flex-direction: row;
    padding: 8px 12px;
    background-color: var(--c-well);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
}

.almanac-tab-btn {
    flex-grow: 1;
    height: 32px;
    border-width: 1px;
    font-size: 13px;
    margin-left: 4px;
    margin-right: 4px;
}

.almanac-cards-container {
    flex-direction: column;
    padding: 8px 10px 24px 10px;
    flex-shrink: 0;
}

.almanac-card {
    background-color: var(--c-panel);
    border-radius: var(--r);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 11px 14px;
    margin-bottom: 9px;
    flex-direction: column;
    flex-shrink: 0;
}

.almanac-card-today {
    border-color: rgb(219, 150, 86);
    background-color: var(--c-panel);
}

.almanac-card-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.almanac-card-date-box {
    flex-direction: row;
    align-items: center;
}

.almanac-card-date {
    font-size: 13px;
    -unity-font: var(--font-medium);
    color: rgb(235, 240, 250);
}

.almanac-card-offset {
    font-size: 11px;
    -unity-font: var(--font-medium);
    color: rgb(147, 161, 179);
    background-color: rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: var(--r);
    margin-left: 8px;
}

.almanac-card-astro-badge {
    font-size: 11px;
    -unity-font: var(--font-bold);
    color: rgb(255, 172, 95);
    background-color: rgba(255, 152, 55, 0.15);
    border-width: 1px;
    border-color: rgba(255, 152, 55, 0.4);
    padding: 2px 8px;
    border-radius: var(--r);
}

.almanac-card-sun-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.almanac-card-sun-text {
    font-size: 12px;
    color: rgb(147, 161, 179);
}

.almanac-card-weather-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.almanac-card-weather-left {
    flex-direction: row;
    align-items: center;
}

.almanac-weather-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    flex-shrink: 0;
}

.almanac-weather-name {
    font-size: 13px;
    -unity-font: var(--font-medium);
    color: white;
}

.almanac-conf-badge {
    font-size: 11px;
    -unity-font: var(--font-bold);
    padding: 3px 8px;
    border-radius: var(--r);
    -unity-text-align: middle-center;
}

.almanac-conf-current {
    background-color: rgba(52, 152, 219, 0.2);
    color: rgb(90, 185, 255);
    border-width: 1px;
    border-color: rgba(52, 152, 219, 0.4);
}

.almanac-conf-high {
    background-color: rgba(54, 196, 177, 0.2);
    color: rgb(88, 222, 204);
    border-width: 1px;
    border-color: rgba(54, 196, 177, 0.4);
}

.almanac-conf-med {
    background-color: rgba(244, 135, 33, 0.2);
    color: rgb(250, 167, 90);
    border-width: 1px;
    border-color: rgba(244, 135, 33, 0.4);
}

.almanac-conf-low {
    background-color: rgba(139, 150, 165, 0.2);
    color: rgb(147, 161, 179);
    border-width: 1px;
    border-color: rgba(139, 150, 165, 0.4);
}

.almanac-conf-season {
    background-color: rgba(155, 89, 182, 0.2);
    color: rgb(200, 150, 240);
    border-width: 1px;
    border-color: rgba(155, 89, 182, 0.4);
}

.almanac-weekly-note {
    font-size: 12px;
    color: rgb(147, 161, 179);
    margin-top: 6px;
    -unity-font-style: italic;
}

/* ── Temperature Pill ──────────────────────────────────────────────────── */
.almanac-card-temp-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 2px;
}

.almanac-card-temp-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(43, 52, 66, 0.75);
    border-radius: 10px;
    padding: 2px 10px;
    border-width: 1px;
    border-color: rgba(139, 150, 165, 0.6);
}

.almanac-temp-high {
    font-size: 13px;
    color: rgb(255, 172, 95);
    -unity-font-style: bold;
    margin-right: 8px;
}

.almanac-temp-low {
    font-size: 13px;
    color: rgb(100, 175, 240);
    -unity-font-style: bold;
}

