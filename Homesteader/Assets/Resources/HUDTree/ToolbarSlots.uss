/* ToolbarSlots.uss - 10 free-floating bordered slots.

   The .toolbar-slots container has NO background-color so the
   slots appear free-floating against the 3D scene. Each slot
   has a 2-px slate border; selected adds a 3-px amber border. */

.toolbar-slots {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 80px;
    align-self: center;
    margin-top: auto;
    margin-bottom: 32px;
}

.tool-slot {
    width: 80px;
    height: 80px;
    margin-left: 6px;
    margin-right: 6px;
    border-color: rgb(120, 136, 153);
    border-width: 2px;
    border-radius: 6px;
    flex-direction: column;
    align-items: center;
    padding: 0;
    flex-shrink: 0;
}

.tool-slot--selected {
    border-color: rgb(193, 154, 60);
    border-width: 3px;
}

.tool-slot-icon {
    width: 56px;
    height: 56px;
    margin-top: 4px;
    border-color: rgb(10, 14, 21);
    border-width: 1px;
    border-radius: 4px;
    background-color: rgb(60, 76, 92);
    flex-shrink: 0;
}

.tool-slot-count {
    color: rgb(241, 196, 15);
    font-size: 14px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    width: 72px;
    height: 16px;
    margin-top: 2px;
    white-space: nowrap;
}
