            <ui:VisualElement name="SettingsWindow" class="window window--hidden" style="width: 460px;">
                <ui:VisualElement class="window-header">
                    <ui:Label text="Settings" class="window-title" />
                    <ui:Button name="SettingsCloseBtn" text="✕" class="window-close-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="window-body">
                    <ui:Label text="Audio" class="window-section-title" />
                    <ui:Slider name="MasterVolumeSlider" label="Master Volume" low-value="0" high-value="100" value="80" class="window-slider" />
                    <ui:Slider name="MusicVolumeSlider" label="Music &amp; Ambience" low-value="0" high-value="100" value="65" class="window-slider" />

                    <ui:Label text="Display" class="window-section-title" />
                    <ui:Toggle name="FullscreenToggle" label="Fullscreen Mode" value="true" class="window-toggle" />
                    <ui:Toggle name="VsyncToggle" label="V-Sync (60 FPS)" value="true" class="window-toggle" />

                    <ui:VisualElement class="window-footer-row">
                        <ui:Button name="TestModalBtn" text="Test Confirm Dialog..." class="action-btn action-btn--secondary" />
                        <ui:Button name="SettingsApplyBtn" text="Apply &amp; Close" class="action-btn action-btn--primary" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

