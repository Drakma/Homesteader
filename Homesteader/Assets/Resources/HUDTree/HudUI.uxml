<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">
    <!--
      HudUI.uxml. HUD layout that matches the kit preview.

      Header (top, full width):
        Left: 4 horizontal vital chips (icon + bar) inline.
        Center: single line time label + 5 speed chips below.
        Right: 4 resource rows (icon + amount).
      Toolbar (bottom, centered horizontally):
        10 free floating slot tiles in one row.
      Bindings (HudBindings.cs) writes bar widths and labels.
    -->
    <ui:Template name="PhoneUI" src="PhoneUI.uxml" />
    <ui:Style src="HudUI.uss" />
    <ui:Style src="HudUI_kit.uss" />
    <ui:Style src="PhoneUI.uss" />
    <!-- REWRITE MARKER -->
    <ui:VisualElement name="ScreenRoot" class="screen-root" picking-mode="Ignore">

        <!-- Toast Notification Container (mounted directly below ScreenRoot so it sits underneath Header in rendering order) -->
        <ui:VisualElement name="ToastContainer" class="toast-container" picking-mode="Ignore" />

        <ui:VisualElement name="Header" class="header">

            <ui:VisualElement name="VitalsWell" class="vitals-well">
                <ui:VisualElement name="Vitals" class="vitals-row">
                    <ui:VisualElement name="VitalWellnessRow" class="vital-row">
                        <ui:VisualElement class="vital-icon vital-icon-vital-wellness">
                            <ui:VisualElement class="vital-icon-art" />
                        </ui:VisualElement>
                        <ui:VisualElement class="vital-meter">
                            <ui:VisualElement name="VitalWellnessFill" class="vital-meter-fill" />
                            <ui:VisualElement class="vital-meter-center" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="|" class="hud-sep" picking-mode="Ignore" />
                    <ui:VisualElement name="VitalStaminaRow" class="vital-row">
                        <ui:VisualElement class="vital-icon vital-icon-vital-stamina">
                            <ui:VisualElement class="vital-icon-art" />
                        </ui:VisualElement>
                        <ui:VisualElement class="vital-meter">
                            <ui:VisualElement name="VitalStaminaFill" class="vital-meter-fill" />
                            <ui:VisualElement class="vital-meter-center" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="|" class="hud-sep" picking-mode="Ignore" />
                    <ui:VisualElement name="VitalThirstRow" class="vital-row">
                        <ui:VisualElement class="vital-icon vital-icon-vital-thirst">
                            <ui:VisualElement class="vital-icon-art" />
                        </ui:VisualElement>
                        <ui:VisualElement class="vital-meter">
                            <ui:VisualElement name="VitalThirstFill" class="vital-meter-fill" />
                            <ui:VisualElement class="vital-meter-center" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="|" class="hud-sep" picking-mode="Ignore" />
                    <ui:VisualElement name="VitalHungerRow" class="vital-row">
                        <ui:VisualElement class="vital-icon vital-icon-vital-hunger">
                            <ui:VisualElement class="vital-icon-art" />
                        </ui:VisualElement>
                        <ui:VisualElement class="vital-meter">
                            <ui:VisualElement name="VitalHungerFill" class="vital-meter-fill" />
                            <ui:VisualElement class="vital-meter-center" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Real-time dynamic moving weather timeline anchored just to the right of the Vitals well -->
            <ui:VisualElement name="WeatherTimelineGroup" class="weather-timeline-group" picking-mode="Ignore">
                <!-- Wind direction and speed, attached to the left of the weather timeline (mirrors the temp cell on the right) -->
                <ui:VisualElement name="WindCell" class="wind-cell" picking-mode="Ignore">
                    <ui:VisualElement name="WindArrowHolder" class="wind-arrow-holder" picking-mode="Ignore" />
                    <ui:VisualElement class="wind-text-col" picking-mode="Ignore">
                        <ui:Label name="WindSpeedLabel" text="Calm" class="wind-speed-label" />
                        <ui:Label name="WindDirLabel" text="" class="wind-dir-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="WeatherTimelineWell" class="weather-timeline-well" picking-mode="Ignore">
                    <ui:VisualElement name="WeatherTimelineViewport" class="timeline-viewport" picking-mode="Ignore">
                        <ui:VisualElement name="WeatherTimelineTrack" class="timeline-track" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="timeline-center-reticle" picking-mode="Ignore">
                        <ui:VisualElement class="timeline-reticle-arrow" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="timeline-edge-fade-left" picking-mode="Ignore" />
                    <ui:VisualElement class="timeline-edge-fade-right" picking-mode="Ignore" />
                </ui:VisualElement>
                <!-- Attached offset cell showing the live current temperature -->
                <ui:VisualElement name="CurrentTempCell" class="current-temp-cell" picking-mode="Ignore">
                    <ui:Label name="CurrentTempLabel" text="72°ᶠ" class="current-temp-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="header-spacer" picking-mode="Ignore" />

            <!-- Centered Date & Time -->
            <ui:VisualElement name="TimeAndDateCell" class="time-speed-cell" picking-mode="Ignore">
                <ui:VisualElement name="TimeAndDate" class="time-and-date-inner" picking-mode="Ignore">
                    <ui:VisualElement name="TimeDisplayRow" class="time-display-row" picking-mode="Ignore">
                        <ui:Label name="TimeLineLabel" text="Winter  January 1  8:00" class="time-line-label" />
                    </ui:VisualElement>
                    <ui:Label name="SpeedStateLabel" text="1x" class="speed-state-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="header-spacer" picking-mode="Ignore" />

            <!-- Real-time dynamic moving celestial timeline (Sun & Moon phases) anchored just to the left of the Resources well -->
            <!-- Season tree icon attached to the left of the sun/moon timeline (mirrors the temp cell on the weather timeline) -->
            <ui:VisualElement name="CelestialTimelineGroup" class="celestial-timeline-group" picking-mode="Ignore">
                <ui:VisualElement name="SeasonCell" class="season-cell" picking-mode="Ignore">
                    <ui:VisualElement name="SeasonIcon" class="season-icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="TimelineWell" class="timeline-well" picking-mode="Ignore">
                    <ui:VisualElement name="TimelineViewport" class="timeline-viewport" picking-mode="Ignore">
                        <ui:VisualElement name="TimelineTrack" class="timeline-track" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="timeline-center-reticle" picking-mode="Ignore">
                        <ui:VisualElement class="timeline-reticle-arrow" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="timeline-edge-fade-left" picking-mode="Ignore" />
                    <ui:VisualElement class="timeline-edge-fade-right" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="ResourcesCell" class="resources-well">
                <ui:VisualElement name="ResourcesBar" class="resources-bar">
                    <ui:VisualElement class="resource-row">
                        <ui:VisualElement class="resource-icon resource-icon-water" />
                        <ui:Label name="ResourceWaterLabel" text="0 L"
                                  class="resource-amount" />
                    </ui:VisualElement>
                    <ui:Label text="|" class="hud-sep" picking-mode="Ignore" />
                    <ui:VisualElement class="resource-row">
                        <ui:VisualElement class="resource-icon resource-icon-electricity" />
                        <ui:Label name="ResourceElectricityLabel" text="0.00 MJ"
                                  class="resource-amount" />
                    </ui:VisualElement>
                    <ui:Label text="|" class="hud-sep" picking-mode="Ignore" />
                    <ui:VisualElement class="resource-row">
                        <ui:VisualElement class="resource-icon resource-icon-bandwidth" />
                        <ui:Label name="ResourceBandwidthLabel" text="0 Mbps"
                                  class="resource-amount" />
                    </ui:VisualElement>
                    <ui:Label text="|" class="hud-sep" picking-mode="Ignore" />
                    <ui:VisualElement class="resource-row">
                        <ui:VisualElement class="resource-icon resource-icon-fuel" />
                        <ui:Label name="ResourceFuelLabel" text="0 L"
                                  class="resource-amount" />
                    </ui:VisualElement>
                    <ui:Label text="|" class="hud-sep" picking-mode="Ignore" />
                    <ui:VisualElement class="resource-row">
                        <ui:VisualElement class="resource-icon resource-icon-money" />
                        <ui:Label name="ResourceMoneyLabel" text="0"
                                  class="resource-amount" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

            <!-- Toolbar: absolutely positioned at bottom center -->
        <ui:VisualElement name="ToolbarSlots" class="toolbar-slots">
            <ui:VisualElement name="ToolbarSlot0" class="tool-slot tool-slot--selected">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="1" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel0" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ToolbarSlot1" class="tool-slot">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="2" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel1" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ToolbarSlot2" class="tool-slot">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="3" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel2" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ToolbarSlot3" class="tool-slot">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="4" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel3" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ToolbarSlot4" class="tool-slot">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="5" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel4" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ToolbarSlot5" class="tool-slot">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="6" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel5" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ToolbarSlot6" class="tool-slot">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="7" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel6" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ToolbarSlot7" class="tool-slot">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="8" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel7" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ToolbarSlot8" class="tool-slot">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="9" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel8" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ToolbarSlot9" class="tool-slot">
                <ui:VisualElement class="tool-slot-icon" picking-mode="Ignore" />
                <ui:Label text="0" class="tool-slot-num" picking-mode="Ignore" />
                <ui:Label name="ToolSlotLabel9" class="tool-slot-count" />
                <ui:VisualElement class="tool-slot-underline" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The phone lives in PhoneUI.uxml (the only phone); styles in PhoneUI.uss. -->
        <ui:Instance template="PhoneUI" name="PhoneHost" class="phone-host" picking-mode="Ignore" />

        <!-- Window & Modal Shade Overlay -->
        <ui:VisualElement name="WindowShade" class="window-shade window-shade--hidden">
            <!-- Confirm Modal Example -->
            <ui:VisualElement name="ConfirmModal" class="modal modal--hidden" style="width: 440px;">
                <ui:VisualElement class="window-header">
                    <ui:Label name="ModalTitle" text="Confirm Action" class="window-title" />
                    <ui:Button name="ModalCloseBtn" text="✕" class="window-close-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-body">
                    <ui:Label name="ModalMessage" text="Are you sure you want to discard unsaved homestead changes?" class="modal-text" />
                    <ui:VisualElement class="modal-button-row">
                        <ui:Button name="ModalCancelBtn" text="Cancel" class="action-btn action-btn--secondary" />
                        <ui:Button name="ModalThirdBtn" text="" class="action-btn action-btn--secondary" style="display: none;" />
                        <ui:Button name="ModalConfirmBtn" text="Confirm" class="action-btn action-btn--primary" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================== -->
        <!-- ASSET SPAWNER WINDOW (OPENED VIA ADMIN APP)    -->
        <!-- ============================================== -->
        <ui:VisualElement name="AssetSpawnerWindow" class="window asset-spawner-window asset-spawner-window--hidden">
            <ui:VisualElement class="window-header">
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label text="📦 Asset Spawner • Item Catalog" class="window-title" />
                    <ui:Label name="AssetSpawnerCountBadge" text="544 items" class="asset-spawner-count-badge" />
                </ui:VisualElement>
                <ui:Button name="AssetSpawnerCloseBtn" text="✕" class="window-close-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="asset-spawner-body">
                <!-- Category Dropdown, Search & Shortcut Hint Row -->
                <ui:VisualElement class="asset-search-row">
                    <ui:DropdownField name="AssetCategoryDropdown" class="asset-category-dropdown" />
                    <ui:TextField name="AssetSearchInput" placeholder-text="Search assets by name or ID..." class="asset-search-input" />
                    <ui:Label text="Click: +1  •  Shift+Click: Full Stack" class="asset-shortcut-hint" />
                </ui:VisualElement>

                <!-- Asset Grid ScrollView -->
                <ui:ScrollView name="AssetGridScroll" mode="Vertical" class="asset-grid-scroll" mouse-wheel-scroll-size="48">
                    <ui:VisualElement name="AssetGridContainer" class="asset-grid-container" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement class="window-status-bar">
                <ui:Label name="AssetSpawnerStatusLabel" text="" class="window-status-label" />
                <ui:VisualElement name="AssetSpawnerResizeHandle" class="window-resize-handle" tooltip="Drag to resize">
                    <ui:VisualElement class="resize-dot-row" picking-mode="Ignore">
                        <ui:VisualElement class="resize-dot" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="resize-dot-row" picking-mode="Ignore">
                        <ui:VisualElement class="resize-dot" picking-mode="Ignore" />
                        <ui:VisualElement class="resize-dot" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="resize-dot-row" picking-mode="Ignore">
                        <ui:VisualElement class="resize-dot" picking-mode="Ignore" />
                        <ui:VisualElement class="resize-dot" picking-mode="Ignore" />
                        <ui:VisualElement class="resize-dot" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================== -->
        <!-- STATISTICS WINDOW (F12 DEBUG OVERLAY)          -->
        <!-- ============================================== -->
        <ui:VisualElement name="StatsWindow" class="window stats-window stats-window--hidden">
            <ui:VisualElement class="window-header">
                <ui:Label text="STATISTICS" class="window-title" />
                <ui:Button name="StatsCloseBtn" text="✕" class="window-close-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="window-body stats-body">
                <ui:Label name="StatsFpsLabel" text="—" class="stats-line" />
                <ui:Label name="StatsZoomLabel" text="—" class="stats-line" />
                <ui:Label name="StatsGridLabel" text="—" class="stats-line" />
                <ui:Label name="StatsRamLabel" text="—" class="stats-line" />
                <ui:Label name="StatsVramLabel" text="—" class="stats-line" />
                <ui:Label name="StatsDrawLabel" text="—" class="stats-line" />
                <ui:Label name="StatsTrisLabel" text="—" class="stats-line" />
                <ui:Label name="StatsScreenLabel" text="—" class="stats-line" />
                <ui:Label name="StatsCpuLabel" text="—" class="stats-line" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
