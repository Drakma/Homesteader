/* HudUI.uss - layout for the in-game HUD.

   The HUD is a full-screen overlay built per
   assets/hud_kit/preview/preview_hud_full.png:

     .screen-root (column flex, transparent so the 3D shows)
       - .header (top, full width, dark slate band with amber
         bottom highlight). Inside is a row:
         - .vitals-well 4 horizontal chip (icon+bar) pairs
         - .time-speed-cell (single-line time + 5 speed chips below)
         - .resources-well (4 stacked icon+amount rows)
       - .toolbar (bottom, centered column flex; 10 slot tiles)

   The header is the only place with a non-transparent
   background; the toolbar is intentionally free-floating. */

:root {
    --font: resource("HUDTree/Fonts/HomesteaderHUD");
    --font-bold: resource("HUDTree/Fonts/HomesteaderHUD_Bold");
    --font-medium: resource("HUDTree/Fonts/HomesteaderHUD_Medium");
    --font-italic: resource("HUDTree/Fonts/HomesteaderHUD_Italic");
    --font-bold-italic: resource("HUDTree/Fonts/HomesteaderHUD_BoldItalic");
    width: 100%;
    height: 100%;
}

TemplateContainer {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(18, 22, 29, 0);
}

/* ----- HEADER BAND -----
   The kit's header_strip.png is a pre-baked 1920x64 metallic strip
   with a top-to-bottom gradient + faint noise + amber bottom line.
   Using it as the .header background-image gives us the exact
   preview chrome without any shader. */

.header {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 64px;
    padding: 0 16px;
    background-color: rgb(43, 52, 66);
    border-bottom-color: rgb(224, 138, 60);
    border-bottom-width: 2px;
    position: relative;
}

.header-spacer {
    flex-grow: 1;
    flex-shrink: 1;
}

.vitals-well {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    height: 38px;
    max-height: 38px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 0;
    padding-right: 0;
    margin-right: 12px;
    border-width: 0;
}

.vitals-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    flex-shrink: 0;
}

.vital-row {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin-right: 0;
    flex-shrink: 0;
}

.vital-icon {
    width: 22px;
    height: 22px;
    margin-right: 3px;
    flex-shrink: 0;
    background-color: rgba(18, 22, 29, 0);
    align-items: center;
    justify-content: center;
}

/* Icon CONTENTS are 22x22 inside the element - drawn from the kit atlas */

.vital-icon > .vital-icon-art {
    width: 22px;
    height: 22px;
    flex-grow: 0;
    flex-shrink: 0;
}

/* No background-color tints - the kit atlas art supplies the icon look. */

/* Meter: pill-shaped track with dark slate empty background.
   The bar fill (.vital-meter-fill) represents signed values from -100 to +100
   with 0 centered in the middle (40px). Default is 0.
   The pill container has overflow: hidden so fill bars naturally clip to the pill. */

.vital-meter {
    width: 73px;
    height: 16px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 0;
    overflow: hidden;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(58, 70, 88);
    position: relative;
}

.vital-meter-fill {
    height: 16px;
    width: 0;
    position: absolute;
    left: 37px;
    top: 0;
    bottom: 0;
    border-radius: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.vital-meter-fill--pos {
    background-image: resource("HUDTree/Atlases/vital_fill_positive");
}

.vital-meter-fill--neg {
    background-image: resource("HUDTree/Atlases/vital_fill_negative");
}

.vital-meter-center {
    width: 1px;
    height: 16px;
    position: absolute;
    left: 36.5px;
    top: 0;
    background-color: rgb(238, 242, 246);
    opacity: 0.5;
}

/* ----- TIME + SPEED CELL -----
   Center top: season/day/time aligned to top-center with 3px padding on top.
   The speed pill evenly fills the remaining space between the bottom of
   the time label and the bottom of the header. */
.time-speed-cell {
    position: absolute;
    left: 50%;
    width: 220px;
    margin-left: -110px;
    top: 0;
    bottom: 0;
    height: 100%;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-self: center;
}

.time-and-date-inner {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: auto;
    width: auto;
}

.time-display-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: auto;
    margin: 0;
    padding: 0;
}

.time-line-label {
    color: rgb(238, 242, 246);
    font-size: 24px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    height: auto;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.speed-state-label {
    color: rgb(255, 164, 79);
    font-size: 11px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    height: auto;
    margin-top: 2px;
    padding: 0;
    white-space: nowrap;
    letter-spacing: 0.5px;
}

.weather-icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.celestial-icon {
    width: 30px;
    height: 30px;
    margin-left: 8px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

/* The speed chip pill is a 3D-inset rounded box that sits evenly centered
   between the bottom of the time label and the bottom of the header. */

.speed-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center;
    margin-top: auto;
    margin-bottom: auto;
    height: 24px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 10px;
    padding-right: 10px;
    background-image: resource("HUDTree/Atlases/well");
    -unity-background-scale-mode: stretch-to-fill;
    border-radius: 12px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(18, 22, 29);
    border-bottom-color: rgb(92, 102, 117);
    border-left-color: rgb(43, 52, 66);
    border-right-color: rgb(43, 52, 66);
    width: auto;
}

.speed-chip {
    width: 12px;
    height: 16px;
    margin-left: 3px;
    margin-right: 3px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(18, 22, 29, 0);
    color: rgba(18, 22, 29, 0);
    font-size: 8px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-background-scale-mode: scale-to-fit;
    padding: 0;
}

.speed-chip:hover {
    background-color: rgba(255, 183, 115, 0.15);
}

.speed-chip:checked,
.speed-chip--active {
    background-color: rgb(224, 138, 60);
}

/* ----- RESOURCES WELL -----
   Right side of header: 4 stacked icon+amount rows. */
.resources-well {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    height: 38px;
    max-height: 38px;
    margin-left: 12px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 0;
    padding-right: 0;
    border-width: 0;
}

.resources-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    height: 32px;
}

.resource-row {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin-right: 0;
    flex-shrink: 0;
}

.resource-icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    flex-shrink: 0;
    background-color: rgba(18, 22, 29, 0);
}

/* No background-color tints - the kit atlas art supplies the icon look. */

.resource-amount {
    color: rgb(238, 242, 246);
    font-size: 18px;
    -unity-font: var(--font);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* ----- TOOLBAR -----
   Bottom-center, transparent container of 10 slot tiles.
   Anchored with absolute positioning to the bottom of the viewport
   with 3 px padding from the bottom edge. */

.toolbar-slots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    top: auto;
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center;
    background-color: rgba(18, 22, 29, 0);
}

.tool-slot {
    position: relative;
    width: 56px;
    height: 56px;
    margin-left: 3px;
    margin-right: 3px;
    flex-shrink: 0;
    border-radius: 0;
    overflow: visible;
}

.tool-slot--selected {
    border-width: 2px;
}

.tool-slot-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 36px;
    height: 36px;
    margin-left: -18px;
    margin-top: -18px;
    -unity-background-scale-mode: scale-to-fit;
}

.tool-slot-num {
    position: absolute;
    top: 1px;
    left: 3px;
    font-size: 10px;
    -unity-font: var(--font-bold);
    color: rgb(92, 102, 117);
    -unity-text-align: upper-left;
    padding: 0;
    margin: 0;
}

.tool-slot--selected .tool-slot-num {
    color: rgb(224, 138, 60);
}

.tool-slot-count {
    position: absolute;
    right: 3px;
    bottom: 1px;
    color: rgb(238, 242, 246);
    font-size: 11px;
    -unity-font: var(--font-bold);
    -unity-text-align: lower-right;
    padding: 0;
    margin: 0;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(18, 22, 29, 0.95);
}

/* Copper bar under the active slot. */
.tool-slot-underline {
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: -8px;
    height: 2px;
    background-color: rgb(224, 138, 60);
    display: none;
}

.tool-slot--selected .tool-slot-underline {
    display: flex;
}

/* ----- HEADER SETTINGS BUTTON ----- */

.header-settings-btn {
    display: none; /* gear icon removed; Esc / O still opens Settings */
    width: 32px;
    height: 32px;
    margin-left: 8px;
    align-self: center;
    background-color: rgba(43, 52, 66, 0.7);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    border-radius: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.header-settings-btn:hover {
    background-color: rgba(61, 74, 92, 0.95);
    border-color: rgb(224, 138, 60);
}

.header-settings-icon {
    color: rgb(238, 242, 246);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* ----- WINDOW & MODAL SYSTEM ----- */

.window-shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(18, 22, 29, 0.75);
    align-items: center;
    justify-content: center;
}

.window-shade--hidden {
    display: none;
}

.window {
    background-color: rgb(43, 52, 66);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(18, 22, 29);
    border-top-color: rgb(92, 102, 117);
    overflow: hidden;
    flex-direction: column;
}

.window--hidden {
    display: none;
}

.modal {
    background-color: rgb(43, 52, 66);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(18, 22, 29);
    border-top-color: rgb(92, 102, 117);
    overflow: hidden;
    flex-direction: column;
}

.modal--hidden {
    display: none;
}

.window-header {
    height: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 8px;
    background-color: rgb(26, 33, 43);
    border-bottom-width: 1px;
    border-bottom-color: rgb(61, 74, 92);
    flex-shrink: 0;
}

.window-title {
    color: rgb(224, 138, 60);
    font-size: 15px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-left;
    letter-spacing: 0.5px;
}

.window-close-btn {
    width: 22px;
    height: 22px;
    background-color: rgba(18, 22, 29, 0);
    border-width: 1px;
    border-color: rgba(227, 83, 88, 0.4);
    border-radius: 0;
    color: rgb(228, 92, 96);
    font-size: 14px;
    -unity-text-align: middle-center;
    padding: 0;
}

.window-close-btn:hover {
    background-color: rgb(198, 32, 38);
    color: rgb(255, 255, 255);
    border-color: rgb(224, 66, 71);
}

.window-body {
    padding: 16px;
    flex-direction: column;
}

.window-section-title {
    color: rgb(224, 138, 60);
    font-size: 13px;
    -unity-font: var(--font-bold);
    margin-top: 6px;
    margin-bottom: 8px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(43, 52, 66);
}

.window-slider {
    margin-bottom: 10px;
}

.window-slider .unity-slider__label {
    color: rgb(238, 242, 246);
    font-size: 13px;
    -unity-font: var(--font-medium);
    min-width: 150px;
}

.window-slider .unity-base-slider__tracker {
    height: 6px;
    background-color: rgb(26, 33, 43);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(18, 22, 29);
}

.window-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    margin-top: -4px;
    border-radius: 0;
    background-color: rgb(224, 138, 60);
    border-width: 1px;
    border-color: rgb(241, 170, 104);
}

.window-toggle {
    margin-bottom: 10px;
}

.window-toggle .unity-toggle__label {
    color: rgb(238, 242, 246);
    font-size: 13px;
    -unity-font: var(--font-medium);
    min-width: 150px;
}

.window-toggle .unity-toggle__checkmark {
    width: 18px;
    height: 18px;
    border-radius: 0;
    background-color: rgb(26, 33, 43);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
}

.window-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(224, 138, 60);
    -unity-background-image-tint-color: rgb(18, 22, 29);
}

.window-footer-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 14px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgb(43, 52, 66);
}

.modal-body {
    padding: 24px 28px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.modal-text {
    color: rgb(238, 242, 246);
    font-size: 15px;
    -unity-font: var(--font);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    white-space: normal;
}

.modal-button-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Action buttons */

.action-btn {
    min-width: 90px;
    height: 30px;
    padding-left: 14px;
    padding-right: 14px;
    margin-left: 6px;
    margin-right: 6px;
    border-radius: 0;
    border-width: 1px;
    font-size: 13px;
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
}

.action-btn--primary {
    background-color: rgb(224, 138, 60);
    color: rgb(18, 22, 29);
    border-color: rgb(232, 163, 98);
}

.action-btn--primary:hover {
    background-color: rgb(222, 153, 88);
}

.action-btn--primary:active {
    background-color: rgb(188, 112, 40);
}

.action-btn--secondary {
    background-color: rgb(43, 52, 66);
    color: rgb(238, 242, 246);
    border-color: rgb(61, 74, 92);
}

.action-btn--secondary:hover {
    background-color: rgb(61, 74, 92);
}

.action-btn--secondary:active {
    background-color: rgb(43, 52, 66);
}

/* =========================================================================
   TOAST NOTIFICATION CONTAINER & CARDS
   Drops down from behind the header band with stacking animation.
   ========================================================================= */

.toast-container {
    position: absolute;
    top: 64px; /* Directly behind/below the 64px header band */
    left: 0;
    right: 0;
    align-items: center;
    justify-content: flex-start;
    flex-direction: column;
    padding-top: 8px;
    pointer-events: none;
    overflow: visible;
}

.toast-item {
    pointer-events: auto;
    flex-direction: row;
    align-items: center;
    min-width: 320px;
    max-width: 580px;
    margin-bottom: 8px;
    padding: 8px 16px 8px 12px;
    border-radius: 0;
    border-width: 1px;
    background-color: rgba(26, 33, 43, 0.95);
    border-color: rgba(224, 138, 60, 0.45);
    box-shadow: 0 4px 12px rgba(18, 22, 29, 0.6);
    /* Transition styles for smooth dropdown animation */
    transition-property: translate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
    opacity: 1;
    translate: 0 0;
}

/* Initial state when spawning behind header */
.toast-item--entering {
    opacity: 0;
    translate: 0 -36px;
}

/* Exit state when fading out */
.toast-item--exiting {
    opacity: 0;
    translate: 0 -16px;
}

/* Icon / Glyph */
.toast-icon {
    font-size: 20px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* Content Column */
.toast-content {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
}

.toast-title {
    color: rgb(237, 171, 109);
    font-size: 13px;
    -unity-font: var(--font-bold);
    letter-spacing: 0.5px;
    margin-bottom: 2px;
}

.toast-message {
    color: rgb(238, 242, 246);
    font-size: 13px;
    -unity-font: var(--font);
    white-space: normal;
    line-height: 16px;
}

/* Toast Type Variants */
.toast-item--info {
    border-left-width: 4px;
    border-left-color: rgb(85, 160, 245);
}

.toast-item--success {
    border-left-width: 4px;
    border-left-color: rgb(81, 204, 188);
}

.toast-item--warning {
    border-left-width: 4px;
    border-left-color: rgb(246, 157, 75);
}

.toast-item--error {
    border-left-width: 4px;
    border-left-color: rgb(240, 85, 90);
}

/* =========================================================================
   REAL-TIME HORIZONTAL TIMELINE TAPE
   Displays a dynamic moving celestial sun/moon ruler centered on current time.
   ========================================================================= */

.timeline-well {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center; /* Vertically centered in the 64px header band */
    width: 200px;
    height: 36px;
    max-height: 36px;
    position: relative;
    padding: 0 4px;
    background-color: rgb(58, 70, 88);
    border-width: 0;
    overflow: hidden;
}

/* Outer viewport masking the moving timeline track */
.timeline-viewport {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
}

/* The moving track containing ticks and 4-hour interval nodes */
.timeline-track {
    position: absolute;
    top: 0;
    bottom: 0;
    height: 100%;
    flex-direction: row;
    align-items: center;
    /* translate.x is driven in real-time each frame by HudBindings */
}

/* 4-hour major block containing celestial icon, 1 major tick, and 3 intermediate hourly ticks */
.timeline-major-node {
    width: 100px; /* 100px per 4-hour block (25px per hour) */
    height: 100%;
    align-items: center;
    justify-content: center;
    position: relative;
}

/* Celestial icon (Sun & Moon phase icons) positioned clearly above the ticks */
.timeline-celestial-icon {
    width: 30px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
    margin: 0;
}

/* Major tick dot on 4-hour intervals (12a, 4a, 8a, 12p, 4p, 8p) vertically centered */
.timeline-tick-major {
    position: absolute;
    left: 0;
    top: 50%;
    margin-top: -3px;
    margin-left: -3px;
    width: 6px;
    height: 6px;
    background-color: rgba(241, 168, 99, 0.90);
    border-radius: 0;
}

/* Intermediate 1-hour minor tick dots (+1h, +2h, +3h) vertically centered */
.timeline-tick-hour1 {
    position: absolute;
    left: 25px; /* +1 hour */
    top: 50%;
    margin-top: -2px;
    margin-left: -2px;
    width: 4px;
    height: 4px;
    background-color: rgba(238, 242, 246, 0.55);
    border-radius: 0;
}

.timeline-tick-hour2 {
    position: absolute;
    left: 50px; /* +2 hours (halfway) */
    top: 50%;
    margin-top: -2px;
    margin-left: -2px;
    width: 4px;
    height: 4px;
    background-color: rgba(200, 220, 245, 0.70);
    border-radius: 0;
}

.timeline-tick-hour3 {
    position: absolute;
    left: 75px; /* +3 hours */
    top: 50%;
    margin-top: -2px;
    margin-left: -2px;
    width: 4px;
    height: 4px;
    background-color: rgba(238, 242, 246, 0.55);
    border-radius: 0;
}

/* Fixed Center Reticle / Indicator: Needle pointing to current time in the middle */
.timeline-center-reticle {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background-color: rgb(246, 160, 80);
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
}

/* Top downward indicator arrow */
.timeline-reticle-arrow {
    width: 8px;
    height: 6px;
    margin-left: -3px;
    background-color: rgb(246, 160, 80);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

/* Subtle edge vignette / shadow over left and right ends of the timeline well */
.timeline-edge-fade-left {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 28px;
    background-color: rgba(18, 22, 29, 0.85);
    pointer-events: none;
}

.timeline-edge-fade-right {
    display: none;
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 28px;
    background-color: rgba(18, 22, 29, 0.85);
    pointer-events: none;
}

/* =========================================================================
   REAL-TIME HORIZONTAL WEATHER TIMELINE TAPE
   Anchored to the right of the vitals well, displays moving weather icons + temp cell.
   ========================================================================= */

.weather-timeline-group {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    align-self: center; /* Vertically centered in the 64px header band */
    position: absolute;
    right: 50%;
    margin-right: 118px; /* just left of the fixed-width clock */
    top: 13px;
    height: 36px;
    max-height: 36px;
}

.weather-timeline-well {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 200px;
    height: 36px;
    max-height: 36px;
    padding: 0 4px;
    background-color: rgb(58, 70, 88);
    border-width: 0;
    position: relative;
    overflow: hidden;
}

/* Offset cell attached to the right of the weather timeline displaying current temp */
.current-temp-cell {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 36px;
    max-height: 36px;
    min-width: 44px;
    margin-left: 4px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgb(58, 70, 88);
    border-width: 0;
}

.current-temp-label {
    font-size: 19px;
    color: rgb(246, 175, 109);
    -unity-font: var(--font-bold);
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.weather-major-node {
    width: 100px; /* 100px per 4-hour block */
    height: 100%;
    align-items: center;
    justify-content: center;
    position: relative;
}

.weather-timeline-icon {
    width: 30px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
    margin: 0;
}

.toast-item--severe {
    border-left-width: 5px;
    border-left-color: rgb(255, 60, 66);
    border-color: rgba(255, 70, 76, 0.7);
    background-color: rgba(32, 16, 20, 0.96);
}

/* ----- ASSET SPAWNER WINDOW & CONTROLS ----- */
.admin-header-assets-btn {
    height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 11px;
    -unity-font: var(--font-bold);
    color: rgb(255, 255, 255);
    background-color: rgb(38, 133, 120);
    border-color: rgb(56, 195, 176);
    border-width: 1px;
    border-radius: 0;
    margin-right: 8px;
}

.admin-header-assets-btn:hover {
    background-color: rgb(45, 153, 139);
    border-color: rgb(114, 214, 201);
}

.asset-spawner-window {
    position: absolute;
    left: 50%;
    top: 50px;
    translate: -50% 0;
    width: 760px;
    height: 620px;
    background-color: rgb(26, 33, 43);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    border-top-color: rgb(224, 138, 60);
    border-radius: 0;
    overflow: hidden;
}

.window-status-bar {
    height: 22px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 4px;
    background-color: rgb(26, 33, 43);
    border-top-width: 1px;
    border-top-color: rgb(61, 74, 92);
}

.window-status-label {
    font-size: 10px;
    color: rgb(139, 150, 165);
    -unity-font: var(--font-medium);
    -unity-text-align: middle-left;
}

/* Dotted right-triangle grip: right angle at bottom-right */
.window-resize-handle {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 2px;
}

.resize-dot-row {
    flex-direction: row;
    justify-content: flex-end;
}

.resize-dot {
    width: 2px;
    height: 2px;
    margin: 1px;
    border-radius: 0;
    background-color: rgb(139, 150, 165);
}

.window-resize-handle:hover .resize-dot {
    background-color: rgb(224, 138, 60);
}

.asset-spawner-window--hidden {
    display: none;
}

/* ============================================== */
/* STATISTICS WINDOW (F12 debug overlay)           */
/* ============================================== */
.stats-window {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 280px;
    background-color: rgb(26, 33, 43);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    border-top-color: rgb(224, 138, 60);
    border-radius: 0;
    overflow: hidden;
}

.stats-window--hidden {
    display: none;
}

.stats-body {
    padding: 12px 14px;
}

.stats-line {
    font-size: 12px;
    color: rgb(220, 230, 245);
    -unity-font: var(--font-medium);
    -unity-text-align: middle-left;
    margin-bottom: 3px;
    white-space: nowrap;
}

.asset-spawner-count-badge {
    margin-left: 10px;
    font-size: 11px;
    color: rgb(224, 138, 60);
    background-color: rgb(43, 52, 66);
    padding: 2px 6px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(61, 74, 92);
}

.asset-spawner-body {
    flex-grow: 1;
    padding: 10px;
    flex-direction: column;
}

.asset-category-dropdown {
    width: 170px;
    height: 30px;
    flex-shrink: 0;
    margin: 0 8px 0 0;
}

.asset-category-dropdown > .unity-base-popup-field__input {
    height: 100%;
    margin: 0;
    padding-left: 8px;
    background-color: rgb(43, 52, 66);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    border-radius: 0;
    color: rgb(225, 235, 245);
    font-size: 12px;
    -unity-font: var(--font-medium);
    -unity-text-align: middle-left;
    align-items: center;
}

.asset-category-dropdown .unity-base-popup-field__text {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.asset-category-dropdown > .unity-base-popup-field__input:hover {
    border-color: rgb(224, 138, 60);
}

/* Dropdown popup (rendered by Unity at the panel root, so styled globally) */
.unity-base-dropdown__container-outer {
    background-color: rgb(26, 33, 43);
    border-width: 1px;
    border-color: rgb(224, 138, 60);
    border-radius: 0;
    padding: 2px;
    min-width: 170px;
}

.unity-base-dropdown__container-inner {
    background-color: rgb(26, 33, 43);
}

.unity-base-dropdown__item {
    flex-direction: row;
    align-items: center;
    height: 26px;
    min-height: 26px;
    padding: 0 8px;
    background-color: rgba(18, 22, 29, 0);
}

.unity-base-dropdown__item:hover {
    background-color: rgb(61, 74, 92);
}

.unity-base-dropdown__item:checked {
    background-color: rgb(224, 138, 60);
}

.unity-base-dropdown__label {
    flex-grow: 1;
    font-size: 12px;
    -unity-font: var(--font-medium);
    color: rgb(225, 235, 245);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.unity-base-dropdown__item:checked .unity-base-dropdown__label {
    color: rgb(26, 33, 43);
}

.asset-category-chip {
    height: 28px;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 6px;
    font-size: 11px;
    -unity-font: var(--font-medium);
    color: rgb(147, 161, 179);
    background-color: rgb(43, 52, 66);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    border-radius: 0;
    -unity-text-align: middle-center;
}

.asset-category-chip:hover {
    background-color: rgb(61, 74, 92);
    border-color: rgb(92, 102, 117);
    color: rgb(230, 240, 250);
}

.asset-category-chip--active {
    background-color: rgb(224, 138, 60);
    border-color: rgb(237, 163, 94);
    color: rgb(26, 33, 43);
    -unity-font: var(--font-bold);
}

.asset-search-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    height: 32px;
}

.asset-search-input {
    flex-grow: 1;
    margin-right: 12px;
    height: 30px;
    background-color: rgb(26, 33, 43);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    border-radius: 0;
    padding-left: 8px;
    color: rgb(225, 235, 245);
    font-size: 12px;
}

.asset-search-input {
    align-items: stretch;
}

.asset-search-input > .unity-text-field__input,
.asset-search-input > .unity-base-text-field__input {
    flex-grow: 1;
    align-self: stretch;
    justify-content: center;
    height: 100%;
    margin: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(18, 22, 29, 0);
    border-width: 0;
    -unity-text-align: middle-left;
}

.asset-search-input TextElement,
.asset-search-input .unity-base-text-field__placeholder {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.asset-shortcut-hint {
    font-size: 11px;
    color: rgb(242, 132, 29);
    -unity-font: var(--font-bold);
    white-space: nowrap;
    padding: 4px 8px;
    background-color: rgb(43, 52, 66);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(61, 74, 92);
}

.asset-grid-scroll {
    flex-grow: 1;
}

.asset-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 4px;
}

.asset-tile {
    width: 100px;
    height: 120px;
    margin: 3px;
    background-color: rgb(43, 52, 66);
    border-width: 1px;
    border-color: rgb(61, 74, 92);
    border-radius: 0;
    align-items: center;
    justify-content: flex-start;
    padding-top: 5px;
    position: relative;
    cursor: link;
}

.asset-tile:hover {
    border-color: rgb(224, 138, 60);
    background-color: rgb(61, 74, 92);
}

.asset-tile-icon {
    width: 76px;
    height: 76px;
    -unity-background-scale-mode: scale-to-fit;
}

.asset-tile-name {
    font-size: 9px;
    color: rgb(238, 242, 246);
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 24px;
    margin-top: 3px;
    padding-left: 2px;
    padding-right: 2px;
}

.asset-tile-badge {
    position: absolute;
    top: 2px;
    right: 3px;
    font-size: 9px;
    -unity-font: var(--font-bold);
    color: rgb(242, 132, 29);
    background-color: rgba(26, 33, 43, 0.85);
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 0;
}

/* ----- PHONE WRAPPER ----- */
/* Absolutely positioned bottom-right, above toolbar */
.phone-wrapper {
    position: absolute;
    right: 24px;
    bottom: 100px;
    width: auto;
    height: auto;
}

.phone-wrapper--hidden {
    display: none;
}

/* Precision UI: hairline copper accent edge on the main HUD panels. */
.window {
    border-left-width: 2px;
    border-left-color: rgb(224, 138, 60);
}

/* "|" dividers between vitals / resources (wells removed). */
.hud-sep {
    color: rgb(92, 102, 117);
    font-size: 20px;
    -unity-font: var(--font);
    -unity-text-align: middle-center;
    margin-left: 0;
    margin-right: 0;
    padding: 0 8px;
    flex-shrink: 0;
}

/* Season tree icon + sun/moon timeline, anchored just right of the clock. */
.celestial-timeline-group {
    position: absolute;
    left: 50%;
    margin-left: 118px;
    top: 13px;
    flex-direction: row;
    align-items: center;
    height: 36px;
    max-height: 36px;
}

.season-cell {
    flex-grow: 0;
    flex-shrink: 0;
    width: 44px;
    height: 36px;
    margin-right: 4px;
    align-items: center;
    justify-content: center;
    background-color: rgb(58, 70, 88);
}

.season-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}
