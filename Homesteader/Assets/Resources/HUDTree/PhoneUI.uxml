<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">
    <!--
      PhoneUI.uxml - THE PHONE. This is the only phone in the game: HudUI.uxml instantiates it
      (<ui:Instance template="PhoneUI" />) and PhoneController.cs drives it. Its styles are PhoneUI.uss.
      Edit the phone here and in PhoneUI.uss; there is no other phone markup anywhere.
    -->
    <ui:Style src="HudUI.uss" />
    <ui:Style src="PhoneUI.uss" />

    <!-- Phone: absolutely positioned center-right -->
    <ui:VisualElement name="PhoneWrapper" class="phone-wrapper phone-wrapper--hidden">
        <ui:VisualElement class="phone-chassis">
            <ui:VisualElement class="phone-screen">

                <!-- Top Notch / Speaker -->
                <ui:VisualElement class="phone-notch-bar">
                    <ui:VisualElement class="phone-speaker-pill" />
                </ui:VisualElement>

                <!-- Phone Status Bar -->
                <ui:VisualElement class="phone-status-bar">
                    <ui:VisualElement class="phone-status-time-row">
                        <ui:Label name="PhoneClock" text="08:00" class="phone-status-time" />
                        <ui:VisualElement name="PhoneCelestialIcon" class="phone-celestial-icon" />
                    </ui:VisualElement>
                    <ui:VisualElement class="phone-status-icons">
                        <ui:Label text="5G" class="phone-status-icon" />
                        <ui:VisualElement class="phone-battery-pill">
                            <ui:VisualElement name="PhoneBatteryFill" class="phone-battery-fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Phone Main Content Area -->
                <ui:VisualElement class="phone-content">

                    <!-- HOME SCREEN / APP LAUNCHER -->
                    <ui:VisualElement name="PhoneHome" class="phone-home">
                        <ui:VisualElement class="phone-widget-weather">
                            <ui:VisualElement>
                                <ui:Label name="PhoneWeatherTemp" text="72°F" class="phone-weather-temp" />
                                <ui:Label name="PhoneWeatherDesc" text="Summer • Day 42 • Sunny" class="phone-weather-info" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Paginated App Launcher Viewport with Swiping -->
                        <ui:VisualElement name="PhoneLauncherViewport" class="phone-launcher-viewport">
                            <ui:VisualElement name="PhoneLauncherTrack" class="phone-launcher-track">

                                <!-- Page 1: 3 x 4 = 12 apps -->
                                <ui:VisualElement class="phone-launcher-page">
                                    <!-- 1. Grid OS -->
                                    <ui:VisualElement name="AppTileVolt" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-grid-os" />
                                        <ui:Label text="Grid OS" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 2. ResView -->
                                    <ui:VisualElement name="AppTileRes" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-resview-levels" />
                                        <ui:Label text="ResView" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 3. Almanac -->
                                    <ui:VisualElement name="AppTileAlmanac" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-good-almanac" />
                                        <ui:Label text="Almanac" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 4. Board Meeting -->
                                    <ui:VisualElement name="AppTileLumber" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-board-meeting" />
                                        <ui:Label text="Board Meeting" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 5. Nail It -->
                                    <ui:VisualElement name="AppTileDepot" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-nail-it" />
                                        <ui:Label text="Nail It" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 6. Lettuce Shop -->
                                    <ui:VisualElement name="AppTileGrocer" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-lettuce-shop" />
                                        <ui:Label text="Lettuce Shop" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 7. Hay There -->
                                    <ui:VisualElement name="AppTileFeed" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-hay-there" />
                                        <ui:Label text="Hay There" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 8. Cache Flow -->
                                    <ui:VisualElement name="AppTileBank" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-cache-flow" />
                                        <ui:Label text="Cache Flow" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 9. Bazaar Behavior -->
                                    <ui:VisualElement name="AppTileMarket" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-bazaar-behavior" />
                                        <ui:Label text="Bazaar Behavior" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 10. Shift Happens -->
                                    <ui:VisualElement name="AppTileVehicles" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-shift-happens" />
                                        <ui:Label text="Shift Happens" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 11. Tank You -->
                                    <ui:VisualElement name="AppTileWater" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-tank-you" />
                                        <ui:Label text="Tank You" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 12. Drafting Behind You -->
                                    <ui:VisualElement name="AppTileLivestock" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-drafting-behind" />
                                        <ui:Label text="Drafting Behind You" class="phone-app-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <!-- Page 2: remaining apps -->
                                <ui:VisualElement class="phone-launcher-page">
                                    <!-- 13. Tractor Beam -->
                                    <ui:VisualElement name="AppTileEquipment" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-tractor-beam" />
                                        <ui:Label text="Tractor Beam" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 14. Wheel Deal -->
                                    <ui:VisualElement name="AppTileDealership" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-wheel-deal" />
                                        <ui:Label text="Wheel Deal" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 15. Trailer Shack (Trailer Sales & Secure Parts) -->
                                    <ui:VisualElement name="AppTileTrailerShack" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-trailer-shack" />
                                        <ui:Label text="Trailer Shack" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 16. Voltvision (Electronics & Off-Grid Solar) -->
                                    <ui:VisualElement name="AppTileVoltvision" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-voltvision" />
                                        <ui:Label text="Voltvision" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 17. Sofa So Good -->
                                    <ui:VisualElement name="AppTileFurniture" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-sofa-so-good" />
                                        <ui:Label text="Sofa So Good" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 18. Gigs (Job Board) -->
                                    <ui:VisualElement name="AppTileGigs" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-gigs" />
                                        <ui:Label text="Gigs" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 19. Land Office -->
                                    <ui:VisualElement name="AppTileLand" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-land-office" />
                                        <ui:Label text="Land Office" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 20. Mods Manager -->
                                    <ui:VisualElement name="AppTileMods" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-mods" />
                                        <ui:Label text="Mods" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 21. Admin Tools -->
                                    <ui:VisualElement name="AppTileAdmin" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-admin" />
                                        <ui:Label text="Admin" class="phone-app-label" />
                                    </ui:VisualElement>

                                    <!-- 22. Steadify (Music Player) -->
                                    <ui:VisualElement name="AppTileSteadify" class="phone-app-tile">
                                        <ui:VisualElement class="phone-app-icon-box app-icon-steadify" />
                                        <ui:Label text="Steadify" class="phone-app-label" />
                                    </ui:VisualElement>
                                 </ui:VisualElement>
                             </ui:VisualElement>
                         </ui:VisualElement>

                        <!-- Dot Page Indicators -->
                        <ui:VisualElement name="PhonePageDotsRow" class="phone-page-dots-row">
                            <ui:VisualElement name="PhoneDot0" class="phone-page-dot phone-page-dot--active">
                                <ui:VisualElement class="phone-page-dot-inner" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="PhoneDot1" class="phone-page-dot">
                                <ui:VisualElement class="phone-page-dot-inner" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- VOLT / GRID OS APP VIEW -->
                    <ui:VisualElement name="ViewVolt" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="VoltBackBtn" text="←" class="phone-back-btn" />
                            <ui:Label text="Grid OS • Solar &amp; Power" class="phone-app-title" />
                        </ui:VisualElement>
                        <ui:ScrollView class="phone-app-scroll">
                            <ui:VisualElement class="grid-card">
                                <ui:Label text="CURRENT SOLAR GENERATION" class="grid-card-title" />
                                <ui:Label name="GridSolarWatts" text="1.85 kW" class="grid-metric-large" />
                                <ui:Label text="Array Efficiency: 94% • 6 Active Panels" class="grid-metric-sub" />
                                <ui:VisualElement class="grid-bar-track">
                                    <ui:VisualElement name="GridSolarFill" class="grid-bar-fill-solar" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="grid-card">
                                <ui:Label text="HOMESTEAD BATTERY BANK" class="grid-card-title" />
                                <ui:Label name="GridBatteryPct" text="84% (16.8 kWh)" class="grid-metric-large" />
                                <ui:Label text="LiFePO4 Storage • Est. Runtime: 14h 20m" class="grid-metric-sub" />
                                <ui:VisualElement class="grid-bar-track">
                                    <ui:VisualElement name="GridBatteryFill" class="grid-bar-fill-battery" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="grid-card">
                                <ui:Label text="CURRENT HOUSE LOAD" class="grid-card-title" />
                                <ui:Label name="GridLoadWatts" text="420 W" class="grid-metric-large" />
                                <ui:Label text="Pumps: 180W • Internet: 40W • Baseline: 200W" class="grid-metric-sub" />
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- RESVIEW APP VIEW -->
                    <ui:VisualElement name="ViewRes" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="ResBackBtn" text="←" class="phone-back-btn" />
                            <ui:Label text="ResView • Homestead Utilities" class="phone-app-title" />
                        </ui:VisualElement>
                        <ui:ScrollView class="phone-app-scroll">
                            <ui:VisualElement class="grid-card">
                                <ui:Label text="POTABLE WATER STORAGE" class="grid-card-title" />
                                <ui:Label name="ResWaterText" text="820 L / 1,000 L" class="grid-metric-large" />
                                <ui:Label text="Well Inflow: +4.2 L/min • Poly Cistern" class="grid-metric-sub" />
                            </ui:VisualElement>

                            <ui:VisualElement class="grid-card">
                                <ui:Label text="FUEL RESERVES (DIESEL / PROPANE)" class="grid-card-title" />
                                <ui:Label name="ResFuelText" text="160 L Diesel • 250 Gal Propane" class="grid-metric-large" />
                                <ui:Label text="Backup Generator Ready • Tank Level: 78%" class="grid-metric-sub" />
                            </ui:VisualElement>

                            <ui:VisualElement class="grid-card">
                                <ui:Label text="INTERNET &amp; TELEMETRY" class="grid-card-title" />
                                <ui:Label name="ResNetText" text="Starlink Satellite • 85 Mbps" class="grid-metric-large" />
                                <ui:Label text="Latency: 32ms • Mesh WiFi Online" class="grid-metric-sub" />
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- STORE APP VIEW (SHARED ENGINE) -->
                    <ui:VisualElement name="ViewStore" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="StoreBackBtn" text="←" class="phone-back-btn" />
                            <ui:Label name="StoreTitle" text="Homestead Depot" class="phone-app-title" />
                        </ui:VisualElement>

                        <!-- The banner and the search box stay put; only the items scroll underneath them. -->
                        <ui:VisualElement class="store-fixed">
                            <ui:VisualElement name="StoreBanner" class="store-banner store-banner-depot">
                                <ui:Label name="StoreBannerText" text="Fast Homestead Delivery (Free over $100)" class="store-banner-text" />
                            </ui:VisualElement>

                            <!-- Store Search Bar -->
                            <ui:VisualElement class="store-search-row">
                                <ui:TextField name="StoreSearchInput" placeholder-text="Search items..." class="store-search-input" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:ScrollView class="phone-app-scroll">
                            <ui:VisualElement name="StoreItemsContainer">
                                <!-- Populated dynamically by C# -->
                            </ui:VisualElement>
                        </ui:ScrollView>

                        <!-- Cart / Order Summary Bar -->
                        <ui:VisualElement class="store-checkout-bar">
                            <ui:VisualElement>
                                <ui:Label name="StoreCartCount" text="Items in Cart: 0" class="store-cart-text" />
                                <ui:Label name="StoreCartTotal" text="Total: $0.00" class="store-item-name" />
                            </ui:VisualElement>
                            <ui:Button name="StoreCheckoutBtn" text="Order Delivery" class="store-item-buy-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- BANKING APP VIEW (FIRST HOMESTEAD BANK) -->
                    <ui:VisualElement name="ViewBank" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="BankBackBtn" text="←" class="phone-back-btn" />
                            <ui:Label text="First Homestead Bank" class="phone-app-title" />
                        </ui:VisualElement>

                        <ui:ScrollView class="phone-app-scroll">
                            <!-- Account Balance Card -->
                            <ui:VisualElement class="bank-card">
                                <ui:Label text="CHECKING ACCOUNT BALANCE" class="bank-card-label" />
                                <ui:Label name="BankBalanceText" text="$1,250.00" class="bank-balance-large" />
                                <ui:Label text="Account # •••• 8492  •  FDIC Insured" class="bank-card-sub" />
                            </ui:VisualElement>

                            <!-- Active Loans Card -->
                            <ui:VisualElement class="bank-card">
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                                    <ui:Label text="ACTIVE LOAN DEBT" class="bank-card-label" />
                                    <ui:Label text="3.5% APR" class="bank-rate-pill" />
                                </ui:VisualElement>
                                <ui:Label name="BankLoanDebtText" text="$0.00" class="bank-debt-large" />
                                <ui:Label name="BankDailyInterestText" text="Daily Interest: $0.00 / day" class="bank-card-sub" />

                                <ui:VisualElement style="flex-direction: row; margin-top: 10px; justify-content: space-between;">
                                    <ui:Button name="BankPay100Btn" text="Pay $100" class="bank-action-btn" />
                                    <ui:Button name="BankPay500Btn" text="Pay $500" class="bank-action-btn" />
                                    <ui:Button name="BankPayAllBtn" text="Pay All" class="bank-action-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Take Out Loans Card -->
                            <ui:VisualElement class="bank-card">
                                <ui:Label text="BORROW HOMESTEAD CAPITAL" class="bank-card-label" />
                                <ui:Label text="Instant credit transfer to checking balance." class="bank-card-sub" style="margin-bottom: 8px;" />

                                <ui:VisualElement class="bank-loan-row">
                                    <ui:VisualElement>
                                        <ui:Label text="Small Farm Micro-Loan" class="store-item-name" />
                                        <ui:Label text="$500 • Low interest" class="store-item-price" />
                                    </ui:VisualElement>
                                    <ui:Button name="BankTake500Btn" text="Borrow $500" class="store-item-buy-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="bank-loan-row">
                                    <ui:VisualElement>
                                        <ui:Label text="Homestead Expansion Loan" class="store-item-name" />
                                        <ui:Label text="$2,500 • Farm building grant" class="store-item-price" />
                                    </ui:VisualElement>
                                    <ui:Button name="BankTake2500Btn" text="Borrow $2,500" class="store-item-buy-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="bank-loan-row">
                                    <ui:VisualElement>
                                        <ui:Label text="Heavy Equipment Financing" class="store-item-name" />
                                        <ui:Label text="$10,000 • Tractor / Skidsteer" class="store-item-price" />
                                    </ui:VisualElement>
                                    <ui:Button name="BankTake10000Btn" text="Borrow $10k" class="store-item-buy-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- PLAYER MARKETPLACE / EXCHANGE APP VIEW -->
                    <ui:VisualElement name="ViewMarket" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="MarketBackBtn" text="←" class="phone-back-btn" />
                            <ui:Label text="Homestead Exchange" class="phone-app-title" />
                        </ui:VisualElement>

                        <!-- Market Navigation Tabs -->
                        <ui:VisualElement class="market-tab-bar">
                            <ui:Button name="MarketTabBuyBtn" text="Buy Listings" class="market-tab-btn market-tab-btn--active" />
                            <ui:Button name="MarketTabSellBtn" text="Sell Produce" class="market-tab-btn" />
                        </ui:VisualElement>

                        <!-- Buy Listings Container -->
                        <ui:ScrollView name="MarketBuyScroll" class="phone-app-scroll">
                            <ui:VisualElement class="store-banner store-banner-exchange">
                                <ui:Label text="Local Player Community Goods &amp; Rare Crafts" class="store-banner-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="MarketBuyContainer" />
                        </ui:ScrollView>

                        <!-- Sell Produce Container -->
                        <ui:ScrollView name="MarketSellScroll" class="phone-app-scroll phone-app-scroll--hidden">
                            <ui:VisualElement class="store-banner store-banner-exchange">
                                <ui:Label text="Sell Farm Drops &amp; Crafts for Immediate Cash" class="store-banner-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="MarketSellContainer" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- ============================================== -->
                    <!-- 6. ALMANAC APP VIEW                            -->
                    <!-- ============================================== -->
                    <ui:VisualElement name="ViewAlmanac" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="AlmanacBackBtn" text="←" class="phone-back-btn" />
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label text="Homestead Almanac" class="phone-app-title" />
                                <ui:Label text="Rolling 32-Week Outlook" class="phone-app-subtitle" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Almanac Today Banner -->
                        <ui:VisualElement name="AlmanacTodayBanner" class="almanac-today-banner">
                            <ui:Label name="AlmanacTodayTitle" text="TODAY • Day 1 (January 1 • Winter)" class="almanac-today-title" />
                            <ui:Label name="AlmanacTodayDetails" text="Sunrise 7:30 AM • Sunset 4:30 PM (9.0h) • New Moon" class="almanac-today-details" />
                        </ui:VisualElement>

                        <!-- Tab Bar: Daily (8 Weeks) vs Weekly (24 Weeks) -->
                        <ui:VisualElement class="almanac-tab-bar">
                            <ui:Button name="AlmanacTabDailyBtn" text="Daily (8 Weeks / 56 Days)" class="almanac-tab-btn almanac-tab-btn--active" />
                            <ui:Button name="AlmanacTabWeeklyBtn" text="Seasonal (24 Weeks)" class="almanac-tab-btn" />
                        </ui:VisualElement>

                        <!-- ScrollView for Forecast Cards -->
                        <ui:ScrollView name="AlmanacScrollView" class="phone-app-scroll" vertical-scroller-visibility="AlwaysVisible" mouse-wheel-scroll-size="36">
                            <!-- Daily Forecasts Container (56 cards) -->
                            <ui:VisualElement name="AlmanacDailyContainer" class="almanac-cards-container" />

                            <!-- Weekly Forecasts Container (24 cards) -->
                            <ui:VisualElement name="AlmanacWeeklyContainer" class="almanac-cards-container phone-app-scroll--hidden" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- ============================================== -->
                    <!-- GIGS (JOB BOARD) APP VIEW                       -->
                    <!-- ============================================== -->
                    <ui:VisualElement name="ViewGigs" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="GigsBackBtn" text="←" class="phone-back-btn" />
                            <ui:Label text="Gigs" class="phone-app-title" />
                        </ui:VisualElement>

                        <ui:ScrollView class="phone-app-scroll">
                            <ui:VisualElement name="GigsCurrentCard" class="bank-card" style="display: none;">
                                <ui:Label name="GigsCurrentTitle" text="CURRENT JOB" class="bank-card-label" />
                                <ui:Label name="GigsCurrentDetail" text="" class="bank-card-sub" />
                                <ui:VisualElement style="flex-direction: row; margin-top: 10px; justify-content: space-between;">
                                    <ui:Button name="GigsWorkBtn" text="Go to Work Now" class="bank-action-btn" />
                                    <ui:Button name="GigsQuitBtn" text="Quit Job" class="bank-action-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:Label name="GigsHint" text="Pick a shift. Pay is per day, credited when the shift ends." class="bank-card-sub" style="margin-bottom: 8px;" />

                            <ui:VisualElement class="admin-chip-row">
                                <ui:Button name="GigsFilterAll" text="All" class="admin-chip-btn" />
                                <ui:Button name="GigsFilterOnsite" text="On-site" class="admin-chip-btn" />
                                <ui:Button name="GigsFilterRemote" text="Remote" class="admin-chip-btn" />
                                <ui:Button name="GigsFilter2h" text="2h" class="admin-chip-btn" />
                                <ui:Button name="GigsFilter4h" text="4h" class="admin-chip-btn" />
                                <ui:Button name="GigsFilter8h" text="8h" class="admin-chip-btn" />
                            </ui:VisualElement>

                            <ui:VisualElement name="GigsListContainer" class="almanac-cards-container" />
                          </ui:ScrollView>
                      </ui:VisualElement>

                    <!-- ============================================== -->
                    <!-- STEADIFY (MUSIC PLAYER) APP VIEW               -->
                    <!-- ============================================== -->
                    <ui:VisualElement name="ViewSteadify" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="SteadifyBackBtn" text="←" class="phone-back-btn" />
                            <ui:Label text="Steadify" class="phone-app-title" />
                        </ui:VisualElement>

                        <!-- Music / Radio switch. Radio content lives in SteadifyRadioPane; every music block carries steadify-music so the switch can hide it. -->
                        <ui:VisualElement class="steadify-mode-row">
                            <ui:Button name="SteadifyModeMusicBtn" text="Music" class="steadify-mode-btn steadify-mode-btn--active" />
                            <ui:Button name="SteadifyModeRadioBtn" text="Radio" class="steadify-mode-btn" />
                        </ui:VisualElement>

                        <ui:VisualElement name="SteadifyRadioPane" class="steadify-radio-pane steadify-radio-pane--hidden">
                            <ui:VisualElement class="steadify-playlist-selector-row">
                                <ui:Label text="Station:" class="steadify-playlist-selector-label" />
                                <ui:DropdownField name="SteadifyRadioStation" class="steadify-playlist-selector" />
                            </ui:VisualElement>

                            <ui:VisualElement class="steadify-now-playing-card">
                                <ui:Label name="SteadifyRadioFrequency" text="88.3 FM" class="steadify-radio-frequency" />
                                <ui:Label name="SteadifyRadioTitle" text="Radio off" class="steadify-track-title" />
                                <ui:Label name="SteadifyRadioStatus" text="Pick a station to tune in." class="steadify-track-meta" />
                                <ui:VisualElement name="SteadifyRadioProgress" class="steadify-radio-progress">
                                    <ui:VisualElement name="SteadifyRadioProgressFill" class="steadify-radio-progress-fill" />
                                </ui:VisualElement>
                                <ui:VisualElement class="steadify-transport-row">
                                    <ui:Button name="SteadifyRadioPowerBtn" text="On Air" class="steadify-transport-btn steadify-transport-btn--primary steadify-radio-power-btn" />
                                    <ui:Button name="SteadifyRadioPauseBtn" text="&#x23F8;" class="steadify-transport-btn" />
                                    <ui:Button name="SteadifyRadioRewriteBtn" text="Rewrite" class="steadify-transport-btn steadify-radio-text-btn" />
                                </ui:VisualElement>
                                <ui:Label name="SteadifyRadioVoice" text="" class="steadify-radio-voice" />
                            </ui:VisualElement>

                            <ui:Label text="TRANSCRIPT" class="steadify-playlist-heading" />
                            <ui:ScrollView name="SteadifyRadioScroll" class="phone-app-scroll">
                                <ui:VisualElement name="SteadifyRadioTranscript" class="almanac-cards-container" />
                            </ui:ScrollView>
                        </ui:VisualElement>

                        <ui:VisualElement class="steadify-playlist-selector-row steadify-music">
                            <ui:Label text="Playlist:" class="steadify-playlist-selector-label" />
                            <ui:DropdownField name="SteadifyPlaylistSelector" class="steadify-playlist-selector" />
                        </ui:VisualElement>

                        <ui:VisualElement class="steadify-shuffle-row steadify-music">
                            <ui:Button name="SteadifyShuffleAllBtn" text="Shuffle All" class="steadify-shuffle-all-btn" />
                            <ui:Button name="SteadifyPopoutBtn" text="&#xE010;" class="steadify-popout-btn" />
                        </ui:VisualElement>

                        <ui:VisualElement class="steadify-now-playing-card steadify-music">
                            <ui:VisualElement name="SteadifyAlbumArt" class="steadify-album-art">
                                <ui:Label text="&#x266B;" class="steadify-album-art-glyph" />
                            </ui:VisualElement>
                            <ui:Label name="SteadifyTrackTitle" text="No Track" class="steadify-track-title" />
                            <ui:Label name="SteadifyTrackMeta" text="Steadify" class="steadify-track-meta" />

                            <ui:VisualElement class="steadify-seek-row">
                                <ui:Label name="SteadifyTimeElapsed" text="0:00" class="steadify-time-label" />
                                <ui:Slider name="SteadifySeekSlider" low-value="0" high-value="1" value="0" class="hs-slider steadify-seek-slider" />
                                <ui:Label name="SteadifyTimeTotal" text="0:00" class="steadify-time-label" />
                            </ui:VisualElement>

                            <ui:VisualElement class="steadify-transport-row">
                                <ui:Button name="SteadifyShuffleBtn" text="&#xE000;" class="steadify-transport-btn steadify-transport-btn--small" />
                                <ui:Button name="SteadifyPrevBtn" text="&#x23EE;" class="steadify-transport-btn" />
                                <ui:Button name="SteadifyPlayPauseBtn" text="&#x25B6;" class="steadify-transport-btn steadify-transport-btn--primary" />
                                <ui:Button name="SteadifyNextBtn" text="&#x23ED;" class="steadify-transport-btn" />
                                <ui:Button name="SteadifyRepeatBtn" text="&#xE001;" class="steadify-transport-btn steadify-transport-btn--small" />
                            </ui:VisualElement>

                            <ui:VisualElement class="steadify-volume-row">
                                <ui:Label text="&#xE006;" class="steadify-volume-glyph" />
                                <ui:Slider name="SteadifyVolumeSlider" low-value="0" high-value="100" value="65" class="hs-slider steadify-volume-slider" />
                                <ui:Label name="SteadifyVolumeValue" text="65%" class="steadify-volume-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:Label text="PLAYLIST" class="steadify-playlist-heading steadify-music" />
                        <ui:ScrollView class="phone-app-scroll steadify-music">
                            <ui:VisualElement name="SteadifyPlaylistContainer" class="almanac-cards-container" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- ============================================== -->
                    <!-- LAND OFFICE APP VIEW                           -->
                    <!-- ============================================== -->
                    <ui:VisualElement name="ViewLand" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                      <ui:Button name="LandBackBtn" text="←" class="phone-back-btn" />
                      <ui:Label text="Land Office" class="phone-app-title" />
                        </ui:VisualElement>
                        <ui:ScrollView class="phone-app-scroll">
                      <ui:VisualElement class="bank-card">
                          <ui:Label text="YOUR PROPERTY" class="bank-card-label" />
                          <ui:Label name="LandOwnedCount" text="1 / 25 tiles owned" class="bank-card-sub" />
                          <ui:Label name="LandBalance" text="Balance: $5,000" class="bank-card-sub" style="margin-top: 4px;" />
                      </ui:VisualElement>

                      <ui:Label text="AVAILABLE PARCELS" class="bank-card-label" style="margin-top: 12px; margin-bottom: 4px;" />
                      <ui:Label text="Each parcel is 100m x 100m. $5,000 per tile." class="bank-card-sub" style="margin-bottom: 8px;" />
                      <ui:VisualElement name="LandListContainer" class="almanac-cards-container" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- ============================================== -->
                    <!-- 7. ADMIN / DEBUG APP VIEW                      -->
                    <!-- ============================================== -->
                    <ui:VisualElement name="ViewAdmin" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="AdminBackBtn" text="←" class="phone-back-btn" />
                            <ui:Label text="Admin Tools" class="phone-app-title" />
                            <ui:Button name="AdminAssetsBtn" text="Assets" class="admin-header-assets-btn" tooltip="Open Asset Spawner Window" />
                        </ui:VisualElement>
                        <ui:ScrollView name="AdminScrollView" mode="Vertical" class="phone-app-scroll" mouse-wheel-scroll-size="36" vertical-scroller-visibility="AlwaysVisible">
                            <!-- Section: Item & Asset Spawner -->
                            <ui:VisualElement class="admin-card">
                                <ui:VisualElement class="admin-header-row">
                                    <ui:Label text="ITEM &amp; ASSET SPAWNER" class="admin-card-title" />
                                    <ui:Button name="AdminAssetsCardBtn" text="Open Assets" class="admin-action-btn" style="padding-left: 8px; padding-right: 8px;" />
                                </ui:VisualElement>
                                <ui:Label text="Browse 540+ items across 17 categories. Click to add 1, Shift+Click to add a full stack to toolbar." class="admin-sublabel" style="font-size: 11px; margin-top: 3px;" />
                            </ui:VisualElement>

                            <!-- Section: Measurement System -->
                            <ui:VisualElement class="admin-card">
                                <ui:Label text="MEASUREMENT SYSTEM" class="admin-card-title" />
                                <ui:VisualElement class="admin-chip-row">
                                    <ui:Button name="AdminUnitMetricBtn" text="Metric (L, MJ, m)" class="admin-chip-btn admin-chip-btn--active" />
                                    <ui:Button name="AdminUnitImperialBtn" text="Imperial (gal, kWh, ft)" class="admin-chip-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Section: Player Vitals -->
                            <ui:VisualElement class="admin-card">
                                <ui:VisualElement class="admin-header-row">
                                    <ui:Label text="PLAYER VITALS (-100 to +100)" class="admin-card-title" />
                                    <ui:VisualElement style="flex-direction: row;">
                                        <ui:Button name="AdminVitalsResetBtn" text="Reset (0)" class="admin-action-btn" style="margin-right: 4px;" />
                                        <ui:Button name="AdminVitalsMaxBtn" text="Max (+100)" class="admin-action-btn" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-slider-row">
                                    <ui:VisualElement class="admin-vital-header-row">
                                        <ui:Label name="AdminVitalWellnessLabel" text="Wellness: 0 (Neutral)" class="admin-sublabel" />
                                        <ui:Button name="AdminVitalWellnessZeroBtn" text="0" class="admin-vital-zero-btn" tooltip="Reset to 0 (Neutral)" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="admin-slider-container">
                                        <ui:SliderInt name="AdminVitalWellnessSlider" low-value="-100" high-value="100" value="0" class="hs-slider admin-slider" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="admin-scale-row">
                                        <ui:Label text="-100" class="admin-scale-label admin-scale-label--min" />
                                        <ui:Label text="0" class="admin-scale-label admin-scale-label--mid" />
                                        <ui:Label text="+100" class="admin-scale-label admin-scale-label--max" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-slider-row">
                                    <ui:VisualElement class="admin-vital-header-row">
                                        <ui:Label name="AdminVitalStaminaLabel" text="Stamina: 0 (Neutral)" class="admin-sublabel" />
                                        <ui:Button name="AdminVitalStaminaZeroBtn" text="0" class="admin-vital-zero-btn" tooltip="Reset to 0 (Neutral)" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="admin-slider-container">
                                        <ui:SliderInt name="AdminVitalStaminaSlider" low-value="-100" high-value="100" value="0" class="hs-slider admin-slider" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="admin-scale-row">
                                        <ui:Label text="-100" class="admin-scale-label admin-scale-label--min" />
                                        <ui:Label text="0" class="admin-scale-label admin-scale-label--mid" />
                                        <ui:Label text="+100" class="admin-scale-label admin-scale-label--max" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-slider-row">
                                    <ui:VisualElement class="admin-vital-header-row">
                                        <ui:Label name="AdminVitalThirstLabel" text="Thirst: 0 (Neutral)" class="admin-sublabel" />
                                        <ui:Button name="AdminVitalThirstZeroBtn" text="0" class="admin-vital-zero-btn" tooltip="Reset to 0 (Neutral)" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="admin-slider-container">
                                        <ui:SliderInt name="AdminVitalThirstSlider" low-value="-100" high-value="100" value="0" class="hs-slider admin-slider" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="admin-scale-row">
                                        <ui:Label text="-100" class="admin-scale-label admin-scale-label--min" />
                                        <ui:Label text="0" class="admin-scale-label admin-scale-label--mid" />
                                        <ui:Label text="+100" class="admin-scale-label admin-scale-label--max" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-slider-row">
                                    <ui:VisualElement class="admin-vital-header-row">
                                        <ui:Label name="AdminVitalHungerLabel" text="Hunger: 0 (Neutral)" class="admin-sublabel" />
                                        <ui:Button name="AdminVitalHungerZeroBtn" text="0" class="admin-vital-zero-btn" tooltip="Reset to 0 (Neutral)" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="admin-slider-container">
                                        <ui:SliderInt name="AdminVitalHungerSlider" low-value="-100" high-value="100" value="0" class="hs-slider admin-slider" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="admin-scale-row">
                                        <ui:Label text="-100" class="admin-scale-label admin-scale-label--min" />
                                        <ui:Label text="0" class="admin-scale-label admin-scale-label--mid" />
                                        <ui:Label text="+100" class="admin-scale-label admin-scale-label--max" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Section: Resources & Money -->
                            <ui:VisualElement class="admin-card">
                                <ui:VisualElement class="admin-header-row">
                                    <ui:Label text="RESOURCES &amp; FINANCES" class="admin-card-title" />
                                    <ui:Button name="AdminResResetDefaultsBtn" text="Reset Defaults" class="admin-action-btn"  />
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-input-row">
                                    <ui:Label name="AdminResWaterLabel" text="Water (L):" class="admin-input-label" />
                                    <ui:TextField name="AdminResWaterInput" value="0" class="admin-text-field" />
                                    <ui:Button name="AdminResWaterSetBtn" text="Set" class="admin-set-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-input-row">
                                    <ui:Label name="AdminResElecLabel" text="Electricity (MJ):" class="admin-input-label" />
                                    <ui:TextField name="AdminResElecInput" value="0" class="admin-text-field" />
                                    <ui:Button name="AdminResElecSetBtn" text="Set" class="admin-set-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-input-row">
                                    <ui:Label name="AdminResBandwidthLabel" text="Bandwidth (Mbps):" class="admin-input-label" />
                                    <ui:TextField name="AdminResBandwidthInput" value="0" class="admin-text-field" />
                                    <ui:Button name="AdminResBandwidthSetBtn" text="Set" class="admin-set-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-input-row">
                                    <ui:Label name="AdminResFuelLabel" text="Fuel (L):" class="admin-input-label" />
                                    <ui:TextField name="AdminResFuelInput" value="0" class="admin-text-field" />
                                    <ui:Button name="AdminResFuelSetBtn" text="Set" class="admin-set-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-input-row">
                                    <ui:Label name="AdminResMoneyLabel" text="Cash ($):" class="admin-input-label" />
                                    <ui:TextField name="AdminResMoneyInput" value="0" class="admin-text-field" />
                                    <ui:Button name="AdminResMoneySetBtn" text="Set" class="admin-set-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-chip-row" style="margin-top: 8px;">
                                    <ui:Button name="AdminAddMoney500" text="+$500" class="admin-chip-btn" />
                                    <ui:Button name="AdminAddMoney5000" text="+$5,000" class="admin-chip-btn" />
                                    <ui:Button name="AdminClearDebtBtn" text="Clear Debt" class="admin-chip-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Section: Environment & Calendar -->
                            <ui:VisualElement class="admin-card">
                                <ui:Label text="SEASON &amp; CALENDAR" class="admin-card-title" />
                                <ui:VisualElement class="admin-chip-row">
                                    <ui:Button name="AdminSeasonWinterBtn" text="Winter" class="admin-chip-btn" />
                                    <ui:Button name="AdminSeasonSpringBtn" text="Spring" class="admin-chip-btn" />
                                    <ui:Button name="AdminSeasonSummerBtn" text="Summer" class="admin-chip-btn" />
                                    <ui:Button name="AdminSeasonAutumnBtn" text="Autumn" class="admin-chip-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-row">
                                    <ui:Label name="AdminDayLabel" text="Day 1 (January 1)" class="admin-label" />
                                    <ui:VisualElement class="admin-stepper-row">
                                        <ui:Button name="AdminDaySub7" text="-7" class="admin-step-btn" />
                                        <ui:Button name="AdminDaySub1" text="-1" class="admin-step-btn" />
                                        <ui:Button name="AdminDayAdd1" text="+1" class="admin-step-btn" />
                                        <ui:Button name="AdminDayAdd7" text="+7" class="admin-step-btn" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:SliderInt name="AdminDaySlider" low-value="1" high-value="336" value="1" class="hs-slider admin-slider" />

                                <ui:Label name="AdminDaylightLabel" text="Daylight: 12.0h • Sunrise 06:00, Sunset 18:00" class="admin-sublabel" style="font-size: 13px; margin-top: 4px;" />
                                <ui:Label name="AdminAstroLabel" text="Daylight Increasing (towards Summer Solstice)" class="admin-sublabel" style="font-size: 12px; color: rgb(193, 154, 60); margin-bottom: 6px;" />

                                <ui:Label text="SOLSTICES &amp; EQUINOXES (3RD WEEK)" class="admin-card-title" style="font-size: 12px; color: rgb(150, 165, 185); margin-top: 4px; margin-bottom: 4px;" />
                                <ui:VisualElement class="admin-chip-row">
                                    <ui:Button name="AdminJumpSpringEquinoxBtn" text="Mar 21 Spring Equinox" class="admin-chip-btn" tooltip="March 21 (Day 77) - Equal Day &amp; Night (12h/12h)" />
                                    <ui:Button name="AdminJumpSummerSolsticeBtn" text="Jun 21 Summer Solstice" class="admin-chip-btn" tooltip="June 21 (Day 161) - Longest Day (15h daylight)" />
                                </ui:VisualElement>
                                <ui:VisualElement class="admin-chip-row">
                                    <ui:Button name="AdminJumpAutumnEquinoxBtn" text="Sep 21 Autumn Equinox" class="admin-chip-btn" tooltip="September 21 (Day 245) - Equal Day &amp; Night (12h/12h)" />
                                    <ui:Button name="AdminJumpWinterSolsticeBtn" text="Dec 21 Winter Solstice" class="admin-chip-btn" tooltip="December 21 (Day 329) - Longest Night (15h night / 9h day)" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Section: Time of Day -->
                            <ui:VisualElement class="admin-card">
                                <ui:Label text="TIME OF DAY" class="admin-card-title" />
                                <ui:VisualElement class="admin-chip-row">
                                    <ui:Button name="AdminTimeDawnBtn"  text="Dawn 6AM"  class="admin-chip-btn" />
                                    <ui:Button name="AdminTimeNoonBtn"  text="Noon 12PM" class="admin-chip-btn" />
                                    <ui:Button name="AdminTimeDuskBtn"  text="Dusk 6PM"  class="admin-chip-btn" />
                                    <ui:Button name="AdminTimeNightBtn" text="Night 12AM" class="admin-chip-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="admin-row">
                                    <ui:Label name="AdminTimeLabel" text="Time: 08:00" class="admin-label" />
                                    <ui:VisualElement name="AdminTimeIcon" class="admin-time-icon" />
                                </ui:VisualElement>
                                <ui:Slider name="AdminTimeSlider" low-value="0" high-value="1439" value="480" class="hs-slider admin-slider" />
                            </ui:VisualElement>

                            <!-- Section: Weather Conditions -->
                            <ui:VisualElement class="admin-card">
                                <ui:VisualElement class="admin-header-row">
                                    <ui:Label text="WEATHER CONDITIONS" class="admin-card-title" />
                                    <ui:Button name="AdminWeatherAutoBtn" text="Auto (Season)" class="admin-action-btn"  />
                                </ui:VisualElement>
                                <ui:VisualElement class="admin-chip-row">
                                    <ui:Button name="AdminWeatherSunnyBtn" text="Sunny" class="admin-chip-btn" />
                                    <ui:Button name="AdminWeatherPartlyCloudyBtn" text="Pt Cloudy" class="admin-chip-btn" />
                                    <ui:Button name="AdminWeatherCloudyBtn" text="Cloudy" class="admin-chip-btn" />
                                    <ui:Button name="AdminWeatherRainBtn" text="Rain" class="admin-chip-btn" />
                                </ui:VisualElement>
                                <ui:VisualElement class="admin-chip-row">
                                    <ui:Button name="AdminWeatherThunderstormBtn" text="Storm" class="admin-chip-btn" />
                                    <ui:Button name="AdminWeatherSnowBtn" text="Snow" class="admin-chip-btn" />
                                    <ui:Button name="AdminWeatherBlizzardBtn" text="Blizzard" class="admin-chip-btn" />
                                    <ui:Button name="AdminWeatherWindBtn" text="Wind" class="admin-chip-btn" />
                                    <ui:Button name="AdminWeatherFogBtn" text="Fog" class="admin-chip-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- ============================================== -->
                    <!-- 9. MODS MANAGER VIEW                           -->
                    <!-- ============================================== -->
                    <ui:VisualElement name="ViewMods" class="phone-app-view phone-app-view--hidden">
                        <ui:VisualElement class="phone-app-header">
                            <ui:Button name="ModsBackBtn" text="←" class="phone-back-btn" />
                            <ui:Label text="Mod Manager" class="phone-app-title" />
                        </ui:VisualElement>

                        <!-- Search Bar -->
                        <ui:VisualElement class="mods-search-row">
                            <ui:TextField name="ModsSearchInput" placeholder-text="Search mods by name or category..." class="mods-search-input" />
                        </ui:VisualElement>

                        <!-- Category Navigation Header (Active when inside a category) -->
                        <ui:VisualElement name="ModsCategoryNav" class="mods-category-nav phone-app-view--hidden">
                            <ui:Button name="ModsCategoryBackBtn" text="← Categories" class="mods-category-back-btn" />
                            <ui:Label name="ModsCategoryTitle" text="Category" class="mods-category-nav-title" />
                            <ui:Button name="ModsCategoryToggleBtn" text="Disable Category" class="mod-toggle-btn mod-toggle-btn--enabled" />
                        </ui:VisualElement>

                        <!-- Mod Categories & Items List -->
                        <ui:ScrollView class="phone-app-scroll">
                            <ui:VisualElement name="ModsCategoriesContainer" class="mods-cards-container">
                                <!-- Category cards populated dynamically -->
                            </ui:VisualElement>
                            <ui:VisualElement name="ModsListContainer" class="mods-cards-container phone-app-view--hidden">
                                <!-- Mod cards populated dynamically -->
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- Bottom Gesture Bar -->
                <ui:VisualElement class="phone-bottom-bar">
                    <ui:VisualElement name="PhoneHomeBtn" class="phone-home-pill" tooltip="Return to Home" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
