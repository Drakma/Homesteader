<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="false">
    <Style src="WelcomeMenu.uss" />
    <Style src="UIControls.uss" />

    <!-- Full-screen overlay with background image -->
    <ui:VisualElement name="WelcomeMenuRoot" class="welcome-root welcome--hidden">

        <!-- Centered menu card -->
        <ui:VisualElement name="WelcomeCard" class="welcome-card">
            <ui:VisualElement class="hs-accent-edge" picking-mode="Ignore" />

            <!-- Title -->
            <ui:VisualElement class="welcome-title-block">
                <ui:Label text="HOMESTEADER" class="welcome-title" />
                <ui:Label text="A new life on the land" class="welcome-subtitle" />
            </ui:VisualElement>

            <!-- Main buttons -->
            <ui:Button name="NewGameBtn" text="New Game" class="welcome-btn welcome-btn--primary" />
            <ui:Button name="ContinueBtn" text="Continue" class="welcome-btn" />

            <!-- Save / Load on the same row -->
            <ui:VisualElement class="welcome-btn-row">
                <ui:Button name="SaveBtn" text="Save" class="welcome-btn welcome-btn--half" />
                <ui:Button name="LoadBtn" text="Load" class="welcome-btn welcome-btn--half" />
            </ui:VisualElement>

            <ui:Button name="SettingsBtn" text="Settings" class="welcome-btn" />
            <ui:Button name="ExitBtn" text="Exit" class="welcome-btn welcome-btn--exit" />

            <!-- Save status label -->
            <ui:Label name="WelcomeStatus" text="" class="welcome-status" />

        </ui:VisualElement>

    </ui:VisualElement>

    <!-- Loading modal (OUTSIDE WelcomeMenuRoot so Hide() doesn't hide it) -->
    <ui:VisualElement name="LoadingModal" class="loading-modal loading--hidden">
        <ui:VisualElement class="loading-modal-card">
            <ui:VisualElement class="hs-accent-edge" picking-mode="Ignore" />
            <ui:Label text="LOADING" class="loading-modal-title" />
            <ui:Label name="LoadingPhase" text="" class="loading-phase" />
            <ui:VisualElement class="loading-bar-track">
                <ui:VisualElement name="LoadingBarFill" class="loading-bar-fill" />
            </ui:VisualElement>
            <ui:Label name="LoadingPct" text="0%" class="loading-pct" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Settings dialog (modal overlay, hidden by default) -->
    <ui:VisualElement name="SettingsDialog" class="settings-dialog settings--hidden">
        <ui:VisualElement class="settings-card settings-card--wide">
            <ui:VisualElement class="hs-accent-edge" picking-mode="Ignore" />
            <ui:Label text="SETTINGS" class="settings-title" />

            <ui:VisualElement class="settings-body">
                <!-- Category navigation (SettingsDialogController switches the pages) -->
                <ui:VisualElement name="SettingsNav" class="settings-nav">
                    <ui:Button name="SettingsNavGeneral" text="General" class="settings-nav-btn settings-nav-btn--active" />
                    <ui:Button name="SettingsNavGraphics" text="Graphics" class="settings-nav-btn" />
                    <ui:Button name="SettingsNavAudio" text="Audio" class="settings-nav-btn" />
                    <ui:Button name="SettingsNavControls" text="Controls" class="settings-nav-btn" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-pages">

                    <!-- GENERAL -->
                    <ui:ScrollView name="SettingsPageGeneral" mode="Vertical" horizontal-scroller-visibility="Hidden" class="settings-page">
                        <ui:Label text="Camera" class="settings-section-title settings-section-title--first" />
                        <ui:SliderInt name="ZoomMaxLevel" label="Zoom Max Level" low-value="3" high-value="50" value="15" class="hs-slider" tooltip="How far the camera can zoom out (3 to 50)." />

                        <ui:Label text="Defaults" class="settings-section-title" />
                        <ui:Label text="Puts colour, audio, controls and zoom back to how the game shipped. Display options (quality, fullscreen, v-sync) are left as they are." class="settings-hint" />
                        <ui:Button name="SettingsResetAllBtn" text="Reset All Settings" class="welcome-btn settings-action-btn" />
                    </ui:ScrollView>

                    <!-- GRAPHICS -->
                    <ui:ScrollView name="SettingsPageGraphics" mode="Vertical" horizontal-scroller-visibility="Hidden" class="settings-page settings-page--hidden">
                        <ui:Label text="Quality" class="settings-section-title settings-section-title--first" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Preset" class="settings-label" tooltip="Auto picks the best preset for this computer." />
                            <ui:DropdownField name="GfxPresetDropdown" class="hs-dropdown settings-dropdown" />
                        </ui:VisualElement>
                        <ui:Label name="GfxPresetDetected" text="" class="settings-hint" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Water Reflections" class="settings-label" tooltip="The sky reflected in water. Costs very little." />
                            <ui:Toggle name="GfxWaterReflectionsToggle" class="hs-toggle" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Shadows" class="settings-label" tooltip="The sun's shadows. Off is the biggest fps gain." />
                            <ui:Toggle name="GfxShadowsToggle" class="hs-toggle" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Light Occlusion" class="settings-label" tooltip="Walls stop the light of lamps, the fire, the lantern and the flashlight. Off lets light shine through walls." />
                            <ui:Toggle name="GfxLightOcclusionToggle" class="hs-toggle" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Cloud Shadows" class="settings-label" tooltip="Soft shadows of drifting clouds across the land." />
                            <ui:Toggle name="GfxCloudShadowsToggle" class="hs-toggle" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Wind Animation" class="settings-label" tooltip="Trees, bushes and grass sway in the wind." />
                            <ui:Toggle name="GfxWindAnimationToggle" class="hs-toggle" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Seasonal Lighting" class="settings-label" tooltip="The sun and moon change colour and strength with the seasons." />
                            <ui:Toggle name="GfxSeasonalLightingToggle" class="hs-toggle" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Colorized Mouse Cursors" class="settings-label" tooltip="Amber, shaded mouse cursors. Off gives plain black-and-white cursors." />
                            <ui:Toggle name="GfxColorizedCursorsToggle" class="hs-toggle" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Anti-Aliasing" class="settings-label" tooltip="Smooths jagged edges. FXAA/SMAA are cheap, MSAA costs more." />
                            <ui:DropdownField name="GfxAntiAliasingDropdown" class="hs-dropdown settings-dropdown" />
                        </ui:VisualElement>

                        <ui:Label text="Display" class="settings-section-title" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Display Mode" class="settings-label" tooltip="Fullscreen, Borderless Windowed or Windowed." />
                            <ui:DropdownField name="GfxDisplayModeDropdown" class="hs-dropdown settings-dropdown" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Resolution" class="settings-label" tooltip="The size of the game window or screen." />
                            <ui:DropdownField name="GfxResolutionDropdown" class="hs-dropdown settings-dropdown" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="V-Sync" class="settings-label" tooltip="Match the monitor's refresh rate." />
                            <ui:Toggle name="VsyncToggle" class="hs-toggle" />
                        </ui:VisualElement>

                        <ui:Label text="Interface" class="settings-section-title" />
                        <ui:Slider name="GfxHudScaleSlider" label="HUD Scale" low-value="50" high-value="300" value="100" show-input-field="false" class="hs-slider" />
                        <ui:Button name="GfxHudScaleResetBtn" text="Reset HUD Scale" class="welcome-btn settings-action-btn" />

                        <ui:Label text="Colour" class="settings-section-title" />
                        <ui:Slider name="GfxSaturationSlider" label="Saturation" low-value="-100" high-value="100" value="35" class="hs-slider" />
                        <ui:Slider name="GfxContrastSlider" label="Contrast" low-value="-100" high-value="100" value="10" class="hs-slider" />
                        <ui:Slider name="GfxBrightnessSlider" label="Brightness" low-value="-2" high-value="2" value="0.2" class="hs-slider" />
                        <ui:Button name="GfxResetBtn" text="Reset Colour" class="welcome-btn settings-action-btn" />
                    </ui:ScrollView>

                    <!-- AUDIO -->
                    <ui:ScrollView name="SettingsPageAudio" mode="Vertical" horizontal-scroller-visibility="Hidden" class="settings-page settings-page--hidden">
                        <ui:Label text="Volume" class="settings-section-title settings-section-title--first" />
                        <ui:Slider name="AudioMasterSlider" label="Master Volume" low-value="0" high-value="100" value="80" class="hs-slider" />
                        <ui:Slider name="AudioMusicSlider" label="Music &amp; Ambience" low-value="0" high-value="100" value="65" class="hs-slider" />
                        <ui:Slider name="AudioSfxSlider" label="Sound Effects" low-value="0" high-value="100" value="80" class="hs-slider" />
                        <ui:Label text="Wind and rain follow the weather and use the Sound Effects level." class="settings-hint" />

                        <ui:Label text="Radio" class="settings-section-title" />
                        <ui:Label text="Steadify's radio stations are written from the day's almanac and your farm, then read aloud by a voice that runs on this computer (no internet needed). Radio plays at the Music level." class="settings-hint" />
                        <ui:DropdownField name="RadioScriptMode" label="Script Writer" class="settings-dropdown" tooltip="Almanac: free, offline, built from the station's sentence banks. Claude: a fresh script written live from the day's facts; needs an API key and costs a few cents per episode." />
                        <ui:TextField name="RadioApiKey" label="Claude API Key" password="true" class="settings-field settings-radio-key" tooltip="Stored on this computer only. Leave empty to use the ANTHROPIC_API_KEY environment variable." />
                        <ui:TextField name="RadioModel" label="Claude Model" class="settings-field" tooltip="The model id used for Claude-written episodes." />
                        <ui:Label name="RadioVoiceStatus" text="" class="settings-hint" />

                        <ui:Label text="Music Credits" class="settings-section-title" />
                        <ui:Label text="&quot;Apple Cider&quot; by Zane Little Music and &quot;Fields of Cabbage&quot; by ARoachIFoundOnMyPillow (both CC0, via OpenGameArt.org)." class="settings-hint" />
                        <ui:Label text="&quot;Casual game track&quot; by Alexandr Zhelanov (soundcloud.com/alexandr-zhelanov), licensed under CC-BY 3.0." class="settings-hint" />
                      </ui:ScrollView>

                    <!-- CONTROLS (rows are built in code from KeyBindings) -->
                    <ui:ScrollView name="SettingsPageControls" mode="Vertical" horizontal-scroller-visibility="Hidden" class="settings-page settings-page--hidden">
                        <ui:Label name="ControlsHint" text="Click a key, then press the new one. Esc cancels." class="settings-hint" />
                        <ui:VisualElement name="ControlsList" />
                        <ui:Button name="ControlsResetBtn" text="Reset Controls" class="welcome-btn settings-action-btn" />
                    </ui:ScrollView>

                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="settings-footer">
                <ui:Button name="SettingsCloseBtn" text="Close" class="welcome-btn welcome-btn--primary settings-footer-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
