<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">
    <ui:Style src="HudUI.uss" />
    <ui:VisualElement name="WindowShade" class="window-shade">
        <!-- Settings Window Example -->
        <ui:VisualElement name="SettingsWindow" class="window" style="width: 460px; margin-bottom: 24px;">
            <ui:VisualElement class="window-header">
                <ui:Label text="Settings" class="window-title" />
                <ui:Button name="SettingsCloseBtn" text="✕" class="window-close-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="window-body">
                <ui:Label text="Audio" class="window-section-title" />
                <ui:Slider name="MasterVolumeSlider" label="Master Volume" low-value="0" high-value="100" value="80" class="window-slider" />
                <ui:Slider name="MusicVolumeSlider" label="Music &amp; Ambience" low-value="0" high-value="100" value="65" class="window-slider" />

                <ui:Label text="Display" class="window-section-title" />
                <ui:Toggle name="FullscreenToggle" label="Fullscreen Mode" value="true" class="window-toggle" />
                <ui:Toggle name="VsyncToggle" label="V-Sync (60 FPS)" value="true" class="window-toggle" />

                <ui:VisualElement class="window-footer-row">
                    <ui:Button name="SettingsResetBtn" text="Reset" class="action-btn action-btn--secondary" />
                    <ui:Button name="SettingsApplyBtn" text="Apply &amp; Close" class="action-btn action-btn--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Confirm Modal Example -->
        <ui:VisualElement name="ConfirmModal" class="modal" style="width: 440px;">
            <ui:VisualElement class="window-header">
                <ui:Label name="ModalTitle" text="Confirm Action" class="window-title" />
                <ui:Button name="ModalCloseBtn" text="✕" class="window-close-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="modal-body">
                <ui:Label name="ModalMessage" text="Are you sure you want to discard unsaved homestead changes?" class="modal-text" />
                <ui:VisualElement class="modal-button-row">
                    <ui:Button name="ModalCancelBtn" text="Cancel" class="action-btn action-btn--secondary" />
                    <ui:Button name="ModalThirdBtn" text="" class="action-btn action-btn--secondary" style="display: none;" />
                    <ui:Button name="ModalConfirmBtn" text="Confirm" class="action-btn action-btn--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
