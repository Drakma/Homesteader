{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "red_chicken",
  "name": "Red Chicken",
  "category": "ranching",
  "description": "A animal lifecycle growing through 2 stages (baby -> adult) over 730 days. This group is the authoritative owner of the red_chicken scheme.",
  "icon": "red_chicken.png",
  "is_growable": true,
  "growth": {
    "growth_type": "animal",
    "species": "red_chicken",
    "max_age": 730,
    "time_unit": "days",
    "total_stages": 3,
    "icon_stage": 3,
    "stages": [
      {
        "stage": 1,
        "name": "baby",
        "age_min": 0,
        "age_max": 90,
        "resource": "stages/animal_baby/",
        "model": "red_chicken_baby.glb",
        "icon": "animal_baby_red_chicken.png"
      },
      {
        "stage": 2,
        "name": "yearling",
        "age_min": 90,
        "age_max": 365,
        "resource": "stages/animal_yearling/",
        "model": "red_chicken_yearling.glb",
        "icon": "animal_yearling_red_chicken.png"
      },
      {
        "stage": 3,
        "name": "adult",
        "age_min": 365,
        "age_max": 730,
        "resource": "stages/animal_adult/",
        "model": "red_chicken_adult_female.glb",
        "icon": "animal_adult_red_chicken.png",
        "sexes": [
          {
            "sex": "female",
            "chance_pct": 80,
            "model": "red_chicken_adult_female.glb",
            "icon": "animal_adult_red_chicken.png"
          },
          {
            "sex": "male",
            "chance_pct": 20,
            "model": "red_chicken_adult_male.glb",
            "icon": "animal_adult_red_chicken_male.png"
          }
        ]
      }
    ]
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}