{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "black_white_goat",
  "name": "Black White Goat",
  "category": "ranching",
  "description": "A animal lifecycle growing through 2 stages (kid -> adult) over 730 days. This group is the authoritative owner of the black_white_goat scheme.",
  "icon": "black_white_goat.png",
  "is_growable": true,
  "growth": {
    "growth_type": "animal",
    "species": "black_white_goat",
    "max_age": 730,
    "time_unit": "days",
    "total_stages": 2,
    "icon_stage": 2,
    "stages": [
      {
        "stage": 1,
        "name": "kid",
        "age_min": 0,
        "age_max": 90,
        "resource": "stages/animal_kid/",
        "model": "SKM_Animal_Goat_Blackwhite_Kid.fbx",
        "icon": "animal_kid_black_white_goat.png"
      },
      {
        "stage": 2,
        "name": "adult",
        "age_min": 90,
        "age_max": 730,
        "resource": "stages/animal_adult/",
        "model": "SKM_Animal_Goat_BlackWhite.fbx",
        "icon": "animal_adult_black_white_goat.png"
      }
    ]
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
