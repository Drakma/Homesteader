{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "hampshire_pig",
  "name": "Hampshire Pig",
  "category": "ranching",
  "description": "A animal lifecycle growing through 2 stages (piglet -> adult) over 730 days. This group is the authoritative owner of the hampshire_pig scheme.",
  "icon": "hampshire_pig.png",
  "is_growable": true,
  "growth": {
    "growth_type": "animal",
    "species": "hampshire_pig",
    "max_age": 730,
    "time_unit": "days",
    "total_stages": 3,
    "icon_stage": 3,
    "stages": [
      {
        "stage": 1,
        "name": "piglet",
        "age_min": 0,
        "age_max": 90,
        "resource": "stages/animal_piglet/",
        "model": "hampshire_pig_piglet.glb",
        "icon": "animal_piglet_hampshire_pig.png"
      },
      {
        "stage": 2,
        "name": "yearling",
        "age_min": 90,
        "age_max": 365,
        "resource": "stages/animal_yearling/",
        "model": "hampshire_pig_yearling.glb",
        "icon": "animal_yearling_hampshire_pig.png"
      },
      {
        "stage": 3,
        "name": "adult",
        "age_min": 365,
        "age_max": 730,
        "resource": "stages/animal_adult/",
        "model": "hampshire_pig_adult_female.glb",
        "icon": "animal_adult_hampshire_pig.png",
        "sexes": [
          {
            "sex": "female",
            "chance_pct": 80,
            "model": "hampshire_pig_adult_female.glb",
            "icon": "animal_adult_hampshire_pig.png"
          },
          {
            "sex": "male",
            "chance_pct": 20,
            "model": "hampshire_pig_adult_male.glb",
            "icon": "animal_adult_hampshire_pig_male.png"
          }
        ]
      }
    ]
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}