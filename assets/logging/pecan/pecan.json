{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "pecan",
  "name": "Pecan",
  "category": "logging",
  "description": "A tree lifecycle growing through 5 stages (sapling -> small -> medium -> mature -> fruiting) over 160 days. No fruit is visible until the final fruiting stage. This group is the authoritative owner of the pecan scheme.",
  "icon": "pecan.png",
  "is_growable": true,
  "growth": {
    "growth_type": "tree",
    "species": "pecan",
    "max_age": 160,
    "time_unit": "days",
    "total_stages": 5,
    "icon_stage": 5,
    "stages": [
      {
        "stage": 1,
        "name": "sapling",
        "age_min": 0.0,
        "age_max": 23.7
      },
      {
        "stage": 2,
        "name": "small",
        "age_min": 23.7,
        "age_max": 63.2
      },
      {
        "stage": 3,
        "name": "medium",
        "age_min": 63.2,
        "age_max": 118.5
      },
      {
        "stage": 4,
        "name": "mature",
        "age_min": 118.5,
        "age_max": 158.0
      },
      {
        "stage": 5,
        "name": "fruiting",
        "age_min": 158.0,
        "age_max": 160
      }
    ],
    "rules": {
      "yield": {
        "item_id": "mat_log_oak_uncut_long",
        "amount_min": 1,
        "amount_max": 1,
        "tools": [
          "#tool_axe",
          "#tool_chainsaw"
        ],
        "harvest_stage": 4,
        "extras": [
          {
            "item_id": "food_pecan",
            "amount_min": 5,
            "amount_max": 10
          }
        ]
      },
      "fruit": {
        "is_fruiting": true,
        "drops": [
          {
            "item_id": "food_pecan",
            "amount_min": 1,
            "amount_max": 1
          }
        ],
        "tools": [
          "#tool_basket"
        ],
        "fruit_stage": 5,
        "regrow_days": 30
      },
      "planting": {
        "item_id": "plantable_sapling_pecan"
      }
    }
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
