{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "lemon",
  "name": "Lemon",
  "category": "logging",
  "description": "A tree lifecycle growing through 5 stages (sapling -> small -> medium -> mature -> fruiting) over 300 days. No fruit is visible until the final fruiting stage. This group is the authoritative owner of the lemon scheme.",
  "icon": "lemon.png",
  "is_growable": true,
  "growth": {
    "growth_type": "tree",
    "species": "lemon",
    "max_age": 300,
    "time_unit": "days",
    "total_stages": 5,
    "icon_stage": 5,
    "stages": [
      {
        "stage": 1,
        "name": "sapling",
        "age_min": 0,
        "age_max": 125,
        "resource": "stages/tree_sapling/",
        "model": "tree_sapling_lemon.glb",
        "icon": "tree_sapling_lemon.png"
      },
      {
        "stage": 2,
        "name": "small",
        "age_min": 125,
        "age_max": 200,
        "resource": "stages/tree_small/",
        "model": "tree_small_lemon.glb",
        "icon": "tree_small_lemon.png"
      },
      {
        "stage": 3,
        "name": "medium",
        "age_min": 200,
        "age_max": 250,
        "resource": "stages/tree_medium/",
        "model": "tree_medium_lemon.glb",
        "icon": "tree_medium_lemon.png"
      },
      {
        "stage": 4,
        "name": "mature",
        "age_min": 250,
        "age_max": 299,
        "resource": "stages/tree_mature/",
        "model": "tree_mature_lemon.glb",
        "icon": "tree_mature_lemon.png"
      },
      {
        "stage": 5,
        "name": "fruiting",
        "age_min": 299,
        "age_max": 300,
        "resource": "stages/tree_fruiting/",
        "model": "tree_fruiting_lemon.glb",
        "icon": "tree_fruiting_lemon.png"
      }
    ],
    "rules": {
      "yield": {
        "item_id": "mat_log_oak_uncut_long",
        "amount_min": 1,
        "amount_max": 1,
        "tools": [
          "#tool_axe",
          "#tool_chainsaw"
        ],
        "stump": {
          "resource": "../stump_oak_large/",
          "model": "SM_Stump_Oak_Large.glb",
          "icon": "stump_oak_large.png"
        },
        "extras": [
          {
            "item_id": "food_lemon",
            "amount_min": 5,
            "amount_max": 10
          }
        ],
        "harvest_stage": 4
      },
      "fruit": {
        "is_fruiting": true,
        "drops": [
          {
            "item_id": "food_lemon",
            "amount_min": 1,
            "amount_max": 1
          }
        ],
        "tools": [
          "#tool_basket"
        ],
        "fruit_stage": 5,
        "regrow_days": 30
      },
      "planting": {
        "seasons": [
          "spring",
          "summer"
        ],
        "biomes": [
          "biome_maintained_grass",
          "biome_mixed_forest",
          "biome_grass_plains",
          "biome_meadow"
        ],
        "item_id": "plantable_sapling_lemon"
      },
      "failure": {
        "dead": {
          "resource": "stages/tree_dead/",
          "model": "tree_dead_lemon.glb",
          "icon": "tree_dead_lemon.png"
        }
      }
    }
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
