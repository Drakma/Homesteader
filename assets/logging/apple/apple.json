{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "apple",
  "name": "Apple Tree",
  "category": "logging",
  "description": "A tree lifecycle growing through 4 stages (sapling -> small -> medium -> mature) over 80 days. This group is the authoritative owner of the apple scheme.",
  "icon": "apple.png",
  "is_growable": true,
  "growth": {
    "growth_type": "tree",
    "species": "apple",
    "max_age": 80,
    "time_unit": "days",
    "total_stages": 4,
    "icon_stage": 4,
    "stages": [
      {
        "stage": 1,
        "name": "sapling",
        "age_min": 0,
        "age_max": 12,
        "resource": "stages/tree_sapling/",
        "model": "tree_sapling_apple.fbx",
        "icon": "tree_sapling_apple.png"
      },
      {
        "stage": 2,
        "name": "small",
        "age_min": 12,
        "age_max": 32,
        "resource": "stages/tree_small/",
        "model": "tree_small_apple.fbx",
        "icon": "tree_small_apple.png"
      },
      {
        "stage": 3,
        "name": "medium",
        "age_min": 32,
        "age_max": 60,
        "resource": "stages/tree_medium/",
        "model": "tree_medium_apple.fbx",
        "icon": "tree_medium_apple.png"
      },
      {
        "stage": 4,
        "name": "mature",
        "age_min": 60,
        "age_max": 80,
        "resource": "stages/tree_mature/",
        "model": "tree_mature_apple.fbx",
        "icon": "tree_mature_apple.png"
      }
    ],
    "rules": {}
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
