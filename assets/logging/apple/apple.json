{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "apple",
  "name": "Apple Tree",
  "category": "logging",
  "description": "A tree lifecycle growing through 5 stages (sapling -> small -> medium -> mature -> fruiting) over 81 days. No fruit is visible until the final fruiting stage. This group is the authoritative owner of the apple scheme.",
  "icon": "apple.png",
  "is_growable": true,
  "growth": {
    "growth_type": "tree",
    "species": "apple",
    "max_age": 81,
    "time_unit": "days",
    "total_stages": 5,
    "icon_stage": 5,
    "stages": [
      {
        "stage": 1,
        "name": "sapling",
        "age_min": 0,
        "age_max": 12,
        "resource": "stages/tree_sapling/",
        "model": "tree_sapling_apple.glb",
        "icon": "tree_sapling_apple.png"
      },
      {
        "stage": 2,
        "name": "small",
        "age_min": 12,
        "age_max": 32,
        "resource": "stages/tree_small/",
        "model": "tree_small_apple.glb",
        "icon": "tree_small_apple.png"
      },
      {
        "stage": 3,
        "name": "medium",
        "age_min": 32,
        "age_max": 60,
        "resource": "stages/tree_medium/",
        "model": "tree_medium_apple.glb",
        "icon": "tree_medium_apple.png"
      },
      {
        "stage": 4,
        "name": "mature",
        "age_min": 60,
        "age_max": 80,
        "resource": "stages/tree_mature/",
        "model": "tree_mature_apple.glb",
        "icon": "tree_mature_apple.png"
      },
      {
        "stage": 5,
        "name": "fruiting",
        "age_min": 80,
        "age_max": 81,
        "resource": "stages/tree_fruiting/",
        "model": "tree_fruiting_apple.glb",
        "icon": "tree_fruiting_apple.png"
      }
    ],
    "rules": {
      "yield": {
        "item_id": "mat_log_oak_uncut_long",
        "amount_min": 1,
        "amount_max": 1,
        "tools": [
          "#tool_axe",
          "#tool_chainsaw"
        ],
        "harvest_stage": 4
      },
      "fruit": {
        "is_fruiting": true,
        "drops": [
          {
            "item_id": "food_apple",
            "amount_min": 1,
            "amount_max": 1
          }
        ],
        "tools": [
          "#tool_basket"
        ],
        "fruit_stage": 5,
        "regrow_days": 30
      },
      "planting": {
        "item_id": "plantable_sapling_apple"
      },
      "failure": {
        "dead": {
          "resource": "stages/tree_dead/",
          "model": "tree_dead_apple.glb",
          "icon": "tree_dead_apple.png"
        }
      }
    }
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
