{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "grape",
  "name": "Grape",
  "category": "logging",
  "description": "A tree lifecycle growing through 5 stages (sapling -> small -> medium -> mature -> fruiting) over 60 days. No fruit is visible until the final fruiting stage. This group is the authoritative owner of the grape scheme.",
  "icon": "grape.png",
  "is_growable": true,
  "growth": {
    "growth_type": "tree",
    "species": "grape",
    "max_age": 60,
    "time_unit": "days",
    "total_stages": 5,
    "icon_stage": 5,
    "stages": [
      {
        "stage": 1,
        "name": "sapling",
        "age_min": 0,
        "age_max": 8.9
      },
      {
        "stage": 2,
        "name": "small",
        "age_min": 8.9,
        "age_max": 23.7
      },
      {
        "stage": 3,
        "name": "medium",
        "age_min": 23.7,
        "age_max": 44.4
      },
      {
        "stage": 4,
        "name": "mature",
        "age_min": 44.4,
        "age_max": 59.3
      },
      {
        "stage": 5,
        "name": "fruiting",
        "age_min": 59.3,
        "age_max": 60
      }
    ],
    "rules": {
      "yield": {
        "item_id": "lumber_stud_2x4",
        "amount_min": 1,
        "amount_max": 1,
        "tools": [
          "#tool_axe",
          "#tool_chainsaw"
        ],
        "extras": [
          {
            "item_id": "food_grapes",
            "amount_min": 5,
            "amount_max": 10
          }
        ],
        "harvest_stage": 4
      },
      "fruit": {
        "is_fruiting": true,
        "drops": [
          {
            "item_id": "food_grapes",
            "amount_min": 1,
            "amount_max": 1
          }
        ],
        "tools": [
          "#tool_basket"
        ],
        "fruit_stage": 5,
        "regrow_days": 30
      },
      "planting": {
        "item_id": "plantable_sapling_grape"
      }
    }
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
