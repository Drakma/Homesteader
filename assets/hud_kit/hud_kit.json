{
  "id": "hud_kit",
  "name": "Homesteader HUD Kit",
  "version": "1.0.0",
  "category": "ui_kit",
  "description": "Reusable HUD chrome sprites for windows, buttons, toolbar slots, status dividers, and decorative accents. All sprites 128x128 RGBA with perimeter alpha=0, generated from palette.json by _build_sprites.py. Runtime layout described in HUD_LAYOUT.md.",
  "palette_ref": "palette.json",
  "runtime_ref": "HUD_LAYOUT.md",
  "runtime_module_ref": "runtime/",
  "style_guide_ref": "STYLE_GUIDE.md",
  "generator_ref": "_build_sprites.py",
  "validator_ref": "_validate_palette.py",
  "composer_ref": "compose_preview.py",
  "entries": [
    {
      "id": "panel_compact_dialog",
      "path": "sprites/panels/panel_compact_dialog.png",
