{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "corn",
  "name": "Corn Plant",
  "category": "farming",
  "description": "A plant lifecycle growing through 3 stages (sprout -> growing -> mature) over 80 days. This group is the authoritative owner of the corn scheme.",
  "icon": "corn.png",
  "is_growable": true,
  "growth": {
    "growth_type": "crop",
    "species": "corn",
    "max_age": 80,
    "time_unit": "days",
    "total_stages": 3,
    "icon_stage": 3,
    "stages": [
      {
        "stage": 1,
        "name": "sprout",
        "age_min": 0,
        "age_max": 33,
        "resource": "stages/crop_sprout/",
        "model": "crop_sprout_corn.fbx",
        "icon": "crop_sprout_corn.png"
      },
      {
        "stage": 2,
        "name": "growing",
        "age_min": 33,
        "age_max": 66,
        "resource": "stages/crop_growing/",
        "model": "crop_growing_corn.fbx",
        "icon": "crop_growing_corn.png"
      },
      {
        "stage": 3,
        "name": "mature",
        "age_min": 66,
        "age_max": 80,
        "resource": "stages/crop_mature/",
        "model": "crop_mature_corn.fbx",
        "icon": "crop_mature_corn.png"
      }
    ],
    "rules": {
      "boosts": {
        "irrigated_growth_bonus_pct": 20,
        "fertilized_growth_bonus_pct": 15
      },
      "yield": {
        "item_id": "ingredient_corn",
        "amount": 3,
        "harvest_stage": 3
      },
      "planting": {
        "seasons": [
          "summer"
        ]
      }
    }
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
