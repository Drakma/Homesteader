{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "lettuce",
  "name": "Lettuce Plant",
  "category": "farming",
  "description": "A lettuce lifecycle growing through 5 stages (sprout -> small -> medium -> mature -> ripe) over 45 days, with withered and dead versions. The models are procedural (built in the game), the originals are kept in assets/_originals/crops_old.",
  "icon": "lettuce.png",
  "is_growable": true,
  "growth": {
    "growth_type": "crop",
    "species": "lettuce",
    "max_age": 45,
    "time_unit": "days",
    "total_stages": 5,
    "icon_stage": 5,
    "stages": [
      {
        "stage": 1,
        "name": "sprout",
        "age_min": 0,
        "age_max": 5,
        "resource": "stages/crop_sprout/",
        "model": "crop_sprout_lettuce.glb",
        "icon": "crop_sprout_lettuce.png"
      },
      {
        "stage": 2,
        "name": "small",
        "age_min": 5,
        "age_max": 15,
        "resource": "stages/crop_small/",
        "model": "crop_small_lettuce.glb",
        "icon": "crop_small_lettuce.png"
      },
      {
        "stage": 3,
        "name": "medium",
        "age_min": 15,
        "age_max": 27,
        "resource": "stages/crop_medium/",
        "model": "crop_medium_lettuce.glb",
        "icon": "crop_medium_lettuce.png"
      },
      {
        "stage": 4,
        "name": "mature",
        "age_min": 27,
        "age_max": 37,
        "resource": "stages/crop_mature/",
        "model": "crop_mature_lettuce.glb",
        "icon": "crop_mature_lettuce.png"
      },
      {
        "stage": 5,
        "name": "ripe",
        "age_min": 37,
        "age_max": 45,
        "resource": "stages/crop_ripe/",
        "model": "crop_ripe_lettuce.glb",
        "icon": "crop_ripe_lettuce.png"
      }
    ],
    "rules": {
      "yield": {
        "item_id": "food_lettuce",
        "amount_min": 1,
        "amount_max": 2,
        "harvest_stage": 5
      },
      "planting": {
        "seasons": [
          "spring",
          "fall"
        ],
        "biomes": [
          "biome_farmland"
        ],
        "item_id": "seed_lettuce",
        "min_temp_c": 8,
        "max_temp_c": 40
      },
      "needs": {
        "water_interval_days": 2
      },
      "failure": {
        "out_of_season": "wither",
        "frost_kills": true,
        "drought_days_before_wither": 7,
        "wither_behavior": "die",
        "withered": {
          "resource": "stages/crop_withered/",
          "model": "crop_withered_lettuce.glb",
          "icon": "crop_withered_lettuce.png"
        },
        "dead": {
          "resource": "stages/crop_dead/",
          "model": "crop_dead_lettuce.glb",
          "icon": "crop_dead_lettuce.png"
        }
      }
    }
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
