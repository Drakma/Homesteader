{
  "$schema": "https://homesteader.game/schemas/growth_group_v1.json",
  "id": "stable",
  "name": "Stable",
  "category": "structures",
  "description": "A building lifecycle growing through 4 stages (foundation -> framing -> walls -> complete) over 100 percent. This group is the authoritative owner of the stable scheme.",
  "icon": "stable.png",
  "is_growable": true,
  "growth": {
    "growth_type": "building",
    "species": "stable",
    "max_age": 100,
    "time_unit": "percent",
    "total_stages": 4,
    "icon_stage": 4,
    "stages": [
      {
        "stage": 1,
        "name": "foundation",
        "age_min": 0,
        "age_max": 33,
        "resource": "stages/struct_foundation/",
        "model": "",
        "icon": "struct_foundation_stable.png"
      },
      {
        "stage": 2,
        "name": "framing",
        "age_min": 33,
        "age_max": 66,
        "resource": "stages/struct_framing/",
        "model": "",
        "icon": "struct_framing_stable.png"
      },
      {
        "stage": 3,
        "name": "walls",
        "age_min": 66,
        "age_max": 99,
        "resource": "stages/struct_walls/",
        "model": "",
        "icon": "struct_walls_stable.png"
      },
      {
        "stage": 4,
        "name": "complete",
        "age_min": 99,
        "age_max": 100,
        "resource": "stages/struct_complete/",
        "model": "SM_Struct_Stable.fbx",
        "icon": "struct_complete_stable.png"
      }
    ]
  },
  "plugin_metadata": {
    "version": "1.0.0",
    "author": "Homesteader Core",
    "compatible_api": "v1"
  }
}
