<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">
    <ui:Style src="HudUI.uss" />
    <ui:VisualElement name="ScreenRoot" class="screen-root">
        <!-- Top status bar -->
        <ui:VisualElement name="StatusBar" class="status-bar">
            <ui:VisualElement class="status-strip">
                <ui:VisualElement class="status-section"
                                  style="flex-grow: 0; width: 60%;">
                    <ui:VisualElement class="well"
                                      style="flex-grow: 0; width: 520px; height: 22px;">
                        <ui:VisualElement class="icon-tile" />
                        <ui:VisualElement class="icon-tile" />
                        <ui:VisualElement class="icon-tile" />
                        <ui:VisualElement class="icon-tile" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Time" class="status-section"
                                  style="flex-grow: 0; width: 30%;">
                    <ui:VisualElement class="status-row">
                        <ui:Label text="Summer, Day 42 5:00 AM"
                                  class="time-label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="status-row"
                                      style="justify-content: center;">
                        <ui:VisualElement class="speed-chip" />
                        <ui:VisualElement class="speed-chip" />
                        <ui:VisualElement class="speed-chip" />
                        <ui:VisualElement class="speed-chip" />
                        <ui:VisualElement class="speed-chip" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Resources" class="status-section"
                                  style="flex-grow: 1; flex-direction: row;">
                    <ui:VisualElement class="well"
                                      style="flex-grow: 0; width: 460px; height: 22px;">
                        <ui:VisualElement class="icon-tile" />
                        <ui:Label text="120.5 L" class="label-tile" />
                        <ui:VisualElement class="icon-tile" />
                        <ui:Label text="2.40k Wh" class="label-tile" />
                        <ui:VisualElement class="icon-tile" />
                        <ui:Label text="24M Mbps" class="label-tile" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
